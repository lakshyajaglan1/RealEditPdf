---
import FaqSection from './FaqSection.astro';
// SEO Content Guide Component
// Renders localized content using the t() function from the parent.
// All hardcoded English text is now keys resolved via i18n/ui.ts.
// JSON-LD structured data is intentionally kept in English (per-page); it
// describes the same WebApplication across locales, and most search engines
// only consume one set of JSON-LD per site anyway.
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props as Props;
---

<section id="pdf-guide" class="py-16 sm:py-24 bg-canvas border-b border-hairline">
  <div class="mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-8 xl:px-12">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-3.5 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-link shadow-whisper">
        {t('seo.badge')}
      </span>
      <h2 class="mt-4 text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-ink">
        {t('seo.title')}
      </h2>
      <p class="mt-3 text-[15px] text-body leading-relaxed">
        {t('seo.subtitle')}
      </p>
    </div>

    <!-- Main Content Container -->
    <div class="space-y-10 text-body text-[15px] leading-relaxed">

      <!-- Intro Block -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 lg:p-10 border border-hairline bg-canvas-elevated/70 shadow-sm space-y-4">
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
          {t('seo.introTitle')}
        </h3>
        <p set:html={t('seo.introP1')}></p>
        <p set:html={t('seo.introP2')}></p>
        <p set:html={t('seo.introP3')}></p>
      </div>

      <!-- Step-by-Step Guide Section -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 lg:p-10 border border-hairline bg-canvas-elevated/70 shadow-sm space-y-6">
        <div class="border-b border-hairline pb-4">
          <span class="font-mono text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider">{t('seo.stepsBadge')}</span>
          <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink mt-1">
            {t('seo.stepsTitle')}
          </h3>
          <p class="text-mute text-sm mt-1" set:html={t('seo.stepsSub')}></p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Step 1 -->
          <div class="rounded-xl border border-hairline p-5 bg-canvas/60 space-y-2">
            <div class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white font-mono font-bold text-sm">1</span>
              <h4 class="font-bold text-ink text-base">{t('seo.step1Title')}</h4>
            </div>
            <p class="text-sm text-body">
              {t('seo.step1Body')}
            </p>
          </div>

          <!-- Step 2 -->
          <div class="rounded-xl border border-hairline p-5 bg-canvas/60 space-y-2">
            <div class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white font-mono font-bold text-sm">2</span>
              <h4 class="font-bold text-ink text-base">{t('seo.step2Title')}</h4>
            </div>
            <p class="text-sm text-body">
              {t('seo.step2Body')}
            </p>
          </div>

          <!-- Step 3 -->
          <div class="rounded-xl border border-hairline p-5 bg-canvas/60 space-y-2">
            <div class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white font-mono font-bold text-sm">3</span>
              <h4 class="font-bold text-ink text-base">{t('seo.step3Title')}</h4>
            </div>
            <p class="text-sm text-body">
              {t('seo.step3Body')}
            </p>
          </div>

          <!-- Step 4 -->
          <div class="rounded-xl border border-hairline p-5 bg-canvas/60 space-y-2">
            <div class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white font-mono font-bold text-sm">4</span>
              <h4 class="font-bold text-ink text-base">{t('seo.step4Title')}</h4>
            </div>
            <p class="text-sm text-body">
              {t('seo.step4Body')}
            </p>
          </div>
        </div>
      </div>

      <!-- Platform Specific Guides: iPhone & Mac (2 Column Grid) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">

        <!-- iPhone Guide -->
        <div class="glass-card rounded-2xl p-6 sm:p-8 border border-hairline bg-canvas-elevated/70 shadow-sm space-y-4">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-500/15 text-cyan-600 dark:text-cyan-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="font-mono text-xs font-bold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider">{t('seo.iosBadge')}</span>
              <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">
                {t('seo.iosTitle')}
              </h3>
            </div>
          </div>

          <p class="text-sm" set:html={t('seo.iosP1')}></p>

          <ol class="list-decimal list-inside space-y-2 text-sm text-body pl-1">
            <li>{t('seo.iosL1')}</li>
            <li>{t('seo.iosL2')}</li>
            <li>{t('seo.iosL3')}</li>
            <li>{t('seo.iosL4')}</li>
            <li>{t('seo.iosL5')}</li>
          </ol>

          <p class="text-sm text-mute pt-1" set:html={t('seo.iosP2')}></p>
        </div>

        <!-- Mac Guide -->
        <div class="glass-card rounded-2xl p-6 sm:p-8 border border-hairline bg-canvas-elevated/70 shadow-sm space-y-4">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500/15 text-indigo-600 dark:text-indigo-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">{t('seo.macBadge')}</span>
              <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">
                {t('seo.macTitle')}
              </h3>
            </div>
          </div>

          <p class="text-sm" set:html={t('seo.macP1')}></p>

          <ol class="list-decimal list-inside space-y-2 text-sm text-body pl-1">
            <li>{t('seo.macL1')}</li>
            <li>{t('seo.macL2')}</li>
            <li set:html={t('seo.macL3')}></li>
            <li>{t('seo.macL4')}</li>
            <li>{t('seo.macL5')}</li>
          </ol>

          <p class="text-sm text-mute pt-1" set:html={t('seo.macP2')}></p>
        </div>
      </div>

      <!-- Feature Deep Dive -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 lg:p-10 border border-hairline bg-canvas-elevated/70 shadow-sm space-y-6">
        <div>
          <span class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">{t('seo.featBadge')}</span>
          <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink mt-1">
            {t('seo.featTitle')}
          </h3>
          <p class="text-mute text-sm mt-1">
            {t('seo.featSub')}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-sm">
          <div class="border border-hairline rounded-xl p-4 bg-canvas/60 space-y-1.5">
            <h4 class="font-bold text-ink">{t('seo.feat1Title')}</h4>
            <p class="text-body">{t('seo.feat1Body')}</p>
          </div>
          <div class="border border-hairline rounded-xl p-4 bg-canvas/60 space-y-1.5">
            <h4 class="font-bold text-ink">{t('seo.feat2Title')}</h4>
            <p class="text-body">{t('seo.feat2Body')}</p>
          </div>
          <div class="border border-hairline rounded-xl p-4 bg-canvas/60 space-y-1.5">
            <h4 class="font-bold text-ink">{t('seo.feat3Title')}</h4>
            <p class="text-body">{t('seo.feat3Body')}</p>
          </div>
          <div class="border border-hairline rounded-xl p-4 bg-canvas/60 space-y-1.5">
            <h4 class="font-bold text-ink">{t('seo.feat4Title')}</h4>
            <p class="text-body">{t('seo.feat4Body')}</p>
          </div>
          <div class="border border-hairline rounded-xl p-4 bg-canvas/60 space-y-1.5">
            <h4 class="font-bold text-ink">{t('seo.feat5Title')}</h4>
            <p class="text-body">{t('seo.feat5Body')}</p>
          </div>
          <div class="border border-hairline rounded-xl p-4 bg-canvas/60 space-y-1.5">
            <h4 class="font-bold text-ink">{t('seo.feat6Title')}</h4>
            <p class="text-body">{t('seo.feat6Body')}</p>
          </div>
        </div>
      </div>

      <!-- Privacy & Architectural Advantage -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 lg:p-10 border border-hairline bg-canvas-elevated/70 shadow-sm space-y-4">
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
          {t('seo.privacyTitle')}
        </h3>
        <p set:html={t('seo.privacyP1')}></p>
        <p set:html={t('seo.privacyP2')}></p>
      </div>

      <!-- Comprehensive Interactive FAQ Section -->
      <FaqSection t={t} />

      <!-- Quick Back to Editor Anchor Action -->
      <div class="text-center pt-4">
        <a
          href="#editor-anchor"
          class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-6 py-2.5 text-xs sm:text-sm font-semibold text-ink shadow-whisper hover:border-link hover:text-link transition-colors"
        >
          <span>↑ {t('seo.backToEditor')}</span>
        </a>
      </div>

    </div>
  </div>
</section>

<!-- Structured Data Schemas (JSON-LD) for Search Engines -->
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://realeditpdf.com/#webapp",
      "name": "RealEditPDF - Edit PDF Online Free",
      "url": "https://realeditpdf.com/",
      "description": "Edit PDF online free with zero limits. Private, client-side in-browser PDF editor to modify text, add e-signatures, redact data, and organize pages on iPhone, Mac, and Windows.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All (Web Browser)",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Edit PDF online free",
        "Modify and whiteout document text",
        "Draw, type, and upload e-signatures",
        "Permanent vector redaction",
        "Reorder, rotate, and delete PDF pages",
        "Watermark stamping and automated page numbers",
        "100% private client-side processing without server uploads"
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://realeditpdf.com/#howto",
      "name": "How to Edit PDF Free Online",
      "description": "Step-by-step guide on how to edit PDF files for free directly in your web browser with zero server uploads.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Open Your PDF Document",
          "text": "Drag and drop your file into RealEditPDF or select it from your local storage."
        },
        {
          "@type": "HowToStep",
          "name": "Edit PDF Text and Annotate",
          "text": "Select the Text tool, click on the document, and add new text or mask existing text with the whiteout background feature."
        },
        {
          "@type": "HowToStep",
          "name": "Add Signatures and Redactions",
          "text": "Use the E-Sign studio to draw or type signatures, and apply permanent blackout redactions over confidential data."
        },
        {
          "@type": "HowToStep",
          "name": "Organize and Download",
          "text": "Reorder, rotate, or duplicate pages using the Page Organizer, then click Download PDF to save your file."
        }
      ]
    }
  ]
}
</script>
