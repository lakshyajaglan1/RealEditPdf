// Generate exact JSON-LD matching Schema.org FAQPage specification
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answerJsonLd
    }
  }))
};

const searchPlaceholderText = t('faq.searchPlaceholder');
const searchLabelText = t('faq.searchLabel');
const clearSearchText = t('faq.clearSearch');
---

<section id="faq" class="py-12 sm:py-20 scroll-mt-20">
  <div class="glass-card rounded-2xl p-6 sm:p-8 lg:p-10 border border-hairline bg-canvas-elevated/70 shadow-sm space-y-8">

    <!-- Section Header with Badges & Counter -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-hairline pb-6">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-3 py-1 text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider shadow-whisper">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{t('faq.badge')}</span>
          <span class="text-hairline">•</span>
          <span class="text-mute">{faqs.length} {t('faq.countSuffix')}</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
          {t('faq.title')}
        </h2>
        <p class="text-sm text-body leading-relaxed">
          {t('faq.subtitle')}
        </p>
      </div>

      <!-- Controls: Expand/Collapse All -->
      <div class="flex items-center gap-2 self-start md:self-end">
        <button
          type="button"
          id="faq-expand-all-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-hairline bg-canvas hover:bg-canvas-elevated text-xs font-medium text-ink transition-colors shadow-whisper cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
          <span>{t('faq.expandAll')}</span>
        </button>
        <button
          type="button"
          id="faq-collapse-all-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-hairline bg-canvas hover:bg-canvas-elevated text-xs font-medium text-mute hover:text-ink transition-colors shadow-whisper cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
          </svg>
          <span>{t('faq.collapseAll')}</span>
        </button>
      </div>
    </div>

    <!-- Interactive Search and Filter Bar -->
    <div class="space-y-3">
      <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
        <!-- Live Search Input -->
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-mute">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            id="faq-search-input"
            placeholder={searchPlaceholderText}
            class="w-full pl-10 pr-9 py-2.5 rounded-xl border border-hairline bg-canvas text-ink placeholder:text-mute text-sm focus:outline-none focus:ring-2 focus:ring-link/30 focus:border-link transition-all"
            aria-label={searchLabelText}
          />
          <button
            type="button"
            id="faq-search-clear"
            class="absolute inset-y-0 right-0 pr-3 flex items-center text-mute hover:text-ink hidden cursor-pointer"
            aria-label={clearSearchText}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Live FAQ Counter Indicator -->
        <div id="faq-match-count" class="text-xs font-mono text-mute px-1 self-center shrink-0">
          {t('faq.showing')} <span id="faq-count-num" class="font-bold text-ink">{faqs.length}</span> {t('faq.of')} {faqs.length} {t('faq.questions')}
        </div>
      </div>

      <!-- Quick Category Chips -->
      <div class="flex flex-wrap items-center gap-1.5 pt-1" id="faq-category-pills">
        <button
          type="button"
          data-category="all"
          class="faq-filter-chip active rounded-full px-3 py-1 text-xs font-medium border border-link bg-link text-white shadow-whisper transition-all cursor-pointer"
        >
          {t('faq.catAll')} ({faqs.length})
        </button>
        <button
          type="button"
          data-category="free"
          class="faq-filter-chip rounded-full px-3 py-1 text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-canvas-elevated transition-all cursor-pointer"
        >
          {t('faq.catFree')} ({faqs.filter(f => f.category === 'free').length})
        </button>
        <button
          type="button"
          data-category="devices"
          class="faq-filter-chip rounded-full px-3 py-1 text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-canvas-elevated transition-all cursor-pointer"
        >
          {t('faq.catDevices')} ({faqs.filter(f => f.category === 'devices').length})
        </button>
        <button
          type="button"
          data-category="howto"
          class="faq-filter-chip rounded-full px-3 py-1 text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-canvas-elevated transition-all cursor-pointer"
        >
          {t('faq.catHowto')} ({faqs.filter(f => f.category === 'howto').length})
        </button>
        <button
          type="button"
          data-category="basics"
          class="faq-filter-chip rounded-full px-3 py-1 text-xs font-medium border border-hairline bg-canvas text-body hover:text-ink hover:bg-canvas-elevated transition-all cursor-pointer"
        >
          {t('faq.catBasics')} ({faqs.filter(f => f.category === 'basics').length})
        </button>
      </div>
    </div>

    <!-- Accordion Items List -->
    <div id="faq-items-container" class="space-y-3">
      {faqs.map((faq, index) => (
        <details
          id={faq.id}
          data-category={faq.category}
          data-keywords={`${faq.question} ${faq.shortKeywords}`}
          class="faq-item group rounded-xl border border-hairline bg-canvas/70 p-4 transition-all duration-200 open:bg-canvas-elevated open:shadow-whisper open:border-link/30 hover:border-hairline-soft"
        >
          <summary class="flex cursor-pointer items-start sm:items-center justify-between gap-3 text-left font-semibold text-ink text-[15px] sm:text-[16px] select-none">
            <div class="flex items-center gap-3 flex-1">
              <span class="inline-flex h-6 px-2 items-center justify-center rounded-md font-mono text-[11px] font-bold uppercase tracking-wider bg-canvas border border-hairline text-link shrink-0">
                Q{index + 1}
              </span>
              <span class="capitalize-first leading-snug">
                {faq.question.endsWith('?') ? faq.question : `${faq.question}?`}
              </span>
            </div>
            <div class="flex items-center gap-2 shrink-0 ml-2">
              <span class="hidden sm:inline-block font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full border border-hairline bg-canvas text-mute">
                {faq.categoryLabel}
              </span>
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-canvas border border-hairline text-mute group-open:rotate-180 group-open:text-link transition-transform duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </div>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2 border-t border-hairline/60 pt-3 text-[14px] sm:text-[15px]">
            <Fragment set:html={faq.answerHtml} />
          </div>
        </details>
      ))}

      <!-- Zero search results fallback notice -->
      <div id="faq-no-results" class="hidden rounded-xl border border-dashed border-hairline p-8 text-center bg-canvas/40 space-y-2">
        <p class="text-base font-semibold text-ink">{t('faq.noResults')}</p>
        <p class="text-sm text-mute">{t('faq.noResultsHint')}</p>
        <button
          type="button"
          id="faq-reset-filter-btn"
          class="mt-2 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-hairline bg-canvas hover:bg-canvas-elevated text-xs font-semibold text-link transition-colors shadow-whisper cursor-pointer"
        >
          {t('faq.reset')}
        </button>
      </div>
    </div>

  </div>
</section>

<!-- JSON-LD Structured Data for FAQPage SEO -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd, null, 2)} />

<!-- Interactive FAQ Filtering & Controls Script -->
<script is:inline>
  (function() {
    function initFaq() {
      const searchInput = document.getElementById('faq-search-input');
      const clearBtn = document.getElementById('faq-search-clear');
      const countNum = document.getElementById('faq-count-num');
      const categoryPills = document.querySelectorAll('.faq-filter-chip');
      const faqItems = document.querySelectorAll('.faq-item');
      const noResults = document.getElementById('faq-no-results');
      const resetBtn = document.getElementById('faq-reset-filter-btn');
      const expandAllBtn = document.getElementById('faq-expand-all-btn');
      const collapseAllBtn = document.getElementById('faq-collapse-all-btn');

      if (!searchInput || !faqItems.length) return;

      let currentCategory = 'all';
      let currentQuery = '';

      function filterFaqs() {
        let visibleCount = 0;
        const query = currentQuery.toLowerCase().trim();

        faqItems.forEach(item => {
          const itemCat = item.getAttribute('data-category');
          const itemKeywords = (item.getAttribute('data-keywords') || '').toLowerCase();
          const itemText = (item.textContent || '').toLowerCase();

          const matchesCategory = currentCategory === 'all' || itemCat === currentCategory;
          const matchesQuery = !query || itemKeywords.includes(query) || itemText.includes(query);

          if (matchesCategory && matchesQuery) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (countNum) {
          countNum.textContent = visibleCount;
        }

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      // Search input handler
      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value;
        if (clearBtn) {
          if (currentQuery.length > 0) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
        filterFaqs();
      });

      // Clear button handler
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          currentQuery = '';
          clearBtn.classList.add('hidden');
          searchInput.focus();
          filterFaqs();
        });
      }

      // Category pills handler
      categoryPills.forEach(pill => {
        pill.addEventListener('click', () => {
          categoryPills.forEach(p => {
            p.classList.remove('active', 'border-link', 'bg-link', 'text-white');
            p.classList.add('border-hairline', 'bg-canvas', 'text-body');
          });
          pill.classList.add('active', 'border-link', 'bg-link', 'text-white');
          pill.classList.remove('border-hairline', 'bg-canvas', 'text-body');

          currentCategory = pill.getAttribute('data-category') || 'all';
          filterFaqs();
        });
      });

      // Reset filter button
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          searchInput.value = '';
          currentQuery = '';
          if (clearBtn) clearBtn.classList.add('hidden');

          categoryPills.forEach(p => {
            const isAll = p.getAttribute('data-category') === 'all';
            if (isAll) {
              p.classList.add('active', 'border-link', 'bg-link', 'text-white');
              p.classList.remove('border-hairline', 'bg-canvas', 'text-body');
            } else {
              p.classList.remove('active', 'border-link', 'bg-link', 'text-white');
              p.classList.add('border-hairline', 'bg-canvas', 'text-body');
            }
          });
          currentCategory = 'all';
          filterFaqs();
        });
      }

      // Expand All
      if (expandAllBtn) {
        expandAllBtn.addEventListener('click', () => {
          faqItems.forEach(item => {
            if (item.style.display !== 'none') {
              item.setAttribute('open', '');
            }
          });
        });
      }

      // Collapse All
      if (collapseAllBtn) {
        collapseAllBtn.addEventListener('click', () => {
          faqItems.forEach(item => {
            item.removeAttribute('open');
          });
        });
      }

      // Auto-open question if URL hash points to it
      if (window.location.hash) {
        const targetId = window.location.hash.substring(1);
        const targetElement = document.getElementById(targetId);
        if (targetElement && targetElement.tagName === 'DETAILS') {
          targetElement.setAttribute('open', '');
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }

    // Initialize on DOMContentLoaded and Astro view transitions / swaps
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFaq);
    } else {
      initFaq();
    }
    document.addEventListener('astro:page-load', initFaq);
  })();
</script>

<style>
  /* Subtle capitalize first letter helper */
  .capitalize-first {
    display: inline-block;
  }
  .capitalize-first::first-letter {
    text-transform: uppercase;
  }
</style>
