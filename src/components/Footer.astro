---
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-hairline bg-canvas py-16 text-body">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5 lg:gap-12">
      <!-- Col 1: Brand & Philosophy -->
      <div class="col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-7 w-7 items-center justify-center rounded-sm bg-ink text-on-primary font-bold">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <span class="text-base font-semibold tracking-tight text-ink">RealPdfEdit</span>
        </div>
        <p class="max-w-sm text-[13px] leading-relaxed text-body">
          The ultimate client-side PDF studio. Edit text, draw, sign, redact, reorder, merge, and split PDFs with complete privacy. No daily limits, no paywalls, and zero server uploads.
        </p>
        <div class="flex items-center gap-2 pt-1 text-[12px] font-mono text-mute">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          <span>100% Client-Side WebAssembly</span>
        </div>
      </div>

      <!-- Col 2: Core Editing Tools -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-ink">Edit & Sign</h4>
        <ul class="space-y-2 text-[13px]">
          <li><a href="/" class="transition-colors hover:text-ink">Full PDF Editor</a></li>
          <li><a href="/sign-pdf" class="transition-colors hover:text-ink">E-Sign PDF</a></li>
          <li><a href="/" class="transition-colors hover:text-ink">Redact & Blackout</a></li>
          <li><a href="/" class="transition-colors hover:text-ink">Add Text & Annotate</a></li>
          <li><a href="/" class="transition-colors hover:text-ink">Watermark & Numbering</a></li>
        </ul>
      </div>

      <!-- Col 3: Organize & Convert -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-ink">Organize</h4>
        <ul class="space-y-2 text-[13px]">
          <li><a href="/merge-pdf" class="transition-colors hover:text-ink">Merge PDFs</a></li>
          <li><a href="/split-pdf" class="transition-colors hover:text-ink">Split & Extract Pages</a></li>
          <li><a href="/" class="transition-colors hover:text-ink">Rotate & Reorder</a></li>
          <li><a href="/compress-pdf" class="transition-colors hover:text-ink">Compress PDF</a></li>
          <li><a href="/pdf-to-images" class="transition-colors hover:text-ink">PDF to PNG / JPG</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Specs -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-ink">Trust & Privacy</h4>
        <ul class="space-y-2 text-[13px]">
          <li><a href="/privacy" class="transition-colors hover:text-ink">Privacy Guarantee</a></li>
          <li><a href="/privacy#gdpr" class="transition-colors hover:text-ink">GDPR & HIPAA Compliance</a></li>
          <li><a href="/privacy#offline" class="transition-colors hover:text-ink">Offline Mode (PWA)</a></li>
          <li><a href="/#comparison" class="transition-colors hover:text-ink">Why We Beat Smallpdf</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Hairline Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-hairline pt-8 text-[12px] text-mute sm:flex-row">
      <p>© {year} RealPdfEdit (realpdfedit.com). All rights reserved. Completely free, open & limitless.</p>
      <div class="flex items-center gap-6">
        <span class="inline-flex items-center gap-1 font-mono text-[11px]">
          Designed with Geist Design System
        </span>
      </div>
    </div>
  </div>
</footer>
