---
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-hairline bg-canvas-elevated/40 backdrop-blur-md py-16 text-body relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5 lg:gap-12">
      <!-- Col 1: Brand & Philosophy -->
      <div class="col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500 via-blue-600 to-indigo-600 text-white font-bold shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <span class="text-base font-bold tracking-tight text-ink font-sans">RealPdfEdit</span>
        </div>
        <p class="max-w-sm text-[13px] leading-relaxed text-body">
          The ultimate client-side PDF studio. Edit text, draw, sign, redact, reorder, merge, and split PDFs with complete privacy. No daily limits, no paywalls, and zero server uploads.
        </p>
        <div class="flex items-center gap-2 pt-1 text-[12px] font-mono text-mute">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          <span>100% Client-Side WebAssembly</span>
        </div>
      </div>

      <!-- Col 2: Core Editing Tools -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-bold uppercase tracking-wider text-ink">Edit & Sign</h4>
        <ul class="space-y-2 text-[13px]">
          <li><a href="/" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Full PDF Editor</a></li>
          <li><a href="/sign-pdf" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">E-Sign PDF</a></li>
          <li><a href="/" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Redact & Blackout</a></li>
          <li><a href="/" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Add Text & Annotate</a></li>
          <li><a href="/" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Watermark & Numbering</a></li>
        </ul>
      </div>

      <!-- Col 3: Organize & Convert -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-bold uppercase tracking-wider text-ink">Organize</h4>
        <ul class="space-y-2 text-[13px]">
          <li><a href="/merge-pdf" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Merge PDFs</a></li>
          <li><a href="/split-pdf" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Split & Extract Pages</a></li>
          <li><a href="/" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Rotate & Reorder</a></li>
          <li><a href="/compress-pdf" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Compress PDF</a></li>
          <li><a href="/pdf-to-images" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">PDF to PNG / JPG</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Specs -->
      <div class="space-y-3">
        <h4 class="font-mono text-[11px] font-bold uppercase tracking-wider text-ink">Trust & Privacy</h4>
        <ul class="space-y-2 text-[13px]">
          <li><a href="/privacy" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Privacy Guarantee</a></li>
          <li><a href="/privacy#gdpr" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">GDPR & HIPAA Compliance</a></li>
          <li><a href="/privacy#offline" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Offline Mode (PWA)</a></li>
          <li><a href="/#comparison" class="transition-all hover:text-ink hover:translate-x-0.5 inline-block">Why We Beat Smallpdf</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Hairline Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-hairline pt-8 text-[12px] text-mute sm:flex-row">
      <p>© {year} RealPdfEdit (realpdfedit.com). 100% Free & Unlimited Client-Side PDF Tools.</p>
      <div class="flex items-center gap-4 font-mono text-[11px]">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          All Systems Operational
        </span>
      </div>
    </div>
  </div>
</footer>
