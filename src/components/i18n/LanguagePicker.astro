---
import { languages, defaultLang, showDefaultLang, type LangCode } from '../../i18n/ui';
import { useTranslatedPath, getRouteFromUrl, getLangFromUrl } from '../../i18n/utils';

interface Props {
  className?: string;
  /** Style: 'inline' = horizontal list, 'dropdown' = single button that expands */
  variant?: 'inline' | 'dropdown';
}

const { className = '', variant = 'dropdown' } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const currentRoute = getRouteFromUrl(Astro.url);
const translate = useTranslatedPath();

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://realeditpdf.com';

function buildHrefForLang(lang: LangCode): string {
  // Home page (route === ''): link to localized home
  if (currentRoute === '' || currentRoute === 'index') {
    return translate('/', lang);
  }
  return translate(`/${currentRoute}`, lang);
}
---

{variant === 'inline' ? (
  <nav class:list={["flex flex-wrap items-center gap-1", className]} aria-label="Language">
    {Object.values(languages).map((l) => {
      const href = buildHrefForLang(l.code as LangCode);
      const isActive = l.code === currentLang;
      return (
        <a
          href={href}
          hreflang={l.htmlLang}
          lang={l.code}
          aria-current={isActive ? 'true' : undefined}
          class:list={[
            "rounded-full px-2.5 py-1 text-[11px] font-medium transition-colors",
            isActive
              ? "bg-ink text-on-primary"
              : "text-body hover:text-ink hover:bg-hairline-soft/80",
          ]}
        >
          {l.code.toUpperCase()}
        </a>
      );
    })}
  </nav>
) : (
  <div class:list={["relative shrink-0", className]} id="lang-picker">
    <button
      type="button"
      id="lang-picker-trigger"
      class="flex h-8.5 sm:h-9 items-center justify-center gap-1 sm:gap-1.5 rounded-xl border border-hairline bg-canvas-elevated/80 px-2 sm:px-3 text-[11px] sm:text-[12px] font-semibold text-ink shadow-whisper transition-all hover:bg-hairline-soft active:scale-95"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label="Select language"
      title="Select language"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4 text-blue-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
      </svg>
      <span class="font-mono uppercase tracking-wider">{currentLang}</span>
      <svg id="lang-picker-chevron" xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5 sm:h-3 sm:w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <div
      id="lang-picker-menu"
      role="listbox"
      aria-label="Available languages"
      class="hidden absolute right-0 top-full mt-2 z-50 min-w-[180px] max-w-[calc(100vw-20px)] rounded-xl border border-hairline bg-canvas-elevated/95 backdrop-blur-2xl p-1.5 shadow-floating"
    >
      {Object.values(languages).map((l) => {
        const href = buildHrefForLang(l.code as LangCode);
        const isActive = l.code === currentLang;
        return (
          <a
            href={href}
            hreflang={l.htmlLang}
            lang={l.code}
            role="option"
            aria-selected={isActive ? 'true' : 'false'}
            class:list={[
              "flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-[13px] transition-colors",
              isActive
                ? "bg-ink text-on-primary font-semibold"
                : "text-body hover:bg-hairline-soft hover:text-ink",
            ]}
          >
            <span class="flex items-center gap-2">
              <span class="font-mono text-[10.5px] uppercase tracking-wider opacity-70">{l.code}</span>
              <span class="font-medium">{l.nativeLabel}</span>
            </span>
            {isActive && (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            )}
          </a>
        );
      })}
    </div>
  </div>
)}

<script is:inline>
  (function() {
    const picker = document.getElementById('lang-picker');
    if (!picker) return;

    const trigger = document.getElementById('lang-picker-trigger');
    const menu = document.getElementById('lang-picker-menu');
    const chevron = document.getElementById('lang-picker-chevron');
    if (!trigger || !menu) return;

    function setOpen(open) {
      if (open) {
        menu.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        chevron?.classList.add('rotate-180');
      } else {
        menu.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('rotate-180');
      }
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !menu.classList.contains('hidden');
      setOpen(!isOpen);
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (menu.classList.contains('hidden')) return;
      if (picker.contains(e.target)) return;
      setOpen(false);
    });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        trigger.focus();
      }
    });
  })();
</script>
