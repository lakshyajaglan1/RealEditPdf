---
// EditorToolbar.astro - Vercel Geist Style Toolbar
---

<div class="relative z-30 w-full border-b border-hairline bg-canvas-elevated/90 backdrop-blur-xl px-2.5 sm:px-4 py-2 text-ink shadow-whisper select-none">
  <div class="flex flex-col 2xl:flex-row 2xl:items-center justify-between gap-2.5">
    <!-- Left Group: Unified Segmented Tools Dock (Flex-wrapping on tablet/desktop, smooth touch scroll ribbon on mobile) -->
    <div class="flex items-center sm:flex-wrap gap-1.5 overflow-x-auto sm:overflow-visible no-scrollbar touch-scroll py-0.5 max-w-full">
      <!-- Main Tools Segment -->
      <div class="flex items-center rounded-xl bg-hairline-soft/80 dark:bg-zinc-900/80 p-1 border border-hairline/70 shadow-sm gap-0.5 shrink-0">
        <!-- Select / Pointer Mode -->
        <button
          id="tool-select"
          class="tool-btn active flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-[13px] font-medium transition-all duration-150 cursor-pointer"
          title="Select & Move (V)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
          </svg>
          <span class="hidden md:inline">Select</span>
        </button>

        <!-- Add Text -->
        <button
          id="tool-text"
          class="tool-btn flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer"
          title="Add & Write Text (T)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
          </svg>
          <span class="hidden md:inline">Text</span>
        </button>

        <!-- Freehand Pen with Dropdown / Size & Options -->
        <div class="relative flex items-center">
          <button
            id="tool-draw"
            class="tool-btn flex h-8 items-center gap-1.5 rounded-l-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer"
            title="Draw Pen (D)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
            <span class="hidden md:inline">Draw</span>
            <span id="draw-color-indicator" class="h-2.5 w-2.5 rounded-full bg-[#171717] ring-1 ring-hairline inline-block ml-0.5"></span>
          </button>
          <button
            id="btn-draw-options"
            type="button"
            class="flex h-8 w-5 items-center justify-center rounded-r-lg border-l border-hairline/60 text-mute hover:bg-canvas-elevated hover:text-ink transition-colors cursor-pointer"
            title="Pen Size & Stroke Options"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-70" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- Draw Quick Options Dropdown -->
          <div id="draw-options-dropdown" class="absolute left-0 top-full z-[100] mt-1.5 hidden w-64 max-w-[calc(100vw-32px)] rounded-xl border border-hairline bg-canvas-elevated/95 backdrop-blur-xl p-3 shadow-floating text-left">
            <div class="mb-2 flex items-center justify-between">
              <span class="text-[12px] font-semibold text-ink">Draw Pen Settings</span>
              <span id="dropdown-draw-size-val" class="font-mono text-[11px] font-bold text-blue-600 dark:text-cyan-400">2px</span>
            </div>
            
            <!-- Pen Size Slider -->
            <div class="space-y-1.5 mb-3">
              <div class="flex items-center justify-between text-[11px] text-mute">
                <span>Pen Size (Thickness):</span>
                <div id="dropdown-draw-preview-dot" class="h-2 w-2 rounded-full bg-ink inline-block transition-all"></div>
              </div>
              <input
                type="range"
                id="dropdown-draw-size"
                min="1"
                max="40"
                value="2"
                class="h-1.5 w-full accent-blue-600 cursor-pointer"
              />
              <div class="flex items-center justify-between gap-1 pt-1">
                <button type="button" class="btn-draw-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="1">1px</button>
                <button type="button" class="btn-draw-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="2">2px</button>
                <button type="button" class="btn-draw-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="5">5px</button>
                <button type="button" class="btn-draw-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="10">10px</button>
                <button type="button" class="btn-draw-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="20">20px</button>
              </div>
            </div>

            <!-- Pen Opacity Slider -->
            <div class="space-y-1.5 mb-3 border-t border-hairline/70 pt-2.5">
              <div class="flex items-center justify-between text-[11px] text-mute">
                <span>Opacity:</span>
                <span id="dropdown-draw-opacity-val" class="font-mono text-[11px] text-ink font-semibold">100%</span>
              </div>
              <input
                type="range"
                id="dropdown-draw-opacity"
                min="0.1"
                max="1.0"
                step="0.05"
                value="1.0"
                class="h-1.5 w-full accent-blue-600 cursor-pointer"
              />
            </div>

            <!-- Color Palette -->
            <div class="border-t border-hairline/70 pt-2.5">
              <span class="text-[11px] text-mute block mb-1.5">Pen Color:</span>
              <div class="flex items-center gap-1.5">
                <input type="color" id="dropdown-draw-color-picker" value="#171717" class="h-6 w-7 cursor-pointer rounded-md border border-hairline bg-transparent p-0" />
                <div class="flex items-center gap-1">
                  <button type="button" class="draw-color-opt h-5 w-5 rounded-full bg-[#171717] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#171717"></button>
                  <button type="button" class="draw-color-opt h-5 w-5 rounded-full bg-[#ef4444] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#ef4444"></button>
                  <button type="button" class="draw-color-opt h-5 w-5 rounded-full bg-[#2563eb] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#2563eb"></button>
                  <button type="button" class="draw-color-opt h-5 w-5 rounded-full bg-[#10b981] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#10b981"></button>
                  <button type="button" class="draw-color-opt h-5 w-5 rounded-full bg-[#f59e0b] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#f59e0b"></button>
                  <button type="button" class="draw-color-opt h-5 w-5 rounded-full bg-[#ffffff] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#ffffff" title="Whiteout Pen"></button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Highlighter with Dropdown / Intensity & Area Size Options -->
        <div class="relative flex items-center">
          <button
            id="tool-highlight"
            class="tool-btn flex h-8 items-center gap-1.5 rounded-l-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer"
            title="Highlighter (H)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" clip-rule="evenodd" />
            </svg>
            <span class="hidden md:inline">Highlight</span>
            <span id="highlight-color-indicator" class="h-2.5 w-2.5 rounded-full bg-[#fef08a] ring-1 ring-hairline inline-block ml-0.5"></span>
          </button>
          <button
            id="btn-highlight-options"
            type="button"
            class="flex h-8 w-5 items-center justify-center rounded-r-lg border-l border-hairline/60 text-mute hover:bg-canvas-elevated hover:text-ink transition-colors cursor-pointer"
            title="Highlight Size, Intensity & Options"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-70" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- Highlight Options Dropdown -->
          <div id="highlight-options-dropdown" class="absolute left-0 top-full z-[100] mt-1.5 hidden w-72 max-w-[calc(100vw-32px)] rounded-xl border border-hairline bg-canvas-elevated/95 backdrop-blur-xl p-3 shadow-floating text-left">
            <div class="mb-2 flex items-center justify-between">
              <span class="text-[12px] font-semibold text-ink">Highlighter Settings</span>
              <span id="dropdown-hl-badge" class="rounded px-1.5 py-0.5 text-[10px] font-mono font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400">Soft Marker</span>
            </div>

            <!-- Intensity Slider -->
            <div class="space-y-1.5 mb-3">
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-mute font-medium">Intensity (Opacity):</span>
                <span id="dropdown-hl-intensity-val" class="font-mono font-bold text-[11px] text-ink">35%</span>
              </div>
              <input
                type="range"
                id="dropdown-hl-intensity"
                min="0.10"
                max="1.0"
                step="0.05"
                value="0.35"
                class="h-1.5 w-full accent-amber-500 cursor-pointer"
              />
              <div class="flex items-center justify-between gap-1 pt-1">
                <button type="button" class="btn-hl-intensity-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-val="0.2">Light 20%</button>
                <button type="button" class="btn-hl-intensity-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-val="0.35">Std 35%</button>
                <button type="button" class="btn-hl-intensity-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-val="0.6">Med 60%</button>
                <button type="button" class="btn-hl-intensity-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-val="0.9">Solid 90%</button>
              </div>
            </div>

            <!-- Size of Highlight Area Slider -->
            <div class="space-y-1.5 mb-3 border-t border-hairline/70 pt-2.5">
              <div class="flex items-center justify-between text-[11px]">
                <span class="text-mute font-medium">Highlight Area Size:</span>
                <span id="dropdown-hl-size-val" class="font-mono font-bold text-[11px] text-ink">24px</span>
              </div>
              <input
                type="range"
                id="dropdown-hl-size"
                min="8"
                max="72"
                step="2"
                value="24"
                class="h-1.5 w-full accent-amber-500 cursor-pointer"
              />
              <!-- Live Highlight Preview Bar -->
              <div class="h-6 w-full rounded bg-hairline-soft/60 flex items-center justify-center overflow-hidden border border-hairline/50 my-1">
                <div id="dropdown-hl-preview-bar" class="w-11/12 rounded-sm bg-[#fef08a] transition-all" style="height: 14px; opacity: 0.35;"></div>
              </div>
              <div class="flex items-center justify-between gap-1 pt-0.5">
                <button type="button" class="btn-hl-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="12">12px</button>
                <button type="button" class="btn-hl-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="24">24px</button>
                <button type="button" class="btn-hl-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="40">40px</button>
                <button type="button" class="btn-hl-size-preset text-[10px] px-1.5 py-0.5 rounded border border-hairline text-mute hover:text-ink hover:bg-hairline-soft cursor-pointer" data-size="60">60px</button>
              </div>
            </div>

            <!-- Color Palette -->
            <div class="border-t border-hairline/70 pt-2.5">
              <span class="text-[11px] text-mute block mb-1.5">Highlight Color:</span>
              <div class="flex items-center gap-1.5">
                <input type="color" id="dropdown-hl-color-picker" value="#fef08a" class="h-6 w-7 cursor-pointer rounded-md border border-hairline bg-transparent p-0" />
                <div class="flex items-center gap-1">
                  <button type="button" class="hl-color-opt h-5 w-5 rounded-full bg-[#fef08a] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#fef08a" title="Lemon Yellow"></button>
                  <button type="button" class="hl-color-opt h-5 w-5 rounded-full bg-[#86efac] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#86efac" title="Lime Green"></button>
                  <button type="button" class="hl-color-opt h-5 w-5 rounded-full bg-[#7dd3fc] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#7dd3fc" title="Sky Cyan"></button>
                  <button type="button" class="hl-color-opt h-5 w-5 rounded-full bg-[#f472b6] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#f472b6" title="Rose Pink"></button>
                  <button type="button" class="hl-color-opt h-5 w-5 rounded-full bg-[#fed7aa] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#fed7aa" title="Amber Orange"></button>
                  <button type="button" class="hl-color-opt h-5 w-5 rounded-full bg-[#e9d5ff] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#e9d5ff" title="Soft Lavender"></button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Shapes Dropdown/Trigger -->
        <div class="relative">
          <button
            id="tool-shape-btn"
            class="tool-btn flex h-8 items-center gap-1 rounded-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer"
            title="Insert Shapes"
            type="button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2" />
            </svg>
            <span class="hidden md:inline">Shapes</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-60 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- Shapes Menu -->
          <div id="shapes-dropdown" class="absolute left-0 top-full z-[100] mt-1.5 hidden w-48 max-w-[calc(100vw-32px)] rounded-xl border border-hairline bg-canvas-elevated/95 backdrop-blur-xl p-1.5 shadow-floating">
            <button type="button" data-shape="rect" class="shape-opt flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-[13px] hover:bg-hairline-soft transition-colors cursor-pointer">
              <span class="h-3.5 w-3.5 border-2 border-ink rounded-none inline-block"></span> <span>Rectangle</span>
            </button>
            <button type="button" data-shape="rounded-rect" class="shape-opt flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-[13px] hover:bg-hairline-soft transition-colors cursor-pointer">
              <span class="h-3.5 w-3.5 border-2 border-ink rounded-sm inline-block"></span> <span>Rounded Box</span>
            </button>
            <button type="button" data-shape="circle" class="shape-opt flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-[13px] hover:bg-hairline-soft transition-colors cursor-pointer">
              <span class="h-3.5 w-3.5 border-2 border-ink rounded-full inline-block"></span> <span>Circle / Ellipse</span>
            </button>
            <button type="button" data-shape="line" class="shape-opt flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-[13px] hover:bg-hairline-soft transition-colors cursor-pointer">
              <span class="h-0.5 w-4 bg-ink inline-block"></span> <span>Straight Line</span>
            </button>
            <button type="button" data-shape="arrow" class="shape-opt flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-[13px] hover:bg-hairline-soft transition-colors cursor-pointer">
              <span class="text-xs font-bold">➔</span> <span>Arrow</span>
            </button>
            <button type="button" data-shape="check" class="shape-opt flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-[13px] hover:bg-hairline-soft transition-colors cursor-pointer">
              <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">✓</span> <span>Checkmark</span>
            </button>
            <button type="button" data-shape="cross" class="shape-opt flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left text-[13px] hover:bg-hairline-soft transition-colors cursor-pointer">
              <span class="text-xs font-bold text-rose-600 dark:text-rose-400">✕</span> <span>Cross Mark</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Specialized Tools Segment (Sign, Image, Stamp, Redact, Watermark) -->
      <div class="flex items-center rounded-xl bg-hairline-soft/80 dark:bg-zinc-900/80 p-1 border border-hairline/70 shadow-sm gap-0.5 shrink-0">
        <!-- E-Signature Modal Trigger -->
        <button
          id="btn-open-sign-modal"
          class="flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer whitespace-nowrap"
          title="Sign Document (S)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
          </svg>
          <span class="hidden md:inline">Sign</span>
        </button>

        <!-- Image Inserter -->
        <button
          id="btn-add-image"
          class="flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer whitespace-nowrap"
          title="Insert Image"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="hidden md:inline">Image</span>
        </button>
        <input type="file" id="image-file-input" accept="image/*" class="hidden" />

        <!-- Resize / Crop Image Button -->
        <button
          id="btn-crop-image-tool"
          class="flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer whitespace-nowrap"
          title="Resize / Crop Image"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h14a2 2 0 012 2v14M7 3v14a2 2 0 002 2h14" />
          </svg>
          <span class="hidden md:inline">Crop</span>
        </button>

        <!-- Stamp Modal Trigger -->
        <button
          id="btn-open-stamp-modal"
          class="flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer whitespace-nowrap"
          title="Add Stamp (Approved, Confidential, etc.)"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="hidden md:inline">Stamp</span>
        </button>

        <!-- Redaction / Blackout -->
        <button
          id="tool-redact"
          class="tool-btn flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-[13px] font-medium text-body transition-all duration-150 hover:bg-canvas-elevated hover:text-ink cursor-pointer whitespace-nowrap"
          title="Redact / Blackout sensitive text"
        >
          <div class="h-3.5 w-3.5 bg-black border border-hairline rounded-xs"></div>
          <span class="hidden md:inline">Redact</span>
        </button>

        <!-- Watermark & Page Numbering -->
        <button
          id="btn-open-watermark-modal"
