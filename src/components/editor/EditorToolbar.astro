      <div class="flex items-center gap-1.5">
        <span class="text-mute text-[11px] font-medium">Pen Size:</span>
        <input type="range" id="prop-draw-size" min="1" max="40" value="2" class="h-1.5 w-20 accent-blue-600 cursor-pointer" title="Pen Stroke Size / Thickness" />
        <span id="prop-draw-size-val" class="font-mono text-[11px] font-bold text-ink min-w-[28px]">2px</span>
        <!-- Live Visual Preview Dot -->
        <span id="prop-draw-preview" class="h-2 w-2 rounded-full bg-ink inline-block" title="Current pen stroke"></span>
      </div>

      <!-- Quick Size Badges -->
      <div class="hidden sm:flex items-center gap-1 border-l border-hairline/80 pl-2">
        <button type="button" class="btn-prop-draw-size h-6 rounded border border-hairline px-1.5 text-[10px] font-mono text-mute hover:text-ink hover:bg-hairline-soft transition-colors cursor-pointer" data-size="1">1px</button>
        <button type="button" class="btn-prop-draw-size h-6 rounded border border-hairline px-1.5 text-[10px] font-mono text-mute hover:text-ink hover:bg-hairline-soft transition-colors cursor-pointer" data-size="2">2px</button>
        <button type="button" class="btn-prop-draw-size h-6 rounded border border-hairline px-1.5 text-[10px] font-mono text-mute hover:text-ink hover:bg-hairline-soft transition-colors cursor-pointer" data-size="5">5px</button>
        <button type="button" class="btn-prop-draw-size h-6 rounded border border-hairline px-1.5 text-[10px] font-mono text-mute hover:text-ink hover:bg-hairline-soft transition-colors cursor-pointer" data-size="10">10px</button>
        <button type="button" class="btn-prop-draw-size h-6 rounded border border-hairline px-1.5 text-[10px] font-mono text-mute hover:text-ink hover:bg-hairline-soft transition-colors cursor-pointer" data-size="20">20px</button>
      </div>

      <!-- Pen Opacity Slider -->
      <div class="flex items-center gap-1.5 border-l border-hairline/80 pl-2">
        <span class="text-mute text-[11px] font-medium">Opacity:</span>
        <input type="range" id="prop-draw-opacity" min="0.1" max="1.0" step="0.05" value="1.0" class="h-1.5 w-18 accent-blue-600 cursor-pointer" title="Pen Opacity" />
        <span id="prop-draw-opacity-val" class="font-mono text-[11px] font-bold text-ink min-w-[32px]">100%</span>
      </div>
    </div>

    <!-- Color Palette (General: Pen, Shapes, Text) -->
    <div id="prop-color-group" class="flex items-center gap-1.5">
      <span class="text-mute text-[11px] font-medium">Color:</span>
      <input type="color" id="prop-color-picker" value="#171717" class="h-6 w-7 cursor-pointer rounded-md border border-hairline bg-transparent p-0" />
      <div class="flex items-center gap-1 ml-0.5">
        <button class="color-preset h-4.5 w-4.5 rounded-full bg-[#171717] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#171717"></button>
        <button class="color-preset h-4.5 w-4.5 rounded-full bg-[#ee0000] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#ee0000"></button>
        <button class="color-preset h-4.5 w-4.5 rounded-full bg-[#0070f3] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#0070f3"></button>
        <button class="color-preset h-4.5 w-4.5 rounded-full bg-[#10b981] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#10b981"></button>
        <button class="color-preset h-4.5 w-4.5 rounded-full bg-[#f5a623] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#f5a623"></button>
        <button class="color-preset h-4.5 w-4.5 rounded-full bg-[#ffffff] border border-hairline hover:scale-110 transition-transform cursor-pointer" data-color="#ffffff" title="Whiteout"></button>
      </div>
    </div>

    <!-- Stroke / Thickness (For Shapes) -->
    <div id="prop-stroke-group" class="flex items-center gap-1.5">
      <span class="text-mute text-[11px] font-medium">Thickness:</span>
      <input type="range" id="prop-stroke-width" min="1" max="24" value="2" class="h-1.5 w-18 accent-blue-600 cursor-pointer" />
      <span id="prop-stroke-val" class="font-mono text-[11px] text-mute">2px</span>
    </div>

    <!-- Opacity (For Shapes / Images / Watermarks) -->
    <div id="prop-opacity-group" class="flex items-center gap-1.5">
      <span class="text-mute text-[11px] font-medium">Opacity:</span>
      <input type="range" id="prop-opacity" min="0.1" max="1" step="0.05" value="1" class="h-1.5 w-18 accent-blue-600 cursor-pointer" />
      <span id="prop-opacity-val" class="font-mono text-[11px] text-mute">100%</span>
    </div>

    <!-- Layer Ordering (Bring Forward / Send Backward) -->
    <div id="prop-layer-group" class="flex items-center gap-1 border-l border-hairline/80 pl-2">
      <button id="btn-layer-forward" type="button" class="flex h-7 items-center gap-1 rounded-lg border border-hairline bg-canvas-elevated px-2 text-[11px] font-medium text-body hover:bg-hairline-soft hover:text-ink transition-colors cursor-pointer" title="Bring Forward">
        <span>▲ Forward</span>
      </button>
      <button id="btn-layer-backward" type="button" class="flex h-7 items-center gap-1 rounded-lg border border-hairline bg-canvas-elevated px-2 text-[11px] font-medium text-body hover:bg-hairline-soft hover:text-ink transition-colors cursor-pointer" title="Send Backward">
        <span>▼ Backward</span>
      </button>
    </div>

    <!-- Delete Selected Element -->
    <div class="ml-auto flex items-center gap-1">
      <button id="btn-delete-element" class="flex h-7 items-center gap-1.5 rounded-lg bg-rose-500/10 border border-rose-500/20 px-2.5 text-[11px] font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-500/20 transition-all cursor-pointer" title="Delete Element (Del)">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>Delete</span>
      </button>
    </div>
  </div>
</div>

