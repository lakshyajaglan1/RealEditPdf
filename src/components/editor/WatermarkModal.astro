---
// WatermarkModal.astro - Watermark & Header/Footer Page Numbers
---

<div id="watermark-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-xs p-4 hidden">
  <div class="w-full max-w-md rounded-lg border border-hairline bg-canvas-elevated p-6 shadow-floating animate-fade-in">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-hairline pb-3">
      <div class="flex items-center gap-2">
        <div class="flex h-6 w-6 items-center justify-center rounded-sm bg-ink text-on-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
          </svg>
        </div>
        <h3 class="text-[16px] font-semibold tracking-tight text-ink">Watermark & Page Numbers</h3>
      </div>
      <button id="btn-close-watermark-modal" class="text-mute hover:text-ink text-lg leading-none p-1">&times;</button>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="mt-4 flex rounded-sm border border-hairline bg-hairline-soft p-0.5 text-[13px] font-medium">
      <button id="watermark-tab-wm" class="flex-1 rounded-sm py-1.5 text-center bg-canvas-elevated text-ink shadow-whisper">
        Watermark
      </button>
      <button id="watermark-tab-pg" class="flex-1 rounded-sm py-1.5 text-center text-body hover:text-ink">
        Page Numbering
      </button>
    </div>

    <!-- Pane 1: Watermark -->
    <div id="watermark-pane-wm" class="mt-4 space-y-4">
      <div>
        <label class="block text-[12px] font-medium text-body mb-1">Watermark Text</label>
        <input
          type="text"
          id="wm-text-input"
          placeholder="e.g. CONFIDENTIAL or SAMPLE"
          value="CONFIDENTIAL"
          class="w-full rounded-sm border border-hairline bg-canvas px-3 py-2 text-[13px] font-medium text-ink outline-none uppercase"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[12px] font-medium text-body mb-1">Opacity: <span id="wm-opacity-label" class="font-mono text-mute">20%</span></label>
          <input type="range" id="wm-opacity-slider" min="0.05" max="0.8" step="0.05" value="0.2" class="w-full accent-ink cursor-pointer" />
        </div>
        <div>
          <label class="block text-[12px] font-medium text-body mb-1">Rotation Angle</label>
          <select id="wm-angle-select" class="w-full rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-[12px] text-ink outline-none">
            <option value="-45" selected>-45° (Diagonal)</option>
            <option value="0">0° (Horizontal)</option>
            <option value="45">45° (Diagonal Up)</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-[12px] font-medium text-body mb-1">Color</label>
        <div class="flex items-center gap-2">
          <input type="color" id="wm-color-picker" value="#ff0000" class="h-6 w-8 cursor-pointer rounded-xs border border-hairline p-0" />
          <span class="text-[12px] text-mute font-mono">Applies to all pages across the PDF</span>
        </div>
      </div>

      <button id="btn-apply-watermark" class="w-full rounded-sm bg-ink py-2 text-[13px] font-medium text-on-primary shadow-whisper hover:opacity-90 active:scale-95 transition-all">
        Apply Watermark to All Pages
      </button>
    </div>

    <!-- Pane 2: Page Numbers -->
    <div id="watermark-pane-pg" class="mt-4 space-y-4 hidden">
      <div>
        <label class="block text-[12px] font-medium text-body mb-1">Format</label>
        <select id="pg-format-select" class="w-full rounded-sm border border-hairline bg-canvas px-2.5 py-2 text-[13px] text-ink outline-none font-mono">
          <option value="Page {n} of {total}" selected>Page 1 of 5</option>
          <option value="{n} / {total}">1 / 5</option>
          <option value="Page {n}">Page 1</option>
          <option value="- {n} -">- 1 -</option>
        </select>
      </div>

      <div>
        <label class="block text-[12px] font-medium text-body mb-1">Position</label>
        <select id="pg-position-select" class="w-full rounded-sm border border-hairline bg-canvas px-2.5 py-2 text-[13px] text-ink outline-none">
          <option value="bottom-center" selected>Bottom Center</option>
          <option value="bottom-right">Bottom Right</option>
          <option value="top-right">Top Right</option>
          <option value="bottom-left">Bottom Left</option>
        </select>
      </div>

      <button id="btn-apply-pagenumbers" class="w-full rounded-sm bg-ink py-2 text-[13px] font-medium text-on-primary shadow-whisper hover:opacity-90 active:scale-95 transition-all">
        Add Page Numbers to All Pages
      </button>
    </div>
  </div>
</div>
