---
// ThumbnailSidebar.astro - Page Organization & Thumbnail Rail
---

<!-- Mobile Backdrop Overlay -->
<div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-black/50 backdrop-blur-xs hidden md:hidden transition-opacity"></div>

<aside id="thumbnail-sidebar" class="fixed md:static inset-y-0 left-0 z-50 w-72 md:w-64 border-r border-hairline bg-canvas-elevated/95 md:bg-canvas-elevated/75 backdrop-blur-xl p-3.5 flex flex-col justify-between overflow-y-auto select-none transition-all duration-200 shadow-2xl md:shadow-none hidden md:flex">
  <div class="space-y-3">
    <div class="flex items-center justify-between pb-2.5 border-b border-hairline/80">
      <div class="flex items-center gap-2">
        <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-ink">Page Thumbnails</span>
        <span id="sidebar-page-count" class="rounded-full bg-blue-500/10 px-2 py-0.5 font-mono text-[10px] font-bold text-blue-600 dark:text-cyan-400">0</span>
      </div>
      <button id="btn-collapse-sidebar" class="text-mute hover:text-ink text-xs p-1 rounded-md hover:bg-hairline-soft transition-colors" title="Close Panel">✕</button>
    </div>
    <p class="text-[10px] text-mute font-medium px-0.5">Drag cards or use ↑ / ↓ to rearrange pages</p>

    <!-- Thumbnails Container -->
    <div id="thumbnails-list" class="space-y-3 max-h-[calc(100vh-280px)] overflow-y-auto pr-1">
      <!-- Generated via JS -->
    </div>
  </div>

  <!-- Bottom Page Actions -->
  <div class="pt-3 border-t border-hairline/80 space-y-2">
    <button
      id="btn-add-blank-page"
      class="w-full flex items-center justify-center gap-2 rounded-xl border border-hairline bg-canvas-elevated py-2 text-[12px] font-medium text-body hover:bg-hairline-soft hover:text-ink shadow-whisper transition-all cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-blue-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Insert Blank Page</span>
    </button>

    <label
      class="w-full flex items-center justify-center gap-2 rounded-xl border border-hairline bg-canvas-elevated py-2 text-[12px] font-medium text-body hover:bg-hairline-soft hover:text-ink shadow-whisper cursor-pointer transition-all"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <span>Append from PDF</span>
      <input type="file" id="append-pdf-input" accept="application/pdf" class="hidden" />
    </label>

    <button
      id="btn-sidebar-reset-all"
      type="button"
      class="w-full flex items-center justify-center gap-2 rounded-xl border border-hairline bg-canvas-elevated py-2 text-[12px] font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 shadow-whisper transition-all cursor-pointer"
      title="Reset all changes across all pages in a single click"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
      <span>Reset All Pages</span>
    </button>
  </div>
</aside>
