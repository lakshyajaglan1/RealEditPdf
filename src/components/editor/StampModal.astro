---
// StampModal.astro - Vector Stamps & Badges
import { useTranslations, getLangFromUrl } from '../../i18n/utils';

interface Props {
  t?: (key: string) => string;
}
const { t: tProp } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
const t = tProp ?? useTranslations(lang);

// Locale-aware date for stamp subtitles
const locale = lang === 'en' ? 'en-US' : lang === 'es' ? 'es-ES' : lang === 'ja' ? 'ja-JP' : lang === 'fr' ? 'fr-FR' : lang === 'de' ? 'de-DE' : lang === 'pt' ? 'pt-PT' : lang === 'ko' ? 'ko-KR' : 'it-IT';
const today = new Date().toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' });

const s = {
  title: t('stamp.title'),
  angle: t('stamp.angle'),
  angleFlat: t('stamp.angleFlat'),
  angleClassic: t('stamp.angleClassic'),
  custom: t('stamp.custom'),
  customPlaceholder: t('stamp.customPlaceholder'),
  create: t('stamp.create'),
  approved: t('stamp.approved'),
  confidential: t('stamp.confidential'),
  draft: t('stamp.draft'),
  paid: t('stamp.paid'),
  void: t('stamp.void'),
  final: t('stamp.final'),
  doNotDistribute: t('stamp.doNotDistribute'),
  inProgress: t('stamp.inProgress'),
  cancelled: t('stamp.cancelled'),
  verified: t('stamp.verified'),
  angleSliderTitle: t('stamp.angleSliderTitle'),
};
---

<div id="stamp-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md p-3 sm:p-4 hidden">
  <div class="w-full max-w-lg max-h-[92vh] overflow-y-auto rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-7 shadow-floating animate-fade-in">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-hairline/80 pb-3.5">
      <div class="flex items-center gap-2.5">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-600 text-white shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-[17px] font-bold tracking-tight text-ink">{s.title}</h3>
      </div>
      <button id="btn-close-stamp-modal" class="text-mute hover:text-ink text-xl leading-none p-1.5 rounded-lg hover:bg-hairline-soft transition-colors cursor-pointer">&times;</button>
    </div>

    <!-- Stamp Angle / Orientation Selector (Any Angle) -->
    <div class="mt-4 rounded-xl border border-hairline/80 bg-hairline-soft/40 px-3.5 py-2.5 text-[12px] space-y-2">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="text-mute font-mono text-[11px] uppercase tracking-wider font-semibold">{s.angle}</span>
          <span id="stamp-angle-display" class="font-mono text-xs font-bold text-purple-600 dark:text-purple-400">-12°</span>
        </div>
        <div class="flex items-center gap-1" id="stamp-angle-options">
          <button type="button" class="stamp-angle-opt px-2 py-0.5 rounded border border-hairline bg-canvas-elevated text-body hover:text-ink font-mono text-[10px] cursor-pointer transition-all" data-angle="0">{s.angleFlat}</button>
          <button type="button" class="stamp-angle-opt px-2 py-0.5 rounded border border-purple-500 bg-purple-500/10 text-purple-600 dark:text-purple-400 font-mono text-[10px] font-semibold cursor-pointer transition-all" data-angle="-12">{s.angleClassic}</button>
          <button type="button" class="stamp-angle-opt px-2 py-0.5 rounded border border-hairline bg-canvas-elevated text-body hover:text-ink font-mono text-[10px] cursor-pointer transition-all" data-angle="12">+12°</button>
          <button type="button" class="stamp-angle-opt px-2 py-0.5 rounded border border-hairline bg-canvas-elevated text-body hover:text-ink font-mono text-[10px] cursor-pointer transition-all" data-angle="45">45°</button>
          <button type="button" class="stamp-angle-opt px-2 py-0.5 rounded border border-hairline bg-canvas-elevated text-body hover:text-ink font-mono text-[10px] cursor-pointer transition-all" data-angle="90">90°</button>
        </div>
      </div>
      <!-- Smooth Angle Range Slider (Any angle from -180° to 180°) -->
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-mono text-mute">-180°</span>
        <input
          type="range"
          id="stamp-angle-slider"
          min="-180"
          max="180"
          value="-12"
          class="flex-1 h-1.5 accent-purple-600 cursor-pointer"
          title={s.angleSliderTitle}
        />
        <span class="text-[10px] font-mono text-mute">+180°</span>
      </div>
    </div>

    <!-- Stamps Grid -->
    <div class="mt-4 space-y-4">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <!-- APPROVED -->
        <button
          class="stamp-preset-btn flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/20 transition-all hover:scale-[1.03] active:scale-95 cursor-pointer shadow-sm"
          data-text={s.approved}
          data-color="#059669"
        >
          <span class="font-mono text-sm font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 border-2 border-emerald-600 dark:border-emerald-400 px-2.5 py-0.5 rounded-md">
            {s.approved}
          </span>
          <span class="stamp-current-date text-[10px] font-mono text-emerald-600/80 dark:text-emerald-400/80 mt-1.5">{today}</span>
        </button>

        <!-- CONFIDENTIAL -->
        <button
          class="stamp-preset-btn flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-rose-500/30 bg-rose-500/10 hover:bg-rose-500/20 transition-all hover:scale-[1.03] active:scale-95 cursor-pointer shadow-sm"
          data-text={s.confidential}
          data-color="#dc2626"
        >
          <span class="font-mono text-sm font-bold uppercase tracking-widest text-rose-600 dark:text-rose-400 border-2 border-rose-600 dark:border-rose-400 px-2.5 py-0.5 rounded-md">
            {s.confidential}
          </span>
          <span class="text-[10px] font-mono text-rose-600/80 dark:text-rose-400/80 mt-1.5">{s.doNotDistribute}</span>
        </button>

        <!-- DRAFT -->
        <button
          class="stamp-preset-btn flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-blue-500/30 bg-blue-500/10 hover:bg-blue-500/20 transition-all hover:scale-[1.03] active:scale-95 cursor-pointer shadow-sm"
          data-text={s.draft}
          data-color="#2563eb"
        >
          <span class="font-mono text-sm font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 border-2 border-blue-600 dark:border-blue-400 px-2.5 py-0.5 rounded-md">
            {s.draft}
          </span>
          <span class="text-[10px] font-mono text-blue-600/80 dark:text-blue-400/80 mt-1.5">{s.inProgress}</span>
        </button>

        <!-- PAID -->
        <button
          class="stamp-preset-btn flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-teal-500/30 bg-teal-500/10 hover:bg-teal-500/20 transition-all hover:scale-[1.03] active:scale-95 cursor-pointer shadow-sm"
          data-text={s.paid}
          data-color="#0d9488"
        >
          <span class="font-mono text-sm font-bold uppercase tracking-widest text-teal-600 dark:text-teal-400 border-2 border-teal-600 dark:border-teal-400 px-2.5 py-0.5 rounded-md">
            {s.paid}
          </span>
          <span class="stamp-current-date text-[10px] font-mono text-teal-600/80 dark:text-teal-400/80 mt-1.5">{today}</span>
        </button>

        <!-- VOID -->
        <button
          class="stamp-preset-btn flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-purple-500/30 bg-purple-500/10 hover:bg-purple-500/20 transition-all hover:scale-[1.03] active:scale-95 cursor-pointer shadow-sm"
          data-text={s.void}
          data-color="#7c3aed"
        >
          <span class="font-mono text-sm font-bold uppercase tracking-widest text-purple-600 dark:text-purple-400 border-2 border-purple-600 dark:border-purple-400 px-2.5 py-0.5 rounded-md">
            {s.void}
          </span>
          <span class="text-[10px] font-mono text-purple-600/80 dark:text-purple-400/80 mt-1.5">{s.cancelled}</span>
        </button>

        <!-- FINAL -->
        <button
          class="stamp-preset-btn flex flex-col items-center justify-center p-3.5 rounded-xl border-2 border-slate-500/30 bg-slate-500/10 hover:bg-slate-500/20 transition-all hover:scale-[1.03] active:scale-95 cursor-pointer shadow-sm"
          data-text={s.final}
          data-color="#475569"
        >
          <span class="font-mono text-sm font-bold uppercase tracking-widest text-slate-700 dark:text-slate-300 border-2 border-slate-700 dark:border-slate-300 px-2.5 py-0.5 rounded-md">
            {s.final}
          </span>
          <span class="text-[10px] font-mono text-slate-600/80 dark:text-slate-400/80 mt-1.5">{s.verified}</span>
        </button>
      </div>

      <!-- Custom Stamp Creator -->
      <div class="rounded-2xl border border-hairline bg-canvas p-4 space-y-2.5 shadow-inner">
        <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-mute">{s.custom}</span>
        <div class="flex gap-2.5">
          <input
            type="text"
            id="custom-stamp-text"
            placeholder={s.customPlaceholder}
            class="flex-1 rounded-xl border border-hairline bg-canvas-elevated px-3 py-2 text-[13px] font-mono text-ink outline-none uppercase focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          />
          <input type="color" id="custom-stamp-color" value="#0070f3" class="h-9 w-9 cursor-pointer rounded-xl border border-hairline p-0" />
          <button id="btn-insert-custom-stamp" class="rounded-xl bg-ink px-4 py-2 text-[13px] font-semibold text-on-primary hover:opacity-90 active:scale-95 transition-all cursor-pointer">
            {s.create}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const locale = document.documentElement.lang || navigator.language || 'en-US';
      const formattedDate = new Date().toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' });
      document.querySelectorAll('.stamp-current-date').forEach((el) => {
        el.textContent = formattedDate;
      });
    } catch (e) {
      console.warn('Could not update dynamic stamp dates:', e);
    }
  });
</script>
