    });

    // Export PDF with all modifications & overlays
    exportBtn.addEventListener('click', async () => {
      if (!state.pdfBytes) {
        alert('Please open or create a PDF first.');
        return;
      }

      showLoading('Compiling High-Resolution PDF...');
      try {
        const { PDFDocument, rgb, degrees, StandardFonts } = window.PDFLib;
        const pdfDoc = await PDFDocument.load(state.pdfBytes);
        const font = await pdfDoc.embedFont(StandardFonts.Helvetica);

        const pages = pdfDoc.getPages();

        // Apply page rotations & annotations
        for (let i = 0; i < pages.length; i++) {
          const pNum = i + 1;
          const page = pages[i];
          const rotationAngle = state.pageRotations[pNum] || 0;
          if (rotationAngle !== 0) {
            page.setRotation(degrees((page.getRotation().angle + rotationAngle) % 360));
          }

          const pageAnnots = state.annotations[pNum] || [];
          const { width: pWidth, height: pHeight } = page.getSize();
          const displayWidth = renderCanvas.width / 1.5;
          const displayHeight = renderCanvas.height / 1.5;
          const scaleX = pWidth / displayWidth;
          const scaleY = pHeight / displayHeight;

          // Apply page crop box if cropped
          if (state.pageCrops && state.pageCrops[pNum]) {
            const crop = state.pageCrops[pNum];
            const cropPdfX = crop.x * scaleX;
            const cropPdfW = crop.width * scaleX;
            const cropPdfH = crop.height * scaleY;
            const cropPdfY = pHeight - ((crop.y + crop.height) * scaleY);
            page.setCropBox(cropPdfX, cropPdfY, cropPdfW, cropPdfH);
          }

          // 1. Embed Freehand drawings and highlights layer for this page
          const drawAnnots = pageAnnots.filter(a => a.type === 'draw');
          if (drawAnnots.length > 0) {
            const offscreenCanvas = document.createElement('canvas');
            offscreenCanvas.width = pWidth * 2;
            offscreenCanvas.height = pHeight * 2;
            const offCtx = offscreenCanvas.getContext('2d');

            const scaleToExportX = (pWidth * 2) / displayWidth;
            const scaleToExportY = (pHeight * 2) / displayHeight;

            drawAnnots.forEach(drawItem => {
              if (!drawItem.points || drawItem.points.length < 2) return;
              offCtx.save();
              offCtx.beginPath();
              offCtx.strokeStyle = drawItem.color;
              offCtx.lineWidth = drawItem.lineWidth * scaleToExportX;
              offCtx.globalAlpha = drawItem.opacity !== undefined ? drawItem.opacity : 1.0;
              offCtx.lineCap = 'round';
              offCtx.lineJoin = 'round';

              offCtx.moveTo(drawItem.points[0].x * scaleToExportX, drawItem.points[0].y * scaleToExportY);
              for (let pt = 1; pt < drawItem.points.length; pt++) {
                offCtx.lineTo(drawItem.points[pt].x * scaleToExportX, drawItem.points[pt].y * scaleToExportY);
              }
              offCtx.stroke();
              offCtx.restore();
            });

            const drawPngDataUrl = offscreenCanvas.toDataURL('image/png');
            const drawPngBytes = await fetch(drawPngDataUrl).then(r => r.arrayBuffer());
            const embeddedDrawLayer = await pdfDoc.embedPng(drawPngBytes);
            page.drawImage(embeddedDrawLayer, {
              x: 0,
              y: 0,
              width: pWidth,
              height: pHeight,
            });
          }

          // 2. Render Text, Redact, Shapes, Images, Signatures, Stamps
          for (const annot of pageAnnots) {
            if (annot.type === 'text') {
              const pdfX = annot.x * scaleX;
              const pdfY = pHeight - ((annot.y + annot.fontSize) * scaleY);
              const hex = annot.color || '#171717';
              const r = parseInt(hex.slice(1,3), 16) / 255 || 0.09;
              const g = parseInt(hex.slice(3,5), 16) / 255 || 0.09;
              const b = parseInt(hex.slice(5,7), 16) / 255 || 0.09;
              page.drawText(annot.text || '', {
                x: pdfX,
                y: pdfY,
                size: annot.fontSize * scaleY,
                font,
                color: rgb(r, g, b),
              });
            } else if (annot.type === 'redact') {
              const w = annot.width || 140;
              const h = annot.height || 30;
              const pdfX = annot.x * scaleX;
              const pdfY = pHeight - ((annot.y + h) * scaleY);
              page.drawRectangle({
                x: pdfX,
                y: pdfY,
                width: w * scaleX,
                height: h * scaleY,
                color: rgb(0, 0, 0),
              });
            } else if (annot.type === 'shape') {
              const w = annot.width || 120;
              const h = annot.height || 60;
              const pdfX = annot.x * scaleX;
              const pdfY = pHeight - ((annot.y + h) * scaleY);
              const hex = annot.color || '#171717';
              const r = parseInt(hex.slice(1,3), 16) / 255 || 0.09;
              const g = parseInt(hex.slice(3,5), 16) / 255 || 0.09;
              const b = parseInt(hex.slice(5,7), 16) / 255 || 0.09;

              if (annot.shapeType === 'rect' || annot.shapeType === 'rounded-rect') {
                page.drawRectangle({
                  x: pdfX,
                  y: pdfY,
                  width: w * scaleX,
                  height: h * scaleY,
                  borderColor: rgb(r, g, b),
                  borderWidth: (annot.strokeWidth || 2) * scaleX,
                });
              } else if (annot.shapeType === 'circle') {
                page.drawEllipse({
                  x: pdfX + (w * scaleX) / 2,
                  y: pdfY + (h * scaleY) / 2,
                  xScale: (w * scaleX) / 2,
                  yScale: (h * scaleY) / 2,
                  borderColor: rgb(r, g, b),
                  borderWidth: (annot.strokeWidth || 2) * scaleX,
                });
              } else if (annot.shapeType === 'line') {
                page.drawLine({
                  start: { x: pdfX, y: pHeight - (annot.y * scaleY) },
                  end: { x: pdfX + w * scaleX, y: pHeight - (annot.y * scaleY) },
                  color: rgb(r, g, b),
                  thickness: (annot.strokeWidth || 2) * scaleX,
                });
              } else if (annot.shapeType === 'check') {
                page.drawText('✓', {
                  x: pdfX + (w * scaleX) * 0.15,
                  y: pdfY + (h * scaleY) * 0.15,
                  size: Math.min(w * scaleX, h * scaleY) * 0.75,
                  font,
                  color: rgb(r, g, b),
                });
              } else if (annot.shapeType === 'cross') {
                page.drawText('X', {
                  x: pdfX + (w * scaleX) * 0.2,
                  y: pdfY + (h * scaleY) * 0.15,
                  size: Math.min(w * scaleX, h * scaleY) * 0.75,
                  font,
                  color: rgb(r, g, b),
                });
              } else if (annot.shapeType === 'arrow') {
                page.drawText('➔', {
                  x: pdfX + (w * scaleX) * 0.1,
                  y: pdfY + (h * scaleY) * 0.2,
                  size: Math.min(w * scaleX, h * scaleY) * 0.75,
                  font,
                  color: rgb(r, g, b),
                });
              }
            } else if (annot.type === 'signature' || annot.type === 'image') {
              const imgBytes = await fetch(annot.src).then(r => r.arrayBuffer());
              let embeddedImg;
              if (annot.src.startsWith('data:image/png')) {
                embeddedImg = await pdfDoc.embedPng(imgBytes);
              } else {
                embeddedImg = await pdfDoc.embedJpg(imgBytes).catch(async () => await pdfDoc.embedPng(imgBytes));
              }

              const w = annot.width || 160;
              const h = annot.height || 70;
              const pdfX = annot.x * scaleX;
              const imgW = w * scaleX;
              const imgH = h * scaleY;
              const pdfY = pHeight - ((annot.y + h) * scaleY);

              page.drawImage(embeddedImg, {
                x: pdfX,
                y: pdfY,
                width: imgW,
                height: imgH,
              });
            }
          }
        }

        const finalBytes = await pdfDoc.save();
        const blob = new Blob([finalBytes], { type: 'application/pdf' });
        const downloadUrl = URL.createObjectURL(blob);

        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = 'RealEditPdf-Document.pdf';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(downloadUrl);

        // Confetti celebration
        if (window.confetti) {
          window.confetti({
            particleCount: 100,
            spread: 70,
            origin: { y: 0.6 }
          });
        }
      } catch (err) {
        console.error('Export error:', err);
        alert('Failed to export PDF: ' + err.message);
      } finally {
        hideLoading();
      }
    });

    // Signature Modal Logic
    const signModal = document.getElementById('signature-modal');
    const openSignBtn = document.getElementById('btn-open-sign-modal');
    const closeSignBtn = document.getElementById('btn-close-sign-modal');
    const cancelSignBtn = document.getElementById('btn-cancel-sign');
    const insertSignBtn = document.getElementById('btn-insert-sign');
    const signDrawCanvas = document.getElementById('sign-draw-canvas');
    const clearSignBtn = document.getElementById('btn-clear-draw-sign');
    const signTypeInput = document.getElementById('sign-type-input');
    const signDropzone = document.getElementById('sign-dropzone');
    const signUploadInput = document.getElementById('sign-upload-input');
    const signUploadPreview = document.getElementById('sign-upload-preview');
    const signUploadPreviewContainer = document.getElementById('sign-upload-preview-container');
    const btnReuploadSign = document.getElementById('btn-reupload-sign');

    let currentSignTab = 'draw';
    let isSignDrawing = false;
    let signInkColor = '#171717';
    let uploadedSignatureDataUrl = null;
    let selectedSignFont = "'Dancing Script', cursive";

    // Tab buttons & Panes
    const tabDraw = document.getElementById('sign-tab-draw');
    const tabType = document.getElementById('sign-tab-type');
    const tabUpload = document.getElementById('sign-tab-upload');
    const paneDraw = document.getElementById('sign-pane-draw');
    const paneType = document.getElementById('sign-pane-type');
    const paneUpload = document.getElementById('sign-pane-upload');

    function switchSignTab(tab) {
      currentSignTab = tab;
      [tabDraw, tabType, tabUpload].forEach(btn => {
        if (btn) btn.className = 'flex-1 rounded-sm py-1.5 text-center text-body hover:text-ink cursor-pointer';
      });
      [paneDraw, paneType, paneUpload].forEach(p => {
        if (p) p.classList.add('hidden');
      });

      if (tab === 'draw') {
        if (tabDraw) tabDraw.className = 'flex-1 rounded-sm py-1.5 text-center bg-canvas-elevated text-ink shadow-whisper font-semibold cursor-pointer';
        paneDraw?.classList.remove('hidden');
      } else if (tab === 'type') {
        if (tabType) tabType.className = 'flex-1 rounded-sm py-1.5 text-center bg-canvas-elevated text-ink shadow-whisper font-semibold cursor-pointer';
        paneType?.classList.remove('hidden');
        updateTypePreviews();
      } else if (tab === 'upload') {
        if (tabUpload) tabUpload.className = 'flex-1 rounded-sm py-1.5 text-center bg-canvas-elevated text-ink shadow-whisper font-semibold cursor-pointer';
        paneUpload?.classList.remove('hidden');
      }
    }

    tabDraw?.addEventListener('click', () => switchSignTab('draw'));
    tabType?.addEventListener('click', () => switchSignTab('type'));
    tabUpload?.addEventListener('click', () => switchSignTab('upload'));

    // Open/Close
    openSignBtn?.addEventListener('click', () => {
      signModal?.classList.remove('hidden');
      switchSignTab(currentSignTab);
    });
    closeSignBtn?.addEventListener('click', () => signModal?.classList.add('hidden'));
    cancelSignBtn?.addEventListener('click', () => signModal?.classList.add('hidden'));

    // Signature Drawing Canvas setup
    const sCtx = signDrawCanvas?.getContext('2d');
    if (sCtx) {
      sCtx.lineWidth = 2.5;
      sCtx.lineCap = 'round';
      sCtx.lineJoin = 'round';
    }

    // Ink Color Selection
    document.querySelectorAll('.sign-ink-color').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.sign-ink-color').forEach(b => b.classList.remove('ring-2', 'ring-link'));
        btn.classList.add('ring-2', 'ring-link');
        signInkColor = btn.dataset.color || '#171717';
        updateTypePreviews();
      });
    });

    const signCustomColor = document.getElementById('sign-custom-color');
    signCustomColor?.addEventListener('input', (e) => {
      document.querySelectorAll('.sign-ink-color').forEach(b => b.classList.remove('ring-2', 'ring-link'));
      signInkColor = e.target.value;
      updateTypePreviews();
    });

    // Type signature live preview updates
    function updateTypePreviews() {
      const text = signTypeInput?.value.trim() || 'John Doe';
      document.querySelectorAll('.sign-preview').forEach(preview => {
        preview.textContent = text;
        preview.style.color = signInkColor;
      });
    }

    signTypeInput?.addEventListener('input', updateTypePreviews);

    // Font selection in Type tab
    document.querySelectorAll('.sign-font-opt').forEach(opt => {
      opt.addEventListener('click', () => {
        document.querySelectorAll('.sign-font-opt').forEach(o => {
          o.classList.remove('border-2', 'border-link');
          o.classList.add('border', 'border-hairline');
        });
        opt.classList.remove('border', 'border-hairline');
        opt.classList.add('border-2', 'border-link');
        const radio = opt.querySelector('input[type="radio"]');
        if (radio) {
          radio.checked = true;
          selectedSignFont = radio.value;
        }
      });
    });

    // Draw Tab Canvas Handlers
    signDrawCanvas?.addEventListener('mousedown', (e) => {
      isSignDrawing = true;
      const r = signDrawCanvas.getBoundingClientRect();
      sCtx.beginPath();
      sCtx.strokeStyle = signInkColor;
      sCtx.moveTo(e.clientX - r.left, e.clientY - r.top);
    });

    signDrawCanvas?.addEventListener('mousemove', (e) => {
      if (!isSignDrawing) return;
      const r = signDrawCanvas.getBoundingClientRect();
      sCtx.lineTo(e.clientX - r.left, e.clientY - r.top);
      sCtx.stroke();
    });

    signDrawCanvas?.addEventListener('mouseup', () => isSignDrawing = false);
    signDrawCanvas?.addEventListener('mouseleave', () => isSignDrawing = false);
    clearSignBtn?.addEventListener('click', () => sCtx?.clearRect(0, 0, signDrawCanvas.width, signDrawCanvas.height));

    // Upload Signature Dropzone & Background Transparency Processing
    signDropzone?.addEventListener('click', () => signUploadInput?.click());
    signDropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      signDropzone.classList.add('border-link', 'bg-hairline-soft');
    });
    signDropzone?.addEventListener('dragleave', () => {
      signDropzone.classList.remove('border-link', 'bg-hairline-soft');
    });
    signDropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      signDropzone.classList.remove('border-link', 'bg-hairline-soft');
      const file = e.dataTransfer.files[0];
      if (file && file.type.startsWith('image/')) {
        processUploadedSignature(file);
      }
    });

    signUploadInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) processUploadedSignature(file);
    });

    btnReuploadSign?.addEventListener('click', () => {
      uploadedSignatureDataUrl = null;
      signUploadPreviewContainer?.classList.add('hidden');
      signDropzone?.classList.remove('hidden');
      if (signUploadInput) signUploadInput.value = '';
    });

    function processUploadedSignature(file) {
      const reader = new FileReader();
      reader.onload = (ev) => {
        const img = new Image();
        img.onload = () => {
          const c = document.createElement('canvas');
          c.width = img.width;
          c.height = img.height;
          const ctx = c.getContext('2d');
          ctx.drawImage(img, 0, 0);

          // Transparency: strip near-white background pixels
          const imgData = ctx.getImageData(0, 0, c.width, c.height);
          const data = imgData.data;
          for (let i = 0; i < data.length; i += 4) {
            const r = data[i], g = data[i+1], b = data[i+2];
            // If near white, make pixel transparent
            if (r > 205 && g > 205 && b > 205) {
              data[i+3] = 0;
            }
          }
          ctx.putImageData(imgData, 0, 0);

          uploadedSignatureDataUrl = c.toDataURL('image/png');
          if (signUploadPreview) signUploadPreview.src = uploadedSignatureDataUrl;
          signDropzone?.classList.add('hidden');
          signUploadPreviewContainer?.classList.remove('hidden');
          signUploadPreviewContainer?.classList.add('flex');
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    }

    // Insert Signature logic for Draw, Type & Upload
    insertSignBtn?.addEventListener('click', () => {
      let finalDataUrl = null;
      let finalWidth = 160;
      let finalHeight = 70;

      if (currentSignTab === 'draw') {
        finalDataUrl = signDrawCanvas.toDataURL('image/png');
        finalWidth = 160;
        finalHeight = 70;
      } else if (currentSignTab === 'type') {
        const name = signTypeInput?.value.trim() || 'John Doe';
        const typeCanvas = document.createElement('canvas');
        typeCanvas.width = 500;
        typeCanvas.height = 180;
        const tctx = typeCanvas.getContext('2d');
        tctx.clearRect(0, 0, typeCanvas.width, typeCanvas.height);
        tctx.font = `52px ${selectedSignFont}`;
        tctx.fillStyle = signInkColor;
        tctx.textAlign = 'center';
        tctx.textBaseline = 'middle';
        tctx.fillText(name, 250, 90);
        finalDataUrl = typeCanvas.toDataURL('image/png');
        finalWidth = 180;
        finalHeight = 65;
      } else if (currentSignTab === 'upload') {
        if (!uploadedSignatureDataUrl) {
          alert('Please upload an image of your signature first.');
          return;
        }
        finalDataUrl = uploadedSignatureDataUrl;
        finalWidth = 160;
        finalHeight = 70;
      }

      if (!finalDataUrl) {
        alert('Please draw, type, or upload your signature.');
        return;
      }

      const newSign = {
        id: 'sign-' + Date.now(),
        type: 'signature',
        src: finalDataUrl,
        x: 100,
        y: 200,
        width: finalWidth,
        height: finalHeight,
      };

      if (state.currentPage) {
        state.annotations[state.currentPage].push(newSign);
        saveHistory();
        renderAnnotationsLayer();
      }

      signModal?.classList.add('hidden');
      sCtx?.clearRect(0, 0, signDrawCanvas.width, signDrawCanvas.height);
    });

    // Stamp Modal Logic (Approved, Confidential, etc.)
    const stampModal = document.getElementById('stamp-modal');
    const openStampBtn = document.getElementById('btn-open-stamp-modal');
    const closeStampBtn = document.getElementById('btn-close-stamp-modal');

    openStampBtn?.addEventListener('click', () => stampModal?.classList.remove('hidden'));
    closeStampBtn?.addEventListener('click', () => stampModal?.classList.add('hidden'));

    document.querySelectorAll('.stamp-preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.dataset.text;
        const color = btn.dataset.color;
        
        // Generate stamp badge canvas data URL
        const stampC = document.createElement('canvas');
        stampC.width = 240;
        stampC.height = 90;
        const sctx = stampC.getContext('2d');
        sctx.strokeStyle = color;
        sctx.lineWidth = 4;
        sctx.strokeRect(6, 6, 228, 78);
        sctx.font = 'bold 22px Geist Mono, monospace';
        sctx.fillStyle = color;
        sctx.textAlign = 'center';
        sctx.textBaseline = 'middle';
        sctx.fillText(text, 120, 38);
        sctx.font = '11px Geist Mono, monospace';
        sctx.fillText(new Date().toLocaleDateString(), 120, 62);

        const newStamp = {
          id: 'stamp-' + Date.now(),
          type: 'image',
          src: stampC.toDataURL('image/png'),
          x: 150,
          y: 150,
          width: 160,
          height: 60,
        };
        state.annotations[state.currentPage].push(newStamp);
        saveHistory();
        renderAnnotationsLayer();
        stampModal?.classList.add('hidden');
      });
    });

    // Image Upload
    const imageInput = document.getElementById('image-file-input');
    const addImageBtn = document.getElementById('btn-add-image');
    addImageBtn?.addEventListener('click', () => imageInput?.click());

    imageInput?.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          const newImg = {
            id: 'img-' + Date.now(),
            type: 'image',
            src: ev.target.result,
            x: 100,
            y: 100,
            width: 200,
            height: 140,
          };
          state.annotations[state.currentPage].push(newImg);
          saveHistory();
          renderAnnotationsLayer();
          selectAnnotation(newImg);
        };
        reader.readAsDataURL(file);
        // Reset input so same file can be chosen again
        imageInput.value = '';
      }
    });

    // ==========================================
    // Image Crop & Resize Studio Modal Logic
    // ==========================================
    let cropActiveAnnot = null;
    let cropIsNewImage = false;
    let cropOriginalSrc = '';
    let cropCurrentSrc = '';
    let cropBoxState = { x: 0, y: 0, w: 100, h: 100 };
    let cropActiveRatio = 'free';
    let cropIsRatioLocked = true;

    const cropModal = document.getElementById('image-crop-modal');
    const cropImg = document.getElementById('crop-image');
    const cropBox = document.getElementById('crop-box');
    const cropBadge = document.getElementById('crop-box-badge');
    const cropOutDim = document.getElementById('crop-output-dimensions');
    const cropInputW = document.getElementById('crop-input-w');
    const cropInputH = document.getElementById('crop-input-h');
    const cropCloseBtn = document.getElementById('btn-close-crop-modal');
    const cropCancelBtn = document.getElementById('btn-cancel-crop');
    const cropApplyBtn = document.getElementById('btn-apply-crop');
    const cropResetBtn = document.getElementById('btn-crop-reset');

    function closeCropModal() {
      cropModal?.classList.add('hidden');
      cropActiveAnnot = null;
      cropIsNewImage = false;
    }

    cropCloseBtn?.addEventListener('click', closeCropModal);
    cropCancelBtn?.addEventListener('click', closeCropModal);

    function openCropModalForAnnotation(annot, isNew = false) {
      if (!annot || !annot.src) return;
      cropActiveAnnot = annot;
      cropIsNewImage = isNew;
      cropOriginalSrc = annot.src;
      cropCurrentSrc = annot.src;
      cropActiveRatio = 'free';
      cropIsRatioLocked = true;

      // Reset aspect ratio buttons
      document.querySelectorAll('.crop-ratio-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.ratio === 'free');
      });

      const lockIcon = document.getElementById('crop-ratio-lock-icon');
      if (lockIcon) lockIcon.textContent = '🔒 Proportional';

      // Load image into crop frame
      cropImg.onload = () => {
        setupCropBoxInitial();
      };
      cropImg.src = cropCurrentSrc;
      cropModal?.classList.remove('hidden');
    }

    function setupCropBoxInitial() {
      const rW = cropImg.clientWidth || 300;
      const rH = cropImg.clientHeight || 200;
      const marginX = Math.max(10, Math.round(rW * 0.05));
      const marginY = Math.max(10, Math.round(rH * 0.05));
      cropBoxState = {
        x: marginX,
        y: marginY,
        w: Math.max(40, rW - marginX * 2),
        h: Math.max(30, rH - marginY * 2),
      };

      if (cropInputW && cropInputH) {
        cropInputW.value = Math.round(cropActiveAnnot.width || 200);
        const ratio = cropBoxState.h / (cropBoxState.w || 1);
        cropInputH.value = Math.round(cropActiveAnnot.height || Math.round(cropActiveAnnot.width * ratio));
      }

      updateCropBoxDOM();
    }

    function updateCropBoxDOM() {
      if (!cropBox || !cropImg) return;
      const rW = cropImg.clientWidth || 1;
      const rH = cropImg.clientHeight || 1;

      cropBoxState.x = Math.max(0, Math.min(rW - cropBoxState.w, cropBoxState.x));
      cropBoxState.y = Math.max(0, Math.min(rH - cropBoxState.h, cropBoxState.y));
      cropBoxState.w = Math.max(20, Math.min(rW - cropBoxState.x, cropBoxState.w));
      cropBoxState.h = Math.max(20, Math.min(rH - cropBoxState.y, cropBoxState.h));

      cropBox.style.left = cropBoxState.x + 'px';
      cropBox.style.top = cropBoxState.y + 'px';
      cropBox.style.width = cropBoxState.w + 'px';
      cropBox.style.height = cropBoxState.h + 'px';

      const scaleX = cropImg.naturalWidth / rW;
      const scaleY = cropImg.naturalHeight / rH;
      const naturalW = Math.round(cropBoxState.w * scaleX);
      const naturalH = Math.round(cropBoxState.h * scaleY);

      if (cropBadge) cropBadge.textContent = `${naturalW} × ${naturalH} px`;
      if (cropOutDim) {
        const outW = cropInputW ? cropInputW.value : naturalW;
        const outH = cropInputH ? cropInputH.value : naturalH;
        cropOutDim.textContent = `${outW} × ${outH} px`;
      }
    }

    // Drag crop box
    let isDraggingCropBox = false;
    let dragStartX = 0, dragStartY = 0;
    let dragInitBoxX = 0, dragInitBoxY = 0;

    cropBox?.addEventListener('mousedown', (e) => {
      if (e.target.classList.contains('crop-handle') || e.target.closest('.crop-handle')) return;
      isDraggingCropBox = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragInitBoxX = cropBoxState.x;
      dragInitBoxY = cropBoxState.y;
      e.preventDefault();
      e.stopPropagation();

      function onMove(ev) {
        if (!isDraggingCropBox) return;
        const dx = ev.clientX - dragStartX;
        const dy = ev.clientY - dragStartY;
        const rW = cropImg.clientWidth;
        const rH = cropImg.clientHeight;
        cropBoxState.x = Math.max(0, Math.min(rW - cropBoxState.w, dragInitBoxX + dx));
        cropBoxState.y = Math.max(0, Math.min(rH - cropBoxState.h, dragInitBoxY + dy));
        updateCropBoxDOM();
      }

      function onUp() {
        isDraggingCropBox = false;
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
      }

      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });

    // Resize crop handles
    document.querySelectorAll('.crop-handle').forEach(handle => {
      handle.addEventListener('mousedown', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const handleType = handle.dataset.handle;
        const startX = e.clientX;
        const startY = e.clientY;
        const initBox = { ...cropBoxState };
        const rW = cropImg.clientWidth;
        const rH = cropImg.clientHeight;

        function onHandleMove(ev) {
          const dx = ev.clientX - startX;
          const dy = ev.clientY - startY;

          let newX = initBox.x;
          let newY = initBox.y;
          let newW = initBox.w;
          let newH = initBox.h;

          if (handleType.includes('e')) newW = Math.max(20, Math.min(rW - initBox.x, initBox.w + dx));
          if (handleType.includes('s')) newH = Math.max(20, Math.min(rH - initBox.y, initBox.h + dy));
          if (handleType.includes('w')) {
            const rawW = initBox.w - dx;
            newW = Math.max(20, Math.min(initBox.x + initBox.w, rawW));
            newX = initBox.x + (initBox.w - newW);
          }
          if (handleType.includes('n')) {
            const rawH = initBox.h - dy;
            newH = Math.max(20, Math.min(initBox.y + initBox.h, rawH));
            newY = initBox.y + (initBox.h - newH);
          }

          if (cropActiveRatio !== 'free') {
            let targetRatio = 1;
            if (cropActiveRatio === '1:1') targetRatio = 1;
            else if (cropActiveRatio === '4:3') targetRatio = 4 / 3;
            else if (cropActiveRatio === '16:9') targetRatio = 16 / 9;
            else if (cropActiveRatio === '3:2') targetRatio = 3 / 2;
            else if (cropActiveRatio === 'orig') targetRatio = cropImg.naturalWidth / (cropImg.naturalHeight || 1);

            if (handleType === 'e' || handleType === 'w') {
              newH = Math.round(newW / targetRatio);
            } else {
              newW = Math.round(newH * targetRatio);
            }
          }

          cropBoxState = { x: newX, y: newY, w: newW, h: newH };
          updateCropBoxDOM();

          if (cropInputW && cropInputH && cropIsRatioLocked) {
            const ratio = cropBoxState.h / cropBoxState.w;
            cropInputH.value = Math.round((parseInt(cropInputW.value) || 200) * ratio);
          }
        }

        function onHandleUp() {
          document.removeEventListener('mousemove', onHandleMove);
          document.removeEventListener('mouseup', onHandleUp);
        }

        document.addEventListener('mousemove', onHandleMove);
        document.addEventListener('mouseup', onHandleUp);
      });
    });

    // Aspect Ratio Preset buttons
    document.querySelectorAll('.crop-ratio-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.crop-ratio-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        cropActiveRatio = btn.dataset.ratio;

        if (cropActiveRatio !== 'free') {
          let ratio = 1;
          if (cropActiveRatio === '1:1') ratio = 1;
          else if (cropActiveRatio === '4:3') ratio = 4 / 3;
          else if (cropActiveRatio === '16:9') ratio = 16 / 9;
          else if (cropActiveRatio === '3:2') ratio = 3 / 2;
          else if (cropActiveRatio === 'orig') ratio = cropImg.naturalWidth / (cropImg.naturalHeight || 1);

          const rW = cropImg.clientWidth;
          const rH = cropImg.clientHeight;
          let newW = cropBoxState.w;
          let newH = Math.round(newW / ratio);

          if (newH > rH) {
            newH = rH - 20;
            newW = Math.round(newH * ratio);
          }
          if (newW > rW) {
            newW = rW - 20;
            newH = Math.round(newW / ratio);
          }

          const centerX = cropBoxState.x + cropBoxState.w / 2;
          const centerY = cropBoxState.y + cropBoxState.h / 2;
          cropBoxState.w = Math.max(30, Math.round(newW));
          cropBoxState.h = Math.max(30, Math.round(newH));
          cropBoxState.x = Math.max(0, Math.min(rW - cropBoxState.w, Math.round(centerX - cropBoxState.w / 2)));
          cropBoxState.y = Math.max(0, Math.min(rH - cropBoxState.h, Math.round(centerY - cropBoxState.h / 2)));

          updateCropBoxDOM();

          if (cropInputW && cropInputH && cropIsRatioLocked) {
            cropInputH.value = Math.round((parseInt(cropInputW.value) || 200) / ratio);
          }
        }
      });
    });

    // Toggle aspect ratio lock in modal
    document.getElementById('btn-toggle-crop-ratio-lock')?.addEventListener('click', () => {
      cropIsRatioLocked = !cropIsRatioLocked;
      const icon = document.getElementById('crop-ratio-lock-icon');
      if (icon) icon.textContent = cropIsRatioLocked ? '🔒 Proportional' : '🔓 Free Ratio';
    });

    // Dimension Inputs in modal
    cropInputW?.addEventListener('input', (e) => {
      const w = parseInt(e.target.value);
      if (w > 0 && cropIsRatioLocked && cropInputH && cropBoxState.w > 0) {
        const ratio = cropBoxState.h / cropBoxState.w;
        cropInputH.value = Math.round(w * ratio);
      }
      updateCropBoxDOM();
    });

    cropInputH?.addEventListener('input', (e) => {
      const h = parseInt(e.target.value);
      if (h > 0 && cropIsRatioLocked && cropInputW && cropBoxState.h > 0) {
        const ratio = cropBoxState.w / cropBoxState.h;
        cropInputW.value = Math.round(h * ratio);
      }
      updateCropBoxDOM();
    });

    // Scale Presets in modal
    document.querySelectorAll('.crop-scale-preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const factor = parseFloat(btn.dataset.scale);
        if (!factor || !cropInputW || !cropInputH) return;
        const baseW = Math.round(cropActiveAnnot.width || 200);
        const baseH = Math.round(cropActiveAnnot.height || 150);
        cropInputW.value = Math.round(baseW * factor);
        cropInputH.value = Math.round(baseH * factor);
        updateCropBoxDOM();
      });
    });

    // Rotate & Flip image in modal via offscreen canvas
    function transformModalImage(operation) {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      const img = new Image();
      img.onload = () => {
        if (operation === 'rotate-cw') {
          canvas.width = img.height;
          canvas.height = img.width;
          ctx.translate(canvas.width / 2, canvas.height / 2);
          ctx.rotate((90 * Math.PI) / 180);
          ctx.drawImage(img, -img.width / 2, -img.height / 2);
        } else if (operation === 'rotate-ccw') {
          canvas.width = img.height;
          canvas.height = img.width;
          ctx.translate(canvas.width / 2, canvas.height / 2);
          ctx.rotate((-90 * Math.PI) / 180);
          ctx.drawImage(img, -img.width / 2, -img.height / 2);
        } else if (operation === 'flip-h') {
          canvas.width = img.width;
          canvas.height = img.height;
          ctx.translate(canvas.width, 0);
          ctx.scale(-1, 1);
          ctx.drawImage(img, 0, 0);
        } else if (operation === 'flip-v') {
          canvas.width = img.width;
          canvas.height = img.height;
          ctx.translate(0, canvas.height);
          ctx.scale(1, -1);
          ctx.drawImage(img, 0, 0);
        }
        cropCurrentSrc = canvas.toDataURL('image/png');
        cropImg.onload = () => setupCropBoxInitial();
        cropImg.src = cropCurrentSrc;
      };
      img.src = cropCurrentSrc;
    }

    document.getElementById('btn-crop-rotate-left')?.addEventListener('click', () => transformModalImage('rotate-ccw'));
    document.getElementById('btn-crop-rotate-right')?.addEventListener('click', () => transformModalImage('rotate-cw'));
    document.getElementById('btn-crop-flip-h')?.addEventListener('click', () => transformModalImage('flip-h'));
    document.getElementById('btn-crop-flip-v')?.addEventListener('click', () => transformModalImage('flip-v'));

    cropResetBtn?.addEventListener('click', () => {
      cropCurrentSrc = cropOriginalSrc;
      cropImg.onload = () => setupCropBoxInitial();
      cropImg.src = cropCurrentSrc;
    });

    // Apply Crop
    cropApplyBtn?.addEventListener('click', async () => {
      if (!cropActiveAnnot || !cropImg) return;
      const rW = cropImg.clientWidth || 1;
      const rH = cropImg.clientHeight || 1;
      const scaleX = cropImg.naturalWidth / rW;
      const scaleY = cropImg.naturalHeight / rH;

      const sx = Math.max(0, cropBoxState.x * scaleX);
      const sy = Math.max(0, cropBoxState.y * scaleY);
      const sW = Math.min(cropImg.naturalWidth - sx, cropBoxState.w * scaleX);
      const sH = Math.min(cropImg.naturalHeight - sy, cropBoxState.h * scaleY);

      const outCanvas = document.createElement('canvas');
      outCanvas.width = Math.max(1, Math.round(sW));
      outCanvas.height = Math.max(1, Math.round(sH));
      const outCtx = outCanvas.getContext('2d');
      outCtx.drawImage(cropImg, sx, sy, sW, sH, 0, 0, outCanvas.width, outCanvas.height);

      const croppedDataUrl = outCanvas.toDataURL('image/png');
      const userW = parseInt(cropInputW?.value);
      const userH = parseInt(cropInputH?.value);

      if (cropActiveAnnot.isPdfPage) {
        state.pageCrops[cropActiveAnnot.pageNum] = {
          x: sx,
          y: sy,
          width: sW,
          height: sH,
          croppedSrc: croppedDataUrl,
          newWidth: userW || Math.round(sW / 1.5),
          newHeight: userH || Math.round(sH / 1.5),
        };
        saveHistory();
        await renderCurrentPage();
        closeCropModal();
        return;
      }

      cropActiveAnnot.src = croppedDataUrl;

      if (userW > 0) cropActiveAnnot.width = userW;
      if (userH > 0) cropActiveAnnot.height = userH;

      if (cropIsNewImage) {
        state.annotations[state.currentPage].push(cropActiveAnnot);
      }

      saveHistory();
      renderAnnotationsLayer();
      selectAnnotation(cropActiveAnnot);
      closeCropModal();
    });

    // ==========================================
    // Top Toolbar & Property Bar Image Resizing Controls
    // ==========================================
    async function openCropForCurrentPdfPage() {
      if (!state.pdfDocProxy || !state.totalPages) {
        alert('Please open or upload a PDF document first.');
        return;
      }
      const pageDataUrl = renderCanvas.toDataURL('image/png');
      const dispW = Math.round(parseFloat(renderCanvas.style.width) || (renderCanvas.width / 1.5));
      const dispH = Math.round(parseFloat(renderCanvas.style.height) || (renderCanvas.height / 1.5));
      const pageCropItem = {
        id: 'pdf-page-' + state.currentPage,
        isPdfPage: true,
        pageNum: state.currentPage,
        src: pageDataUrl,
        width: dispW,
        height: dispH,
      };
      openCropModalForAnnotation(pageCropItem);
    }

    document.getElementById('btn-crop-page')?.addEventListener('click', openCropForCurrentPdfPage);
    document.getElementById('btn-floating-crop')?.addEventListener('click', openCropForCurrentPdfPage);
    const cropImageToolBtn = document.getElementById('btn-crop-image-tool');
    cropImageToolBtn?.addEventListener('click', () => {
      const activeList = state.annotations[state.currentPage] || [];
      const selAnnot = activeList.find(a => a.id === state.selectedAnnotationId);
      if (selAnnot && (selAnnot.type === 'image' || selAnnot.type === 'signature' || selAnnot.type === 'stamp')) {
        openCropModalForAnnotation(selAnnot);
        return;
      }
      const anyImg = [...activeList].reverse().find(a => a.type === 'image' || a.type === 'signature' || a.type === 'stamp');
      if (anyImg) {
        selectAnnotation(anyImg);
        openCropModalForAnnotation(anyImg);
        return;
      }
      imageInput?.click();
    });

    const propCropBtn = document.getElementById('btn-prop-crop-modal');
    propCropBtn?.addEventListener('click', () => {
      const activeList = state.annotations[state.currentPage] || [];
      const selAnnot = activeList.find(a => a.id === state.selectedAnnotationId);
      if (selAnnot) openCropModalForAnnotation(selAnnot);
    });

    let isPropImgLocked = true;
    const propImgLockBtn = document.getElementById('btn-prop-img-lock');
    const propImgLockIcon = document.getElementById('prop-img-lock-icon');
    propImgLockBtn?.addEventListener('click', () => {
      isPropImgLocked = !isPropImgLocked;
      if (propImgLockIcon) propImgLockIcon.textContent = isPropImgLocked ? '🔒' : '🔓';
      propImgLockBtn.classList.toggle('border-blue-500', isPropImgLocked);
    });

    const propWInput = document.getElementById('prop-img-w');
    const propHInput = document.getElementById('prop-img-h');

    function updateImgDimensions(w, h, save = true) {
      const activeList = state.annotations[state.currentPage] || [];
      const selAnnot = activeList.find(a => a.id === state.selectedAnnotationId);
      if (!selAnnot) return;
      selAnnot.width = Math.max(20, Math.round(w));
      selAnnot.height = Math.max(20, Math.round(h));
      const el = document.getElementById('annot-' + selAnnot.id);
      if (el) {
        const img = el.querySelector('img');
        if (img) {
          img.style.width = selAnnot.width + 'px';
          img.style.height = selAnnot.height + 'px';
        }
      }
      if (save) saveHistory();
    }

    propWInput?.addEventListener('input', (e) => {
      const newW = parseFloat(e.target.value);
      if (!newW || isNaN(newW)) return;
      const activeList = state.annotations[state.currentPage] || [];
      const selAnnot = activeList.find(a => a.id === state.selectedAnnotationId);
      if (!selAnnot) return;
      let newH = selAnnot.height;
      if (isPropImgLocked && selAnnot.width > 0) {
        const ratio = selAnnot.height / selAnnot.width;
        newH = Math.round(newW * ratio);
        if (propHInput) propHInput.value = newH;
      }
      updateImgDimensions(newW, newH, false);
    });
    propWInput?.addEventListener('change', () => saveHistory());

    propHInput?.addEventListener('input', (e) => {
      const newH = parseFloat(e.target.value);
      if (!newH || isNaN(newH)) return;
      const activeList = state.annotations[state.currentPage] || [];
      const selAnnot = activeList.find(a => a.id === state.selectedAnnotationId);
      if (!selAnnot) return;
      let newW = selAnnot.width;
      if (isPropImgLocked && selAnnot.height > 0) {
        const ratio = selAnnot.width / selAnnot.height;
        newW = Math.round(newH * ratio);
        if (propWInput) propWInput.value = newW;
      }
      updateImgDimensions(newW, newH, false);
    });
    propHInput?.addEventListener('change', () => saveHistory());

    document.querySelectorAll('.btn-quick-scale').forEach(btn => {
      btn.addEventListener('click', () => {
        const scale = parseFloat(btn.dataset.scale);
        const activeList = state.annotations[state.currentPage] || [];
        const selAnnot = activeList.find(a => a.id === state.selectedAnnotationId);
        if (!selAnnot || !scale) return;
        const newW = Math.round(selAnnot.width * scale);
        const newH = Math.round(selAnnot.height * scale);
        if (propWInput) propWInput.value = newW;
        if (propHInput) propHInput.value = newH;
        updateImgDimensions(newW, newH, true);
      });
    });

    // Watermark & Page Numbering Modal Logic
    const wmModal = document.getElementById('watermark-modal');
    const openWmBtn = document.getElementById('btn-open-watermark-modal');
    const closeWmBtn = document.getElementById('btn-close-watermark-modal');
    const tabWm = document.getElementById('watermark-tab-wm');
    const tabPg = document.getElementById('watermark-tab-pg');
    const paneWm = document.getElementById('watermark-pane-wm');
    const panePg = document.getElementById('watermark-pane-pg');
    const applyWmBtn = document.getElementById('btn-apply-watermark');
    const applyPgBtn = document.getElementById('btn-apply-pagenumbers');
    const wmOpacitySlider = document.getElementById('wm-opacity-slider');
    const wmOpacityLabel = document.getElementById('wm-opacity-label');

    function switchWatermarkTab(tab) {
      if (tab === 'wm') {
        if (tabWm) tabWm.className = 'flex-1 rounded-sm py-1.5 text-center bg-canvas-elevated text-ink shadow-whisper font-semibold cursor-pointer';
        if (tabPg) tabPg.className = 'flex-1 rounded-sm py-1.5 text-center text-body hover:text-ink cursor-pointer';
        paneWm?.classList.remove('hidden');
        panePg?.classList.add('hidden');
      } else {
        if (tabPg) tabPg.className = 'flex-1 rounded-sm py-1.5 text-center bg-canvas-elevated text-ink shadow-whisper font-semibold cursor-pointer';
        if (tabWm) tabWm.className = 'flex-1 rounded-sm py-1.5 text-center text-body hover:text-ink cursor-pointer';
        panePg?.classList.remove('hidden');
        paneWm?.classList.add('hidden');
      }
    }

    tabWm?.addEventListener('click', () => switchWatermarkTab('wm'));
    tabPg?.addEventListener('click', () => switchWatermarkTab('pg'));

    openWmBtn?.addEventListener('click', () => {
      wmModal?.classList.remove('hidden');
      switchWatermarkTab('wm');
    });
    closeWmBtn?.addEventListener('click', () => wmModal?.classList.add('hidden'));

    wmOpacitySlider?.addEventListener('input', (e) => {
      if (wmOpacityLabel) {
        wmOpacityLabel.textContent = Math.round(parseFloat(e.target.value) * 100) + '%';
      }
    });

    // Apply Watermark to All Pages
    applyWmBtn?.addEventListener('click', () => {
      if (!state.totalPages) {
        alert('Please open a PDF document first.');
        return;
      }
      const text = document.getElementById('wm-text-input')?.value || 'CONFIDENTIAL';
      const opacity = parseFloat(document.getElementById('wm-opacity-slider')?.value) || 0.2;
      const color = document.getElementById('wm-color-picker')?.value || '#ff0000';

      for (let p = 1; p <= state.totalPages; p++) {
        if (!state.annotations[p]) state.annotations[p] = [];
        state.annotations[p].push({
          id: 'wm-' + p + '-' + Date.now(),
          type: 'text',
          text: text,
          x: 100,
          y: 260,
          fontSize: 48,
          color: color,
          opacity: opacity,
          zIndex: '15',
        });
      }
      saveHistory();
      renderAnnotationsLayer();
      wmModal?.classList.add('hidden');
    });

    // Apply Page Numbers to All Pages
    applyPgBtn?.addEventListener('click', () => {
      if (!state.totalPages) {
        alert('Please open a PDF document first.');
        return;
      }
      const format = document.getElementById('pg-format-select')?.value || 'Page {n} of {total}';
      const position = document.getElementById('pg-position-select')?.value || 'bottom-center';

      const displayW = renderCanvas.width / 1.5 || 600;
      const displayH = renderCanvas.height / 1.5 || 800;

      for (let p = 1; p <= state.totalPages; p++) {
        if (!state.annotations[p]) state.annotations[p] = [];
        let text = format.replace('{n}', p).replace('{total}', state.totalPages);
        let posX = Math.round(displayW / 2 - 40);
        let posY = Math.round(displayH - 35);

        if (position === 'bottom-right') {
          posX = Math.round(displayW - 120);
          posY = Math.round(displayH - 35);
        } else if (position === 'bottom-left') {
          posX = 40;
          posY = Math.round(displayH - 35);
        } else if (position === 'top-right') {
          posX = Math.round(displayW - 120);
          posY = 30;
        }

        state.annotations[p].push({
          id: 'pgnum-' + p + '-' + Date.now(),
          type: 'text',
          text: text,
          x: Math.max(20, posX),
          y: Math.max(20, posY),
          fontSize: 12,
          color: '#4d4d4d',
          fontFamily: 'Geist Mono, monospace',
          zIndex: '15',
        });
      }
      saveHistory();
      renderAnnotationsLayer();
      wmModal?.classList.add('hidden');
    });

    // Sidebar Toggle
    const sidebar = document.getElementById('thumbnail-sidebar');
    const toggleSidebarBtn = document.getElementById('btn-toggle-sidebar');
    const collapseSidebarBtn = document.getElementById('btn-collapse-sidebar');

    toggleSidebarBtn?.addEventListener('click', () => sidebar?.classList.toggle('hidden'));
    collapseSidebarBtn?.addEventListener('click', () => sidebar?.classList.add('hidden'));

    // Insert Blank Page Handler
    async function insertBlankPage() {
      showLoading('Inserting Blank Page...');
      try {
        const { PDFDocument } = window.PDFLib;
        if (!state.pdfBytes) {
          // No document open yet: create a fresh 1-page blank PDF
          const newDoc = await PDFDocument.create();
          newDoc.addPage([595, 842]); // Standard A4
          const newBytes = await newDoc.save();
          await loadPdfBuffer(newBytes.buffer);
          return;
        }

        const srcDoc = await PDFDocument.load(state.pdfBytes);
        let pageW = 595, pageH = 842;
        const curIdx = Math.max(0, Math.min(srcDoc.getPageCount() - 1, (state.currentPage || 1) - 1));
        try {
          const curPage = srcDoc.getPage(curIdx);
          const size = curPage.getSize();
          pageW = size.width;
          pageH = size.height;
        } catch (e) {}

        const targetInsertIdx = Math.min(srcDoc.getPageCount(), (state.currentPage || 1));
        srcDoc.insertPage(targetInsertIdx, [pageW, pageH]);
        const newBytes = await srcDoc.save();

        // Shift annotations and rotations for all subsequent pages
        const oldAnnotations = { ...state.annotations };
        const oldRotations = { ...state.pageRotations };
        const newAnnotations = {};
        const newRotations = {};
        const newTotal = srcDoc.getPageCount();

        for (let p = 1; p <= newTotal; p++) {
          if (p <= targetInsertIdx) {
            newAnnotations[p] = oldAnnotations[p] || [];
            newRotations[p] = oldRotations[p] || 0;
          } else if (p === targetInsertIdx + 1) {
            newAnnotations[p] = [];
            newRotations[p] = 0;
          } else {
            newAnnotations[p] = oldAnnotations[p - 1] || [];
            newRotations[p] = oldRotations[p - 1] || 0;
          }
        }

        state.pdfBytes = newBytes.slice();
        const loadingTask = window.pdfjsLib.getDocument({ data: state.pdfBytes.slice() });
        state.pdfDocProxy = await loadingTask.promise;
        state.totalPages = state.pdfDocProxy.numPages;
        state.currentPage = targetInsertIdx + 1;
        state.annotations = newAnnotations;
        state.pageRotations = newRotations;

        sidebarCount.textContent = state.totalPages;
        totPageSpan.textContent = state.totalPages;
        saveHistory();
        await renderThumbnails();
        await renderCurrentPage();
      } catch (err) {
        console.error('Failed to insert blank page:', err);
        alert('Failed to insert blank page: ' + err.message);
      } finally {
        hideLoading();
      }
    }

    document.getElementById('btn-add-blank-page')?.addEventListener('click', insertBlankPage);

    // Append from PDF Handler
    const appendPdfInput = document.getElementById('append-pdf-input');
    appendPdfInput?.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      e.target.value = ''; // Reset input so same file can be selected again

      if (!state.pdfBytes) {
        const buffer = await file.arrayBuffer();
        await loadPdfBuffer(buffer);
        return;
      }

      showLoading('Appending pages from PDF...');
      try {
        const { PDFDocument } = window.PDFLib;
        const baseDoc = await PDFDocument.load(state.pdfBytes);
        const appendBuffer = await file.arrayBuffer();
        const appendDoc = await PDFDocument.load(appendBuffer);

        const appendIndices = appendDoc.getPageIndices();
        const copiedPages = await baseDoc.copyPages(appendDoc, appendIndices);
        for (const page of copiedPages) {
          baseDoc.addPage(page);
        }

        const newBytes = await baseDoc.save();
        const prevTotal = state.totalPages;
        const oldAnnotations = { ...state.annotations };
        const oldRotations = { ...state.pageRotations };

        state.pdfBytes = newBytes.slice();
        const loadingTask = window.pdfjsLib.getDocument({ data: state.pdfBytes.slice() });
        state.pdfDocProxy = await loadingTask.promise;
        state.totalPages = state.pdfDocProxy.numPages;

        for (let p = 1; p <= state.totalPages; p++) {
          if (p <= prevTotal) {
            state.annotations[p] = oldAnnotations[p] || [];
            state.pageRotations[p] = oldRotations[p] || 0;
          } else {
            state.annotations[p] = [];
            state.pageRotations[p] = 0;
          }
        }

        sidebarCount.textContent = state.totalPages;
        totPageSpan.textContent = state.totalPages;
        saveHistory();
        await renderThumbnails();
        await renderCurrentPage();
      } catch (err) {
        console.error('Failed to append PDF:', err);
        alert('Failed to append PDF: ' + err.message);
      } finally {
        hideLoading();
      }
    });

    // Delete selected element button
    document.getElementById('btn-delete-element')?.addEventListener('click', () => {
      if (state.selectedAnnotationId) {
        deleteAnnotation(state.selectedAnnotationId);
      }
    });
  });
</script>
