---
// PdfEditor.astro - Master Interactive Studio
import EditorToolbar from './EditorToolbar.astro';
import ThumbnailSidebar from './ThumbnailSidebar.astro';
import SignatureModal from './SignatureModal.astro';
import StampModal from './StampModal.astro';
import WatermarkModal from './WatermarkModal.astro';
import ImageCropModal from './ImageCropModal.astro';
import ExportCompleteModal from '../common/ExportCompleteModal.astro';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';

interface Props {
  t?: (key: string) => string;
}
const { t: tProp } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
const t = tProp ?? useTranslations(lang);

// Pre-resolve all strings used inside the inline script
const editorStrings = {
  uploadHeading: t('editor.uploadHeading'),
  uploadBlurb: t('editor.uploadBlurb'),
  choosePdf: t('editor.choosePdf'),
  trySample: t('editor.trySample'),
  noSizeLimit: t('editor.noSizeLimit'),
  noUploads: t('editor.noUploads'),
  previousPage: t('editor.previousPage'),
  nextPage: t('editor.nextPage'),
  pageLabel: t('editor.pageLabel'),
  ofLabel: t('editor.ofLabel'),
  rotate: t('editor.rotate'),
  cropPage: t('editor.cropPage'),
  crop: t('editor.crop'),
  resetPage: t('editor.resetPage'),
  reset: t('editor.reset'),
  processingDoc: t('editor.processingDoc'),
  rendering: t('editor.rendering'),
  renderingPage: t('editor.renderingPage'),
  confirmTitle: t('editor.confirmTitle'),
  confirmMessage: t('editor.confirmMessage'),
  confirmSubtext: t('editor.confirmSubtext'),
  cancel: t('editor.cancel'),
  confirm: t('editor.confirm'),
  noDocLoaded: t('editor.noDocLoaded'),
  pageNoChanges: t('editor.pageNoChanges'),
  changesReset: t('editor.changesReset'),
  resetTitle: t('editor.resetTitle'),
  resetMessage: t('editor.resetMessage'),
  resetSubtext: t('editor.resetSubtext'),
  resetConfirm: t('editor.resetConfirm'),
  resetAllTitle: t('editor.resetAllTitle'),
  resetAllMessage: t('editor.resetAllMessage'),
  resetAllSubtext: t('editor.resetAllSubtext'),
  resetAllConfirm: t('editor.resetAllConfirm'),
  resetAllSuccess: t('editor.resetAllSuccess'),
  allClean: t('editor.allClean'),
  newSessionTitle: t('editor.newSessionTitle'),
  newSessionMessage: t('editor.newSessionMessage'),
  newSessionSubtext: t('editor.newSessionSubtext'),
  newSessionConfirm: t('editor.newSessionConfirm'),
  newSessionStarted: t('editor.newSessionStarted'),
  loadPdfFirst: t('editor.loadPdfFirst'),
  actionUndone: t('editor.actionUndone'),
  actionRedone: t('editor.actionRedone'),
  loadFailed: t('editor.loadFailed'),
  reorderFailed: t('editor.reorderFailed'),
  deleteFailed: t('editor.deleteFailed'),
  deletePageConfirm: t('editor.deletePageConfirm'),
  onlyPageDelete: t('editor.onlyPageDelete'),
  movingPage: t('editor.movingPage'),
  deletingPage: t('editor.deletingPage'),
  annotation: t('editor.annotation'),
  annotations: t('editor.annotations'),
  rotation: t('editor.rotation'),
  cropResize: t('editor.cropResize'),
  rotatedPage: t('editor.rotatedPage'),
  rotatedPages: t('editor.rotatedPages'),
  cropNoun: t('editor.cropNoun'),
  cropsNoun: t('editor.cropsNoun'),
  page: t('editor.page'),
  redactText: t('editor.redactText'),
  typeTextPlaceholder: t('editor.typeTextPlaceholder'),
  dropPdf: t('editor.dropPdf'),
  addTextAlert: t('editor.addTextAlert'),
  addShapeAlert: t('editor.addShapeAlert'),
  addRedactAlert: t('editor.addRedactAlert'),
  redactType: t('editor.redactType'),
  redactBadge: t('toolbar.redactBadge'),
  redactNotice: t('toolbar.redactNotice'),
  underText: t('editor.underText'),
  overText: t('editor.overText'),
  freehandPen: t('editor.freehandPen'),
  highlighter: t('editor.highlighter'),
  lockProportional: t('crop.lockProportional'),
  unlockFree: t('crop.unlockFree'),
};
---

<div id="editor-anchor" class="w-full relative flex flex-col transition-all duration-300">
  
  <!-- PRE-LOAD (!pdfDoc): Centered, High-Contrast Dropzone View Above the Fold -->
  <div id="editor-dropzone-view" class="w-full flex flex-col items-center justify-center py-4 sm:py-8 transition-all duration-300">
    <div
      id="editor-dropzone-card"
      class="relative w-full max-w-2xl mx-auto rounded-3xl border-2 border-dashed border-hairline bg-canvas-elevated/95 backdrop-blur-2xl p-6 xs:p-8 sm:p-12 text-center shadow-floating transition-all duration-300 cursor-pointer group hover:border-blue-500/60 dark:hover:border-cyan-400/60 hover:shadow-glow-cyan hover:scale-[1.008]"
    >
      <!-- Empty state container anchor -->
      <div id="editor-empty-state" class="w-full flex flex-col items-center justify-center">
        <!-- Animated Icon Container with Ambient Radial Glow -->
        <div class="relative mb-5 sm:mb-6">
          <div class="absolute -inset-2 rounded-full bg-gradient-to-tr from-cyan-500/20 via-blue-600/20 to-indigo-600/20 blur-md group-hover:scale-115 transition-transform duration-300"></div>
          <div class="relative h-16 w-16 sm:h-20 sm:w-20 rounded-2xl bg-gradient-to-br from-canvas-elevated to-canvas flex items-center justify-center border border-hairline shadow-whisper group-hover:scale-105 transition-transform duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 sm:h-10 sm:w-10 text-blue-600 dark:text-cyan-400 transition-transform duration-300 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
          </div>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink mb-2">{editorStrings.uploadHeading}</h3>
        <p class="text-[13px] sm:text-[14px] text-body mb-6 sm:mb-8 max-w-md leading-relaxed">
          {editorStrings.uploadBlurb}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
          <label class="w-full sm:w-auto cursor-pointer inline-flex h-12 items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 px-7 text-[14px] font-semibold text-white shadow-floating hover:shadow-glow-primary hover:opacity-95 active:scale-95 transition-all duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            <span>{editorStrings.choosePdf}</span>
            <input type="file" id="main-pdf-input" accept="application/pdf,.pdf,image/*" class="hidden" />
          </label>

          <button id="btn-load-sample" type="button" class="w-full sm:w-auto inline-flex h-12 items-center justify-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-6 text-[14px] font-medium text-ink hover:bg-hairline-soft transition-all duration-200 shadow-whisper active:scale-95 cursor-pointer">
            <span>✨ {editorStrings.trySample}</span>
          </button>
        </div>

        <!-- Drag & Clipboard Paste Micro-Hint -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-[12px] text-mute">
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-hairline-soft font-mono text-[11px] text-body border border-hairline/80 shadow-2xs">Ctrl+V / ⌘V</span>
          <span>Paste directly from clipboard or drag & drop PDF / image</span>
        </div>

        <!-- Privacy & Specs Footnote -->
        <div class="mt-6 sm:mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-[11px] sm:text-[12px] font-mono text-mute pt-5 sm:pt-6 border-t border-hairline/60 w-full">
          <span class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-medium">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            {editorStrings.noSizeLimit}
          </span>
          <span class="text-hairline">•</span>
          <span class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-medium">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            {editorStrings.noUploads}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- POST-LOAD (pdfDoc loaded): Full Studio Workspace View -->
  <div id="editor-studio-view" class="w-full hidden flex-col bg-canvas rounded-2xl border border-hairline shadow-floating overflow-hidden transition-all duration-300">
    <!-- Top Editor Toolbar (4 Mode Tabs & Subtoolbars) -->
    <EditorToolbar t={t} />

    <!-- Main Editor Workspace (Sidebar + Canvas Viewport) -->
    <div id="editor-workspace-container" class="relative flex min-h-[calc(100vh-56px)] w-full overflow-hidden bg-canvas-workspace">
      <!-- Page Thumbnail Sidebar -->
      <ThumbnailSidebar />

      <!-- Canvas Scrollable Viewport -->
      <div id="canvas-viewport" class="relative flex-1 min-w-0 w-full max-w-full overflow-auto p-3 sm:p-6 md:p-8 flex flex-col items-center justify-start touch-scroll">
        <!-- Active PDF Page Wrapper (Shown when PDF is loaded) -->
        <div id="pdf-page-container" class="relative hidden bg-white shadow-floating border border-hairline rounded-md transition-transform origin-top ring-1 ring-black/5 dark:ring-white/10 max-w-full">
          <!-- PDF.js Underlay Canvas (Renders original PDF page) -->
          <canvas id="pdf-render-canvas" class="block rounded-md max-w-full h-auto"></canvas>

          <!-- Detected Text Runs Interactive Overlay Layer (When in Text Mode) -->
          <div id="pdf-text-detect-layer" class="absolute inset-0 z-22 pointer-events-none hidden overflow-hidden"></div>

          <!-- Freehand Drawing Canvas Layer -->
          <canvas id="pdf-draw-canvas" class="absolute inset-0 z-10 touch-none pointer-events-none"></canvas>

          <!-- Interactive Annotations Container (Text, Shapes, Signatures, Stamps, Redactions) -->
          <div id="pdf-annotations-layer" class="absolute inset-0 z-20 overflow-visible"></div>

          <!-- Floating Contextual Popover Pill (Positions 12px dynamically above selected canvas element) -->
          <div
            id="element-popover-pill"
            class="absolute z-40 hidden items-center gap-1.5 rounded-2xl bg-canvas-elevated/95 backdrop-blur-xl border border-hairline/90 p-1.5 shadow-floating text-ink text-[12px] select-none transition-all duration-75 pointer-events-auto ring-1 ring-black/5 dark:ring-white/10"
            style="will-change: left, top;"
          >
            <!-- Element Type Badge -->
            <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-hairline-soft font-mono text-[10px] text-mute font-semibold tracking-wider uppercase shrink-0">
              <span class="h-1.5 w-1.5 rounded-full bg-blue-500 animate-pulse"></span>
              <span id="inspector-element-type">ELEMENT</span>
            </div>

            <div class="h-4 w-px bg-hairline/80 mx-0.5 shrink-0"></div>

            <!-- Font Family & Font Size (Text / Watermark) -->
            <div id="prop-font-group" class="flex items-center gap-1 shrink-0">
              <select id="prop-font-family" class="h-7 rounded-lg border border-hairline bg-canvas px-1.5 text-[11px] font-medium text-ink focus:outline-none focus:ring-1 focus:ring-blue-500 cursor-pointer" title="Font Family">
                <option value="Geist, sans-serif">Geist</option>
                <option value="Geist Mono, monospace">Mono</option>
                <option value="Times New Roman, serif">Serif</option>
                <option value="Brush Script MT, cursive">Script</option>
              </select>
              <select id="prop-font-size" class="h-7 rounded-lg border border-hairline bg-canvas px-1 text-[11px] font-mono text-ink focus:outline-none focus:ring-1 focus:ring-blue-500 cursor-pointer" title="Font Size">
                <option value="10">10</option>
                <option value="12">12</option>
                <option value="14">14</option>
                <option value="16" selected>16</option>
                <option value="18">18</option>
                <option value="20">20</option>
                <option value="24">24</option>
                <option value="32">32</option>
                <option value="40">40</option>
                <option value="48">48</option>
              </select>
            </div>

            <!-- Whiteout Background Toggle (Text Only) -->
            <div id="pop-whiteout-group" class="flex items-center shrink-0">
              <button
                id="btn-pop-whiteout"
                type="button"
                class="flex h-7 items-center gap-1 rounded-lg border border-hairline bg-canvas px-2 text-[11px] font-medium text-body hover:bg-hairline-soft hover:text-ink transition-colors cursor-pointer"
                title="Toggle Whiteout Background (solid whiteout mask under text)"
              >
                <span id="pop-whiteout-icon" class="h-3 w-3 rounded-xs border border-hairline/80 bg-white inline-block"></span>
                <span class="hidden sm:inline">Whiteout</span>
              </button>
            </div>

            <!-- Color Swatch & Color Picker -->
            <div id="prop-color-group" class="flex items-center gap-1 shrink-0">
              <label class="relative flex h-6 w-6 shrink-0 cursor-pointer items-center justify-center rounded-full border border-hairline/90 bg-canvas p-0 shadow-2xs hover:scale-110 transition-transform" title="Change Color">
                <input type="color" id="prop-color-picker" value="#171717" class="absolute inset-0 h-full w-full opacity-0 cursor-pointer" />
                <span id="pop-color-indicator" class="h-4.5 w-4.5 rounded-full border border-black/10 dark:border-white/20 bg-[#171717]"></span>
              </label>
            </div>

            <!-- Opacity Control -->
            <div id="prop-opacity-group" class="flex items-center gap-1 px-1 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <input type="range" id="prop-opacity" min="0.1" max="1" step="0.05" value="1" class="h-1.5 w-12 sm:w-16 accent-blue-600 cursor-pointer" title="Opacity" />
              <span id="prop-opacity-val" class="font-mono text-[10px] text-mute min-w-[26px]">100%</span>
            </div>

            <!-- Stroke Width (Shapes) -->
            <div id="prop-stroke-group" class="hidden items-center gap-1 shrink-0">
              <span class="text-mute text-[10px] font-mono">Stroke:</span>
              <input type="range" id="prop-stroke-width" min="1" max="24" value="2" class="h-1.5 w-12 accent-blue-600 cursor-pointer" />
              <span id="prop-stroke-val" class="font-mono text-[10px] text-mute">2px</span>
            </div>

            <!-- Image Resize & Crop Trigger -->
            <div id="prop-image-group" class="hidden items-center gap-1 shrink-0">
              <button
                id="btn-prop-crop-modal"
                type="button"
                class="flex h-7 items-center gap-1 rounded-lg bg-blue-600 hover:bg-blue-700 px-2 text-[11px] font-semibold text-white transition-colors cursor-pointer"
                title="Crop & Resize Image"
              >
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h14a2 2 0 012 2v14M7 3v14a2 2 0 002 2h14" /></svg>
                <span>Crop</span>
              </button>
            </div>

            <!-- Watermark Layer Toggle -->
            <div id="prop-watermark-layer-group" class="hidden items-center gap-1 shrink-0">
              <button
                id="btn-prop-wm-toggle-layer"
                type="button"
                class="flex h-7 items-center gap-1 rounded-lg border border-hairline bg-canvas hover:bg-hairline-soft px-1.5 text-[10px] font-medium text-ink transition-colors cursor-pointer"
                title="Toggle Watermark Under/Over text"
              >
                <span id="prop-wm-layer-text">Under Text</span>
              </button>
            </div>

            <!-- Redact Notice Badge -->
            <div id="prop-redact-group" class="hidden items-center gap-1 shrink-0">
              <span class="inline-flex items-center gap-1 rounded-md bg-rose-500/10 px-2 py-0.5 text-[10px] font-semibold text-rose-600 dark:text-rose-400 border border-rose-500/20">
                <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
                <span>PERMANENT REDACT</span>
              </span>
            </div>

            <div class="h-4 w-px bg-hairline/80 mx-0.5 shrink-0"></div>

            <!-- Layer Forward / Backward Controls -->
            <div id="prop-layer-group" class="flex items-center gap-0.5 shrink-0">
              <button id="btn-layer-forward" type="button" class="flex h-7 w-7 items-center justify-center rounded-lg hover:bg-hairline-soft text-body hover:text-ink transition-colors cursor-pointer" title="Bring Forward">
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
              </button>
              <button id="btn-layer-backward" type="button" class="flex h-7 w-7 items-center justify-center rounded-lg hover:bg-hairline-soft text-body hover:text-ink transition-colors cursor-pointer" title="Send Backward">
                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </button>
            </div>

            <div class="h-4 w-px bg-hairline/80 mx-0.5 shrink-0"></div>

            <!-- Duplicate Element (Ctrl/Cmd + D) -->
            <button
              id="btn-pop-duplicate"
              type="button"
              class="flex h-7 items-center gap-1 rounded-lg px-2 text-[11px] font-medium text-body hover:bg-hairline-soft hover:text-ink transition-colors cursor-pointer shrink-0"
              title="Duplicate (Ctrl+D / ⌘D)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-blue-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
              </svg>
              <span class="hidden sm:inline">Duplicate</span>
            </button>

            <!-- Delete Selected Element (Delete/Backspace) -->
            <button
              id="btn-delete-element"
              type="button"
              class="flex h-7 items-center gap-1 rounded-lg bg-rose-500/10 border border-rose-500/20 px-2 text-[11px] font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-500/20 transition-all cursor-pointer shrink-0"
              title="Delete (Delete / Backspace)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              <span>Delete</span>
            </button>
          </div>
        </div>

        <!-- Floating Page Navigation Pill (Bottom of Canvas) -->
        <div id="floating-page-nav" class="sticky bottom-3 sm:bottom-6 mt-4 sm:mt-6 z-30 hidden items-center gap-1.5 sm:gap-3 rounded-full glass-dock px-3 sm:px-4 py-1.5 sm:py-2 text-[12px] sm:text-[13px] max-w-[calc(100vw-32px)] flex-wrap justify-center shadow-floating">
          <button id="btn-prev-page" class="flex h-7 w-7 items-center justify-center rounded-full hover:bg-hairline-soft text-body hover:text-ink disabled:opacity-30 transition-colors" title={editorStrings.previousPage}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <span class="font-mono text-[11px] sm:text-[12px] font-semibold text-ink px-1">
            {editorStrings.pageLabel} <span id="current-page-num" class="text-blue-600 dark:text-cyan-400">1</span> {editorStrings.ofLabel} <span id="total-page-num">1</span>
          </span>
          <button id="btn-next-page" class="flex h-7 w-7 items-center justify-center rounded-full hover:bg-hairline-soft text-body hover:text-ink disabled:opacity-30 transition-colors" title={editorStrings.nextPage}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
          <div class="h-4 w-px bg-hairline mx-0.5"></div>
          <button id="btn-floating-rotate" class="flex h-7 items-center gap-1 rounded-full px-2 sm:px-2.5 text-[11px] sm:text-[12px] font-medium text-body hover:bg-hairline-soft hover:text-ink transition-colors cursor-pointer" title={editorStrings.rotate}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span class="hidden xs:inline sm:inline">{editorStrings.rotate}</span>
          </button>
          <button id="btn-floating-crop" class="flex h-7 items-center gap-1 rounded-full px-2 sm:px-2.5 text-[11px] sm:text-[12px] font-medium text-body hover:bg-hairline-soft hover:text-ink transition-colors cursor-pointer" title={editorStrings.cropPage}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-cyan-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h14a2 2 0 012 2v14M7 3v14a2 2 0 002 2h14" />
            </svg>
            <span class="hidden sm:inline">{editorStrings.cropPage}</span>
            <span class="inline sm:hidden">{editorStrings.crop}</span>
          </button>
          <button id="btn-floating-reset-page" class="flex h-7 items-center gap-1 rounded-full px-2 sm:px-2.5 text-[11px] sm:text-[12px] font-medium text-body hover:bg-hairline-soft hover:text-amber-600 dark:hover:text-amber-400 transition-colors cursor-pointer" title={editorStrings.resetPage}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span class="hidden sm:inline">{editorStrings.resetPage}</span>
            <span class="inline sm:hidden">{editorStrings.reset}</span>
          </button>
        </div>

        <!-- Loading Spinner Overlay -->
        <div id="editor-loading" class="absolute inset-0 z-40 flex items-center justify-center bg-canvas/80 backdrop-blur-sm hidden">
          <div class="flex flex-col items-center gap-3 p-6 rounded-2xl glass-panel shadow-floating">
            <div class="h-9 w-9 animate-spin rounded-full border-3 border-blue-600 border-t-transparent"></div>
            <span id="loading-text" class="text-[13px] font-medium text-ink">{editorStrings.processingDoc}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modals -->
  <SignatureModal t={t} />
  <StampModal t={t} />
  <WatermarkModal t={t} />
  <ImageCropModal t={t} />
  <ExportCompleteModal lang={lang} />

  <!-- Action Confirmation Modal (Reset Page, Reset All, New Session) -->
  <div id="confirm-action-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md p-4 hidden">
    <div class="w-full max-w-md rounded-2xl border border-hairline bg-canvas-elevated p-6 shadow-floating animate-fade-in">
      <div class="flex items-start gap-3.5">
        <div id="confirm-modal-icon-wrapper" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400">
          <svg id="confirm-modal-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h3 id="confirm-modal-title" class="text-[16px] font-bold tracking-tight text-ink">{editorStrings.confirmTitle}</h3>
          <p id="confirm-modal-message" class="mt-1.5 text-[13px] text-body leading-relaxed">
            {editorStrings.confirmMessage}
          </p>
          <p id="confirm-modal-subtext" class="mt-2 text-[11px] text-mute flex items-center gap-1 font-mono">
            <span>💡</span> <span>{editorStrings.confirmSubtext}</span>
          </p>
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-2.5 border-t border-hairline/80 pt-4">
        <button
          id="confirm-modal-btn-cancel"
          type="button"
          class="h-9 px-4 rounded-xl border border-hairline bg-canvas-elevated text-[13px] font-medium text-body hover:bg-hairline-soft hover:text-ink transition-colors cursor-pointer"
        >
          {editorStrings.cancel}
        </button>
        <button
          id="confirm-modal-btn-proceed"
          type="button"
          class="h-9 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-[13px] font-semibold text-white shadow-sm transition-colors cursor-pointer"
        >
          {editorStrings.confirm}
        </button>
      </div>
    </div>
  </div>

  <!-- Floating Toast Notification System -->
  <div id="editor-toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>
</div>

<script id="pdf-editor-strings" type="application/json" set:html={JSON.stringify(editorStrings)} />

<!-- Core Client-Side Logic Script -->
<script>
  import {
    PdfRenderer,
    AnnotationHistoryManager,
    exportPdfWithAnnotations,
    inspectTextAtPoint,
  } from '../../lib/editor';
  import {
    savePdfToSession,
    getPdfFromSession,
    openExportCompleteModal,
  } from '../../lib/pdfSessionStore';

  function initPdfEditor() {
    const stringsEl = document.getElementById('pdf-editor-strings');
    const editorStrings = stringsEl ? JSON.parse(stringsEl.textContent || '{}') : {};

    const historyManager = new AnnotationHistoryManager(50);
    const pdfRenderer = new PdfRenderer();

    // State management
    const state = {
      pdfBytes: null,
      pdfDocProxy: null,
      totalPages: 0,
      currentPage: 1,
      pageRotations: {}, // pageNum -> degrees (0, 90, 180, 270)
      pageCrops: {}, // pageNum -> { x, y, width, height, croppedSrc, newWidth, newHeight }
      annotations: {}, // pageNum -> Array of annotations
      activeTool: 'select', // 'select', 'text', 'draw', 'highlight', 'shape', 'redact'
      activeShape: 'rect',
      scale: 1.0,
      selectedAnnotationId: null,
      isDrawing: false,
      drawPoints: [],
      activeDrawColor: '#171717',
      activeDrawWidth: 2,
      activeDrawOpacity: 1.0,
      activeHighlightColor: '#fef08a',
      activeHighlightWidth: 24,
      activeHighlightOpacity: 0.35,
    };

    // DOM Elements
    const canvasViewport = document.getElementById('canvas-viewport');
    const emptyState = document.getElementById('editor-empty-state');
    const pageContainer = document.getElementById('pdf-page-container');
    const renderCanvas = document.getElementById('pdf-render-canvas');
    const drawCanvas = document.getElementById('pdf-draw-canvas');
    const annotationsLayer = document.getElementById('pdf-annotations-layer');
    const textDetectLayer = document.getElementById('pdf-text-detect-layer');
    const fileInput = document.getElementById('main-pdf-input');
    const appendFileInput = document.getElementById('append-pdf-input');
    const sampleBtn = document.getElementById('btn-load-sample');
    const loadingOverlay = document.getElementById('editor-loading');
    const loadingText = document.getElementById('loading-text');
    const pageNav = document.getElementById('floating-page-nav');
    const curPageSpan = document.getElementById('current-page-num');
    const totPageSpan = document.getElementById('total-page-num');
    const prevPageBtn = document.getElementById('btn-prev-page');
    const nextPageBtn = document.getElementById('btn-next-page');
    const thumbnailsList = document.getElementById('thumbnails-list');
    const sidebarCount = document.getElementById('sidebar-page-count');
    const zoomPct = document.getElementById('zoom-percentage');
    const zoomInBtn = document.getElementById('btn-zoom-in');
    const zoomOutBtn = document.getElementById('btn-zoom-out');
    const propertyBar = document.getElementById('property-bar');
    const popoverPill = document.getElementById('element-popover-pill');
    const btnPopWhiteout = document.getElementById('btn-pop-whiteout');
    const btnPopDuplicate = document.getElementById('btn-pop-duplicate');
    const exportBtn = document.getElementById('btn-export-pdf');
    const undoBtn = document.getElementById('btn-undo');
    const redoBtn = document.getElementById('btn-redo');

    // Prevent interactions inside the popover pill from bubbling to canvas or deselection
    popoverPill?.addEventListener('click', (e) => e.stopPropagation());
    popoverPill?.addEventListener('mousedown', (e) => e.stopPropagation());

    function showLoading(msg = editorStrings.processingDoc) {
      loadingText.textContent = msg;
      loadingOverlay.classList.remove('hidden');
    }

    function hideLoading() {
      loadingOverlay.classList.add('hidden');
    }

    function saveHistory() {
      historyManager.saveSnapshot({
        annotations: state.annotations,
        rotations: state.pageRotations,
        crops: state.pageCrops,
      });
      updateUndoRedoUI();
    }

    function updateUndoRedoUI() {
      undoBtn.disabled = !historyManager.canUndo();
      redoBtn.disabled = !historyManager.canRedo();
    }

    undoBtn.addEventListener('click', async () => {
      const snapshot = historyManager.undo();
      if (snapshot) {
        state.annotations = snapshot.annotations;
        state.pageRotations = snapshot.rotations;
        state.pageCrops = snapshot.crops;
        await renderCurrentPage();
        await renderThumbnails();
        updateUndoRedoUI();
        showToast(editorStrings.actionUndone, 'info', 1800);
      }
    });

    redoBtn.addEventListener('click', async () => {
      const snapshot = historyManager.redo();
      if (snapshot) {
        state.annotations = snapshot.annotations;
        state.pageRotations = snapshot.rotations;
        state.pageCrops = snapshot.crops;
        await renderCurrentPage();
        await renderThumbnails();
        updateUndoRedoUI();
        showToast(editorStrings.actionRedone, 'info', 1800);
      }
    });

    // Global Keyboard Shortcuts (V, T, D, H, R, S, Undo/Redo, Duplicate, Delete, Zoom)
    document.addEventListener('keydown', (e) => {
      const target = e.target;
      if (
        ['INPUT', 'TEXTAREA', 'SELECT'].includes(target?.tagName) ||
        target?.isContentEditable ||
        target?.closest?.('.annot-text-content') ||
        target?.closest?.('[contenteditable="true"]')
      ) {
        return;
      }

      const isMod = e.ctrlKey || e.metaKey;

      if (isMod) {
        const key = e.key.toLowerCase();
        if (key === 'z') {
          e.preventDefault();
          if (e.shiftKey) {
            if (!redoBtn.disabled) redoBtn.click();
          } else {
            if (!undoBtn.disabled) undoBtn.click();
          }
        } else if (key === 'y') {
          e.preventDefault();
          if (!redoBtn.disabled) redoBtn.click();
        } else if (key === 'd') {
          e.preventDefault();
          duplicateSelectedAnnotation();
        }
        return;
      }

      if (!e.altKey) {
        const key = e.key.toLowerCase();
        if (key === 'v') {
          e.preventDefault();
          document.getElementById('tool-select')?.click();
        } else if (key === 't') {
          e.preventDefault();
          document.getElementById('tool-text')?.click();
        } else if (key === 'd') {
          e.preventDefault();
          document.getElementById('tool-draw')?.click();
        } else if (key === 'h') {
          e.preventDefault();
          document.getElementById('tool-highlight')?.click();
        } else if (key === 'r') {
          e.preventDefault();
          document.getElementById('tool-redact')?.click();
        } else if (key === 's') {
          e.preventDefault();
          document.getElementById('btn-open-sign-modal')?.click();
        } else if (key === 'n') {
          e.preventDefault();
          document.getElementById('tool-sticky-note')?.click();
        } else if (e.key === 'Delete' || e.key === 'Backspace') {
          if (state.selectedAnnotationId) {
            e.preventDefault();
            deleteSelectedAnnotation();
          }
        } else if (e.key === '+' || e.key === '=') {
          e.preventDefault();
          zoomInBtn?.click();
        } else if (e.key === '-' || e.key === '_') {
          e.preventDefault();
          zoomOutBtn?.click();
        }
      }
    });

    // Action Confirmation Modal System
    let pendingConfirmAction = null;
    const confirmModal = document.getElementById('confirm-action-modal');
    const confirmTitle = document.getElementById('confirm-modal-title');
    const confirmMessage = document.getElementById('confirm-modal-message');
    const confirmSubtext = document.getElementById('confirm-modal-subtext');
    const confirmBtnProceed = document.getElementById('confirm-modal-btn-proceed');
    const confirmBtnCancel = document.getElementById('confirm-modal-btn-cancel');
    const confirmIconWrapper = document.getElementById('confirm-modal-icon-wrapper');

    function openConfirmModal({ title, message, subtext = '', confirmText = editorStrings.confirm, confirmStyle = 'rose', onConfirm }) {
      if (!confirmModal) return;
      pendingConfirmAction = onConfirm;

      if (confirmTitle) confirmTitle.textContent = title;
      if (confirmMessage) confirmMessage.textContent = message;
      if (confirmSubtext) {
        if (subtext) {
          confirmSubtext.innerHTML = `<span>💡</span> <span>${subtext}</span>`;
          confirmSubtext.classList.remove('hidden');
        } else {
          confirmSubtext.classList.add('hidden');
        }
      }

      if (confirmBtnProceed) {
        confirmBtnProceed.textContent = confirmText;
        if (confirmStyle === 'rose') {
          confirmBtnProceed.className = 'h-9 px-4 rounded-xl text-[13px] font-semibold text-white shadow-sm transition-colors cursor-pointer bg-rose-600 hover:bg-rose-700';
          if (confirmIconWrapper) confirmIconWrapper.className = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400';
        } else if (confirmStyle === 'amber') {
          confirmBtnProceed.className = 'h-9 px-4 rounded-xl text-[13px] font-semibold text-white shadow-sm transition-colors cursor-pointer bg-amber-600 hover:bg-amber-700';
          if (confirmIconWrapper) confirmIconWrapper.className = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400';
        } else {
          confirmBtnProceed.className = 'h-9 px-4 rounded-xl text-[13px] font-semibold text-white shadow-sm transition-colors cursor-pointer bg-gradient-to-r from-blue-600 to-cyan-600 hover:opacity-95';
          if (confirmIconWrapper) confirmIconWrapper.className = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600 dark:text-cyan-400';
        }
      }

      confirmModal.classList.remove('hidden');
    }

    function closeConfirmModal() {
      confirmModal?.classList.add('hidden');
      pendingConfirmAction = null;
    }

    confirmBtnCancel?.addEventListener('click', closeConfirmModal);
    confirmModal?.addEventListener('click', (e) => {
      if (e.target === confirmModal) closeConfirmModal();
    });

    confirmBtnProceed?.addEventListener('click', async () => {
      const action = pendingConfirmAction;
      closeConfirmModal();
      if (typeof action === 'function') {
        await action();
      }
    });

    // Toast Notification System
    const toastContainer = document.getElementById('editor-toast-container');
    function showToast(message, type = 'info', duration = 3000) {
      if (!toastContainer) return;

      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto flex items-center gap-2.5 rounded-2xl border bg-canvas-elevated/95 backdrop-blur-xl px-4 py-2.5 text-[13px] font-medium shadow-floating transition-all duration-300 translate-y-4 opacity-0';

      let iconHtml = '';
      if (type === 'success') {
        toast.classList.add('border-emerald-500/40', 'text-ink');
        iconHtml = `<svg class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
      } else if (type === 'warning') {
        toast.classList.add('border-amber-500/40', 'text-ink');
        iconHtml = `<svg class="h-4 w-4 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`;
      } else {
        toast.classList.add('border-hairline', 'text-ink');
        iconHtml = `<svg class="h-4 w-4 text-blue-600 dark:text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
      }

      toast.innerHTML = `${iconHtml}<span>${message}</span>`;
      toastContainer.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-4', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('translate-y-4', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, duration);
    }

    // Reset Changes for Current or Specified Page
    function resetPageChanges(pageNum = state.currentPage) {
      if (!state.pdfDocProxy) {
        showToast(editorStrings.noDocLoaded, 'info');
        return;
      }

      const p = pageNum || state.currentPage;
      const annotCount = (state.annotations[p] && state.annotations[p].length) || 0;
      const hasRotation = Boolean(state.pageRotations[p]);
      const hasCrop = Boolean(state.pageCrops && state.pageCrops[p]);

      if (annotCount === 0 && !hasRotation && !hasCrop) {
        showToast(`${editorStrings.pageNoChanges}`, 'info');
        return;
      }

      const details = [];
      if (annotCount > 0) details.push(`${annotCount} ${annotCount === 1 ? editorStrings.annotation : editorStrings.annotations}`);
      if (hasRotation) details.push(`${editorStrings.rotation} (${state.pageRotations[p]}°)`);
      if (hasCrop) details.push(editorStrings.cropResize);

      openConfirmModal({
        title: `${editorStrings.resetTitle} ${p}?`,
        message: `${editorStrings.resetMessage} ${p} (${details.join(', ')})`,
        subtext: editorStrings.resetSubtext,
        confirmText: `${editorStrings.resetConfirm} ${p}`,
        confirmStyle: 'amber',
        onConfirm: async () => {
          state.annotations[p] = [];
          state.pageRotations[p] = 0;
          if (state.pageCrops && state.pageCrops[p]) {
            delete state.pageCrops[p];
          }

          if (state.selectedAnnotationId) {
            state.selectedAnnotationId = null;
            document.getElementById('property-bar')?.classList.add('hidden');
          }

          saveHistory();

          if (state.currentPage === p) {
            await renderCurrentPage();
          }
          await renderSingleThumbnail(p);
          showToast(`${p} ${editorStrings.changesReset}`, 'success');
        }
      });
    }

    // Reset Changes on ALL Pages in a Single Click
    function resetAllPagesChanges() {
      if (!state.pdfDocProxy) {
        showToast(editorStrings.noDocLoaded, 'info');
        return;
      }

      let totalAnnots = 0;
      let totalRotations = 0;
      let totalCrops = 0;

      for (let p = 1; p <= state.totalPages; p++) {
        if (state.annotations[p] && state.annotations[p].length > 0) {
          totalAnnots += state.annotations[p].length;
        }
        if (state.pageRotations[p]) {
          totalRotations++;
        }
        if (state.pageCrops && state.pageCrops[p]) {
          totalCrops++;
        }
      }

      const totalChanges = totalAnnots + totalRotations + totalCrops;
      if (totalChanges === 0) {
        showToast(editorStrings.allClean, 'info');
        return;
      }

      const summaryParts = [];
      if (totalAnnots > 0) summaryParts.push(`${totalAnnots} ${totalAnnots === 1 ? editorStrings.annotation : editorStrings.annotations}`);
      if (totalRotations > 0) summaryParts.push(`${totalRotations} ${totalRotations === 1 ? editorStrings.rotatedPage : editorStrings.rotatedPages}`);
      if (totalCrops > 0) summaryParts.push(`${totalCrops} ${totalCrops === 1 ? editorStrings.cropNoun : editorStrings.cropsNoun}`);

      openConfirmModal({
        title: editorStrings.resetAllTitle,
        message: `${editorStrings.resetAllMessage} (${summaryParts.join(', ')})`,
        subtext: editorStrings.resetAllSubtext,
        confirmText: editorStrings.resetAllConfirm,
        confirmStyle: 'rose',
        onConfirm: async () => {
          for (let p = 1; p <= state.totalPages; p++) {
            state.annotations[p] = [];
            state.pageRotations[p] = 0;
          }
          state.pageCrops = {};

          state.selectedAnnotationId = null;
          document.getElementById('property-bar')?.classList.add('hidden');

          saveHistory();
          await renderThumbnails();
          await renderCurrentPage();
          showToast(editorStrings.resetAllSuccess, 'success');
        }
      });
    }

    // Start a New Session: unloads current document and restores the workspace dropzone
    function startNewSession() {
      if (!state.pdfDocProxy) {
        fileInput?.click();
        return;
      }

      openConfirmModal({
        title: editorStrings.newSessionTitle,
        message: editorStrings.newSessionMessage,
        subtext: editorStrings.newSessionSubtext,
        confirmText: editorStrings.newSessionConfirm,
        confirmStyle: 'primary',
        onConfirm: () => {
          // Reset internal state
          state.pdfBytes = null;
          state.pdfDocProxy = null;
          state.totalPages = 0;
          state.currentPage = 1;
          state.pageRotations = {};
          state.pageCrops = {};
          state.annotations = {};
          state.activeTool = 'select';
          state.scale = 1.0;
          state.selectedAnnotationId = null;
          historyManager.reset();
          pdfRenderer.destroy();
          updateUndoRedoUI();
          state.isDrawing = false;
          state.drawPoints = [];

          // Reset canvases
          renderCanvas.width = 0;
          renderCanvas.height = 0;
          renderCanvas.style.width = '0px';
          renderCanvas.style.height = '0px';
          drawCanvas.width = 0;
          drawCanvas.height = 0;
          drawCanvas.style.width = '0px';
          drawCanvas.style.height = '0px';

          // Reset DOM layers and counters
          annotationsLayer.innerHTML = '';
          if (textDetectLayer) {
            textDetectLayer.innerHTML = '';
            textDetectLayer.classList.add('hidden');
          }
          thumbnailsList.innerHTML = '';
          sidebarCount.textContent = '0';
          curPageSpan.textContent = '1';
          totPageSpan.textContent = '1';
          zoomPct.textContent = '100%';

          // Reset visibility
          pageContainer.classList.add('hidden');
          pageNav.classList.add('hidden');
          pageNav.classList.remove('flex');
          propertyBar?.classList.add('hidden');
          deselectAnnotation();
          emptyState.classList.remove('hidden');

          // Transition back to Dropzone view
          const dropzoneView = document.getElementById('editor-dropzone-view');
          const studioView = document.getElementById('editor-studio-view');
          if (studioView) {
            studioView.classList.add('hidden');
            studioView.classList.remove('flex');
          }
          if (dropzoneView) {
            dropzoneView.classList.remove('hidden');
          }

          // Hide secondary tools strip when returning to dropzone view
          const toolsStrip = document.getElementById('tools-strip');
          if (toolsStrip) {
            toolsStrip.classList.add('hidden');
          }
          const toolsTrigger = document.getElementById('tools-menu-trigger');
          const toolsChevron = document.getElementById('tools-menu-chevron');
          toolsTrigger?.setAttribute('aria-expanded', 'false');
          toolsChevron?.classList.remove('rotate-180');
          const heroHeader = document.getElementById('hero-intro-header');
          if (heroHeader) heroHeader.classList.remove('hidden');

          // Reset file inputs
          if (fileInput) fileInput.value = '';
          if (appendFileInput) appendFileInput.value = '';

          // Reset tools to 'select'
          setTool('select');
          updateUndoRedoUI();

          // Close any open auxiliary modals
          document.getElementById('signature-modal')?.classList.add('hidden');
          document.getElementById('stamp-modal')?.classList.add('hidden');
          document.getElementById('watermark-modal')?.classList.add('hidden');
          document.getElementById('image-crop-modal')?.classList.add('hidden');

          showToast(editorStrings.newSessionStarted, 'info');
          dropzoneView ? dropzoneView.scrollIntoView({ behavior: 'smooth', block: 'center' }) : emptyState.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    // Attach Event Listeners for Reset & New Session Controls
    document.getElementById('btn-reset-page')?.addEventListener('click', () => resetPageChanges());
    document.getElementById('btn-floating-reset-page')?.addEventListener('click', () => resetPageChanges());
    document.getElementById('btn-reset-all')?.addEventListener('click', resetAllPagesChanges);
    document.getElementById('btn-sidebar-reset-all')?.addEventListener('click', resetAllPagesChanges);
    document.getElementById('btn-new-session')?.addEventListener('click', startNewSession);

    // Load PDF ArrayBuffer or Uint8Array
    async function loadPdfBuffer(inputData) {
      showLoading(editorStrings.rendering);
      try {
        if (inputData instanceof Uint8Array) {
          state.pdfBytes = inputData.slice();
        } else if (inputData instanceof ArrayBuffer) {
          state.pdfBytes = new Uint8Array(inputData.slice(0));
        } else if (inputData && inputData.buffer) {
          state.pdfBytes = new Uint8Array(inputData.buffer, inputData.byteOffset || 0, inputData.byteLength).slice();
        } else {
          state.pdfBytes = new Uint8Array(inputData).slice();
        }

        if (!window.pdfjsLib) {
          throw new Error('PDF.js engine is still loading. Please try again.');
        }
        const loadingTask = window.pdfjsLib.getDocument({ data: state.pdfBytes.slice() });
        state.pdfDocProxy = await loadingTask.promise;
        state.totalPages = state.pdfDocProxy.numPages;
        state.currentPage = 1;
        state.annotations = {};
        state.pageRotations = {};
        state.pageCrops = {};

        for (let i = 1; i <= state.totalPages; i++) {
          state.annotations[i] = [];
          state.pageRotations[i] = 0;
        }

        // Progressive disclosure: transition from Dropzone to Studio View
        const dropzoneView = document.getElementById('editor-dropzone-view');
        const studioView = document.getElementById('editor-studio-view');
        if (dropzoneView) dropzoneView.classList.add('hidden');
        if (studioView) {
          studioView.classList.remove('hidden');
          studioView.classList.add('flex');
        }

        // Reveal secondary tools strip after loading PDF
        const toolsStrip = document.getElementById('tools-strip');
        if (toolsStrip) {
          toolsStrip.classList.remove('hidden');
          toolsStrip.classList.remove('!hidden');
        }
        const toolsTrigger = document.getElementById('tools-menu-trigger');
        const toolsChevron = document.getElementById('tools-menu-chevron');
        toolsTrigger?.setAttribute('aria-expanded', 'true');
        toolsChevron?.classList.add('rotate-180');

        // Collapse hero intro header to give studio maximum vertical room
        const heroHeader = document.getElementById('hero-intro-header');
        if (heroHeader) heroHeader.classList.add('hidden');

        // Scroll to top so Navbar and Tools strip are visible
        window.scrollTo({ top: 0, behavior: 'smooth' });

        emptyState.classList.add('hidden');
        pageContainer.classList.remove('hidden');
        pageNav.classList.remove('hidden');
        pageNav.classList.add('flex');

        sidebarCount.textContent = state.totalPages;
        totPageSpan.textContent = state.totalPages;

        saveHistory();
        await renderThumbnails();
        await renderCurrentPage();

        // Default studio mode to 'Edit Text'
        setStudioMode('text');

        const urlParams = new URLSearchParams(window.location.search);
        const pendingTool = urlParams.get('tool');
        if (pendingTool) {
          applyToolFromQuery(pendingTool);
        }
      } catch (err) {
        console.error('Error loading PDF:', err);
        alert(editorStrings.loadFailed + err.message);
      } finally {
        hideLoading();
      }
    }

    function escapeHtml(str) {
      if (typeof str !== 'string') return '';
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function mapFontFamily(fontName) {
      if (!fontName || typeof fontName !== 'string') return 'Geist, sans-serif';
      const fn = fontName.toLowerCase();
      if (
        fn.includes('times') ||
        fn.includes('serif') ||
        fn.includes('georgia') ||
        fn.includes('garamond') ||
        fn.includes('palatino') ||
        fn.includes('baskerville') ||
        fn.includes('minion') ||
        fn.includes('cambria') ||
        fn.includes('century') ||
        fn.includes('bookman') ||
        fn.includes('roman')
      ) {
        return 'Times New Roman, serif';
      }
      if (
        fn.includes('mono') ||
        fn.includes('courier') ||
        fn.includes('consolas') ||
        fn.includes('menlo') ||
        fn.includes('code') ||
        fn.includes('typewriter') ||
        fn.includes('fixed')
      ) {
        return 'Geist Mono, monospace';
      }
      return 'Geist, sans-serif';
    }

    function sampleCanvasBackground(canvas, box) {
      try {
        const ctx = canvas.getContext('2d');
        if (!ctx) return '#ffffff';

        const dispW = parseFloat(canvas.style.width) || (canvas.width / 1.5) || canvas.width;
        const dispH = parseFloat(canvas.style.height) || (canvas.height / 1.5) || canvas.height;
        const scaleX = canvas.width / dispW;
        const scaleY = canvas.height / dispH;

        const left = Math.round(box.x * scaleX);
        const top = Math.round(box.y * scaleY);
        const right = Math.round((box.x + box.width) * scaleX);
        const bottom = Math.round((box.y + box.height) * scaleY);
        const midX = Math.round((left + right) / 2);
        const midY = Math.round((top + bottom) / 2);

        const perimeterPoints = [
          [Math.max(0, left - 4), Math.max(0, Math.min(canvas.height - 1, midY))],
          [Math.min(canvas.width - 1, right + 4), Math.max(0, Math.min(canvas.height - 1, midY))],
          [Math.max(0, Math.min(canvas.width - 1, midX)), Math.max(0, top - 4)],
          [Math.max(0, Math.min(canvas.width - 1, midX)), Math.min(canvas.height - 1, bottom + 4)],
          [Math.max(0, left - 3), Math.max(0, top - 3)],
          [Math.min(canvas.width - 1, right + 3), Math.max(0, top - 3)],
          [Math.max(0, left - 3), Math.min(canvas.height - 1, bottom + 3)],
          [Math.min(canvas.width - 1, right + 3), Math.min(canvas.height - 1, bottom + 3)],
          [Math.max(0, Math.min(canvas.width - 1, midX)), Math.min(canvas.height - 1, top + 1)],
          [Math.max(0, Math.min(canvas.width - 1, midX)), Math.max(0, bottom - 1)],
        ];

        const samples = [];
        for (const [sx, sy] of perimeterPoints) {
          const data = ctx.getImageData(sx, sy, 1, 1).data;
          if (data[3] < 20) continue;
          const brightness = 0.299 * data[0] + 0.587 * data[1] + 0.114 * data[2];
          samples.push({ r: data[0], g: data[1], b: data[2], brightness });
        }

        if (samples.length === 0) return '#ffffff';

        samples.sort((a, b) => b.brightness - a.brightness);
        const best = samples[0];
        const r = best.r.toString(16).padStart(2, '0');
        const g = best.g.toString(16).padStart(2, '0');
        const b = best.b.toString(16).padStart(2, '0');
        return `#${r}${g}${b}`;
      } catch (err) {
        console.warn('Canvas background sample error:', err);
        return '#ffffff';
      }
    }

    function handleTextRunClick(boxData, boxEl) {
      const sampledBg = sampleCanvasBackground(renderCanvas, boxData);
      const closestFont = mapFontFamily(boxData.fontName);

      if (boxEl) {
        boxEl.style.display = 'none';
      }

      insertTextAnnotation(boxData.x, boxData.y, {
        text: boxData.str,
        fontSize: boxData.fontSize,
        fontFamily: closestFont,
        bgWhiteout: true,
        customBgColor: sampledBg,
        width: boxData.width,
        height: boxData.height,
        baselineY: boxData.baselineY,
        color: '#171717',
      });

      const propFam = document.getElementById('prop-font-family');
      if (propFam) propFam.value = closestFont;
      const propSize = document.getElementById('prop-font-size');
      if (propSize) {
        let matchedOpt = Array.from(propSize.options).find(opt => opt.value === String(boxData.fontSize));
        if (!matchedOpt) {
          const newOpt = document.createElement('option');
          newOpt.value = String(boxData.fontSize);
          newOpt.textContent = `${boxData.fontSize}px`;
          propSize.appendChild(newOpt);
        }
        propSize.value = String(boxData.fontSize);
      }

      showToast('Text ready to edit inline with matching background', 'info', 1800);
    }

    // Render Detected Text Runs Interactive Overlay Layer
    async function renderTextDetectOverlay(page) {
      if (!textDetectLayer || !page || typeof page.getTextContent !== 'function') return;
      textDetectLayer.innerHTML = '';

      const totalRotation = ((page.rotate || 0) + (state.pageRotations[state.currentPage] || 0)) % 360;
      const viewport = page.getViewport({ scale: state.scale, rotation: totalRotation });

      let textContent;
      try {
        textContent = await page.getTextContent({ normalizeWhitespace: true });
      } catch (err) {
        console.warn('Failed to retrieve text content for page:', err);
        return;
      }

      if (!textContent || !Array.isArray(textContent.items) || textContent.items.length === 0) {
        return;
      }

      const fragment = document.createDocumentFragment();

      for (const item of textContent.items) {
        if (!item.str || typeof item.str !== 'string' || item.str.trim().length === 0) {
          continue;
        }
        if (!item.transform || item.transform.length < 6) {
          continue;
        }

        // Map text item's transform matrix to canvas viewport coordinates using pdfjsLib.Util.transform
        const tx = (window.pdfjsLib && window.pdfjsLib.Util && typeof window.pdfjsLib.Util.transform === 'function')
          ? window.pdfjsLib.Util.transform(viewport.transform, item.transform)
          : [
              viewport.transform[0] * item.transform[0] + viewport.transform[2] * item.transform[1],
              viewport.transform[1] * item.transform[0] + viewport.transform[3] * item.transform[1],
              viewport.transform[0] * item.transform[2] + viewport.transform[2] * item.transform[3],
              viewport.transform[1] * item.transform[2] + viewport.transform[3] * item.transform[3],
              viewport.transform[0] * item.transform[4] + viewport.transform[2] * item.transform[5] + viewport.transform[4],
              viewport.transform[1] * item.transform[4] + viewport.transform[3] * item.transform[5] + viewport.transform[5],
            ];

        const fontSizePdf = Math.hypot(item.transform[0], item.transform[1]) || item.height || 12;
        const fontHeight = Math.hypot(tx[2], tx[3]) || Math.hypot(tx[0], tx[1]) || (fontSizePdf * state.scale) || 14;
        const localW = fontSizePdf > 0 ? (item.width || 0) / fontSizePdf : 0;

        // Viewport corners
        const p1 = [tx[4], tx[5]]; // baseline start
        const p2 = [tx[0] * localW + tx[4], tx[1] * localW + tx[5]]; // baseline end
        const p3 = [tx[0] * localW + tx[2] + tx[4], tx[1] * localW + tx[3] + tx[5]]; // top end
        const p4 = [tx[2] + tx[4], tx[3] + tx[5]]; // top start

        let minX = Math.min(p1[0], p2[0], p3[0], p4[0]);
        let maxX = Math.max(p1[0], p2[0], p3[0], p4[0]);
        let minY = Math.min(p1[1], p2[1], p3[1], p4[1]);
        let maxY = Math.max(p1[1], p2[1], p3[1], p4[1]);

        // Account for ascenders/descenders
        const descenderDepth = fontHeight * 0.22;
        maxY += descenderDepth;
        minY -= fontHeight * 0.05;
        minX -= 2;
        maxX += 2;

        const boxX = Math.max(0, Math.round(minX));
        const boxY = Math.max(0, Math.round(minY));
        const boxW = Math.max(16, Math.round(maxX - minX));
        const boxH = Math.max(14, Math.round(maxY - minY));
        const baselineY = Math.round(tx[5]);
        const baselineX = Math.round(tx[4]);
        const calculatedFontSize = Math.max(10, Math.min(72, Math.round(fontHeight)));

        const boxEl = document.createElement('div');
        boxEl.className = 'absolute border border-dashed border-transparent hover:border-blue-500 hover:bg-blue-500/10 transition-colors cursor-text pointer-events-auto rounded-xs';
        boxEl.style.left = `${boxX}px`;
        boxEl.style.top = `${boxY}px`;
        boxEl.style.width = `${boxW}px`;
        boxEl.style.height = `${boxH}px`;
        boxEl.title = `Click to edit: "${escapeHtml(item.str)}"`;
        boxEl.setAttribute('role', 'button');
        boxEl.setAttribute('aria-label', `Edit text: ${item.str}`);

        const boxData = {
          x: boxX,
          y: boxY,
          width: boxW,
          height: boxH,
          baselineX,
          baselineY,
          fontSize: calculatedFontSize,
          fontName: item.fontName,
          str: item.str,
          transform: item.transform,
          itemWidth: item.width,
          itemHeight: item.height,
        };

        boxEl.addEventListener('click', (e) => {
          e.stopPropagation();
          e.preventDefault();
          handleTextRunClick(boxData, boxEl);
        });

        fragment.appendChild(boxEl);
      }

      textDetectLayer.appendChild(fragment);

      if (state.activeTool === 'text') {
        textDetectLayer.classList.remove('hidden');
      } else {
        textDetectLayer.classList.add('hidden');
      }
    }

    // Render Main Active Page
    async function renderCurrentPage() {
      if (!state.pdfDocProxy) return;
      showLoading(editorStrings.renderingPage + ' ' + state.currentPage + '...');
      try {
        curPageSpan.textContent = state.currentPage;
        prevPageBtn.disabled = state.currentPage <= 1;
        nextPageBtn.disabled = state.currentPage >= state.totalPages;

        const page = await state.pdfDocProxy.getPage(state.currentPage);
        const result = await pdfRenderer.renderPage(page, renderCanvas, {
          scale: state.scale,
          rotation: state.pageRotations[state.currentPage] || 0,
          crop: state.pageCrops ? state.pageCrops[state.currentPage] : null,
          drawCanvas,
        });

        if (!result) return; // In-flight render cancelled or superseded

        renderAnnotationsLayer(result.displayWidth, result.displayHeight);
        renderDrawingsOnCanvas();
        highlightActiveThumbnail();

        // Render detected text runs interactive overlay
        await renderTextDetectOverlay(page);
      } catch (err) {
        console.error('Render error:', err);
      } finally {
        hideLoading();
      }
    }

    // Update Annotation Rotation (Image, Signature, Stamp)
    function updateAnnotRotation(annot, rotDeg, save = true) {
      const normalized = ((Math.round(rotDeg) % 360) + 360) % 360;
      annot.rotation = normalized;
      const el = document.getElementById('annot-' + annot.id);
      if (el) {
        const rotWrapper = el.querySelector('.annot-rot-wrapper');
        if (rotWrapper) {
          rotWrapper.style.transform = `rotate(${normalized}deg)`;
        }
      }
      const propAngleInput = document.getElementById('prop-rotate-angle');
      if (propAngleInput && state.selectedAnnotationId === annot.id) {
        propAngleInput.value = normalized;
      }
      const propSlider = document.getElementById('prop-rotate-slider');
      if (propSlider && state.selectedAnnotationId === annot.id) {
        propSlider.value = normalized;
      }
      if (save) saveHistory();
    }

    // Render Annotations HTML overlay
    function renderAnnotationsLayer(width, height) {
      annotationsLayer.innerHTML = '';
      const pageAnnots = state.annotations[state.currentPage] || [];

      pageAnnots.forEach(annot => {
        const el = document.createElement('div');
        el.id = 'annot-' + annot.id;
        el.className = 'absolute group';
        el.style.left = annot.x + 'px';
        el.style.top = annot.y + 'px';
        el.style.zIndex = annot.zIndex || '25';

        if (annot.type === 'text') {
          const isWhiteout = !!annot.bgWhiteout;
          const paddingStyle = isWhiteout ? 'padding: 0 2px;' : 'padding: 4px 10px;';
          const minWStyle = annot.width ? `min-width: ${annot.width}px;` : 'min-width: 50px;';
          const minHStyle = annot.height ? `min-height: ${annot.height}px;` : '';
          const bgStyle = isWhiteout ? `background-color: ${annot.customBgColor || '#ffffff'};` : '';
          const borderClass = isWhiteout ? 'border border-dashed border-blue-400/50 hover:border-blue-500' : 'border border-dashed border-ink/30 hover:border-link';
          el.innerHTML = `
            <div class="relative rounded-xs bg-transparent ${borderClass} focus-within:border-link focus-within:ring-1 focus-within:ring-link/30 transition-all cursor-text select-text"
                 style="color: ${annot.color || '#171717'}; font-size: ${annot.fontSize || 16}px; font-family: ${annot.fontFamily || 'Geist, sans-serif'}; line-height: 1.15; ${bgStyle} ${minWStyle} ${minHStyle} ${paddingStyle}">
              <div class="annot-text-content select-text cursor-text outline-none inline-block whitespace-pre-wrap break-words" style="${minWStyle} line-height: 1.15;" contenteditable="true" spellcheck="false">${annot.text !== undefined ? escapeHtml(annot.text) : editorStrings.typeTextPlaceholder}</div>
              <button type="button" class="annot-del-btn absolute -top-2.5 -right-2.5 h-5 w-5 rounded-full bg-rose-600 text-white text-xs flex items-center justify-center opacity-0 group-hover:opacity-100 shadow-sm transition-opacity cursor-pointer z-30" title="Delete text">&times;</button>
              <div class="annot-drag-handle absolute -top-2.5 -left-2.5 h-5 w-5 rounded-full bg-ink text-on-primary text-[10px] flex items-center justify-center opacity-0 group-hover:opacity-100 shadow-sm cursor-grab active:cursor-grabbing transition-opacity z-30 select-none" title="Drag to move">✥</div>
            </div>
          `;
        } else if (annot.type === 'shape') {
          let inner = '';
          const w = annot.width || 120;
          const h = annot.height || 60;
          const stroke = annot.color || '#171717';
          const strokeW = annot.strokeWidth || 2;
          const op = annot.opacity !== undefined ? annot.opacity : 1;

          if (annot.shapeType === 'rect') {
            inner = `<div class="annot-shape-box" style="width:${w}px; height:${h}px; border:${strokeW}px solid ${stroke}; opacity:${op};"></div>`;
          } else if (annot.shapeType === 'rounded-rect') {
            inner = `<div class="annot-shape-box" style="width:${w}px; height:${h}px; border:${strokeW}px solid ${stroke}; border-radius:8px; opacity:${op};"></div>`;
          } else if (annot.shapeType === 'circle') {
            inner = `<div class="annot-shape-box" style="width:${w}px; height:${h}px; border:${strokeW}px solid ${stroke}; border-radius:50%; opacity:${op};"></div>`;
          } else if (annot.shapeType === 'line') {
            inner = `<div class="annot-shape-box" style="width:${w}px; height:${strokeW}px; background-color:${stroke}; opacity:${op};"></div>`;
          } else if (annot.shapeType === 'check') {
            inner = `<div class="annot-shape-box flex items-center justify-center select-none" style="width:${w}px; height:${h}px; font-size:${Math.min(w,h)*0.8}px; font-weight:bold; color:${stroke}; opacity:${op};">✓</div>`;
          } else if (annot.shapeType === 'cross') {
            inner = `<div class="annot-shape-box flex items-center justify-center select-none" style="width:${w}px; height:${h}px; font-size:${Math.min(w,h)*0.8}px; font-weight:bold; color:${stroke}; opacity:${op};">✕</div>`;
          } else if (annot.shapeType === 'arrow') {
            inner = `<div class="annot-shape-box flex items-center justify-center select-none" style="width:${w}px; height:${h}px; font-size:${Math.min(w,h)*0.8}px; font-weight:bold; color:${stroke}; opacity:${op};">➔</div>`;
          }

          el.innerHTML = `
            <div class="relative cursor-move group-hover:outline group-hover:outline-1 group-hover:outline-link select-none">
              ${inner}
              <button type="button" class="annot-del-btn absolute -top-2.5 -right-2.5 h-5 w-5 rounded-full bg-rose-600 text-white text-xs flex items-center justify-center opacity-0 group-hover:opacity-100 shadow-sm transition-opacity cursor-pointer z-30" title="Delete shape">&times;</button>
              <div class="annot-resize-handle absolute -bottom-1.5 -right-1.5 h-3.5 w-3.5 rounded-full bg-link border-2 border-white shadow-xs cursor-se-resize opacity-0 group-hover:opacity-100 transition-opacity z-30" title="Drag to resize"></div>
            </div>
          `;
        } else if (annot.type === 'image' || annot.type === 'signature' || annot.type === 'stamp') {
          const w = annot.width || 160;
          const h = annot.height || (annot.type === 'stamp' ? 60 : 70);
          const rot = ((annot.rotation || 0) % 360 + 360) % 360;
          const isSelected = (state.selectedAnnotationId === annot.id);
          el.innerHTML = `
            <div class="annot-rot-wrapper relative cursor-move ${isSelected ? 'ring-2 ring-blue-500 shadow-md' : 'group-hover:outline group-hover:outline-1 group-hover:outline-link'} select-none" style="transform: rotate(${rot}deg); transform-origin: center center;">
              <img src="${annot.src}" style="width:${w}px; height:${h}px; object-fit:contain;" draggable="false" />
              <!-- Action Buttons: Rotate, Crop & Delete -->
              <div class="annot-action-bar absolute -top-4 right-0 flex items-center gap-1 ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-30 pointer-events-auto">
                <button type="button" class="annot-rotate-btn flex items-center gap-1 h-5 px-2 rounded-full bg-canvas-elevated hover:bg-hairline-soft text-ink border border-hairline text-[10px] font-medium shadow-xs transition-all cursor-pointer" title="Rotate +90°">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-blue-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>Rotate</span>
                </button>
                <button type="button" class="annot-crop-btn flex items-center gap-1 h-5 px-2 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500 hover:opacity-90 text-white text-[10px] font-medium shadow-xs transition-all cursor-pointer" title="Crop & Resize image">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h14a2 2 0 012 2v14M7 3v14a2 2 0 002 2h14" />
                  </svg>
                  <span>Crop</span>
                </button>
                <button type="button" class="annot-del-btn h-5 w-5 rounded-full bg-rose-600 hover:bg-rose-500 text-white text-xs flex items-center justify-center shadow-xs transition-all cursor-pointer" title="Delete">&times;</button>
              </div>

              <!-- Top Center Dedicated Rotation Handle & Stem -->
              <div class="annot-rotate-stem absolute -top-6 left-1/2 -translate-x-1/2 w-0.5 h-5 bg-blue-500 pointer-events-none ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity"></div>
              <div class="annot-rotate-handle absolute -top-11 left-1/2 -translate-x-1/2 h-7 w-7 rounded-full bg-gradient-to-tr from-blue-600 via-indigo-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white shadow-lg border-2 border-white cursor-grab active:cursor-grabbing flex items-center justify-center transition-all hover:scale-115 active:scale-95 z-40 ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'}" title="Drag with mouse or scroll wheel to rotate">
                <svg class="h-4 w-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </div>
              <div class="annot-rotate-badge absolute -top-17 left-1/2 -translate-x-1/2 hidden px-2.5 py-0.5 rounded-full bg-zinc-900 text-white text-[11px] font-mono font-bold shadow-lg border border-white/20 whitespace-nowrap pointer-events-none z-50">
                ${rot}°
              </div>

              <!-- 4 Corner Resize Handles (SE, SW, NE, NW) -->
              <div class="annot-resize-handle absolute -bottom-2 -right-2 h-4 w-4 rounded-full bg-white border-2 border-blue-600 shadow-md cursor-se-resize ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-40 hover:scale-125" title="Drag with mouse to resize"></div>
              <div class="annot-resize-handle-sw absolute -bottom-2 -left-2 h-4 w-4 rounded-full bg-white border-2 border-blue-600 shadow-md cursor-sw-resize ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-40 hover:scale-125" title="Drag with mouse to resize"></div>
              <div class="annot-resize-handle-ne absolute -top-2 -right-2 h-4 w-4 rounded-full bg-white border-2 border-blue-600 shadow-md cursor-ne-resize ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-40 hover:scale-125" title="Drag with mouse to resize"></div>
              <div class="annot-resize-handle-nw absolute -top-2 -left-2 h-4 w-4 rounded-full bg-white border-2 border-blue-600 shadow-md cursor-nw-resize ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-40 hover:scale-125" title="Drag with mouse to resize"></div>
            </div>
          `;
        } else if (annot.type === 'watermark') {
          const rot = ((annot.rotation || 0) % 360 + 360) % 360;
          const isSelected = (state.selectedAnnotationId === annot.id);
          const isUnder = annot.underText !== false;
          const fontSize = annot.fontSize || 48;
          const color = annot.color || '#ef4444';
          const opacity = annot.opacity !== undefined ? annot.opacity : 0.2;

          el.style.zIndex = isUnder ? '15' : '25';
          el.innerHTML = `
            <div class="annot-rot-wrapper relative cursor-move select-none ${isSelected ? 'ring-2 ring-blue-500 shadow-md' : 'group-hover:outline group-hover:outline-1 group-hover:outline-link'}"
                 style="transform: rotate(${rot}deg); transform-origin: center center; ${isUnder ? 'mix-blend-mode: multiply;' : ''}">
              <div class="annot-watermark-text px-4 py-2 font-extrabold tracking-widest uppercase pointer-events-auto select-none whitespace-nowrap"
                   style="color: ${color}; opacity: ${opacity}; font-size: ${fontSize}px; font-family: system-ui, sans-serif; text-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                ${annot.text || 'CONFIDENTIAL'}
              </div>

              <!-- Action Buttons: Rotate & Delete -->
              <div class="annot-action-bar absolute -top-5 right-0 flex items-center gap-1 ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-30 pointer-events-auto">
                <button type="button" class="annot-rotate-btn flex items-center gap-1 h-5 px-2 rounded-full bg-canvas-elevated hover:bg-hairline-soft text-ink border border-hairline text-[10px] font-medium shadow-xs transition-all cursor-pointer" title="Rotate +15° (or drag top handle for any angle)">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-blue-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>Rotate</span>
                </button>
                <button type="button" class="annot-del-btn h-5 w-5 rounded-full bg-rose-600 hover:bg-rose-500 text-white text-xs flex items-center justify-center shadow-xs transition-all cursor-pointer" title="Delete watermark">&times;</button>
              </div>

              <!-- Top Center Dedicated Rotation Handle & Stem -->
              <div class="annot-rotate-stem absolute -top-6 left-1/2 -translate-x-1/2 w-0.5 h-5 bg-blue-500 pointer-events-none ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity"></div>
              <div class="annot-rotate-handle absolute -top-11 left-1/2 -translate-x-1/2 h-7 w-7 rounded-full bg-gradient-to-tr from-blue-600 via-indigo-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white shadow-lg border-2 border-white cursor-grab active:cursor-grabbing flex items-center justify-center transition-all hover:scale-115 active:scale-95 z-40 ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'}" title="Drag with mouse or scroll wheel to rotate to any angle">
                <svg class="h-4 w-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </div>
              <div class="annot-rotate-badge absolute -top-17 left-1/2 -translate-x-1/2 hidden px-2.5 py-0.5 rounded-full bg-zinc-900 text-white text-[11px] font-mono font-bold shadow-lg border border-white/20 whitespace-nowrap pointer-events-none z-50">
                ${rot}°
              </div>

              <!-- 4 Corner Resize Handles (SE, SW, NE, NW) -->
              <div class="annot-resize-handle absolute -bottom-2 -right-2 h-4 w-4 rounded-full bg-white border-2 border-blue-600 shadow-md cursor-se-resize ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-40 hover:scale-125" title="Drag with mouse to scale watermark"></div>
              <div class="annot-resize-handle-sw absolute -bottom-2 -left-2 h-4 w-4 rounded-full bg-white border-2 border-blue-600 shadow-md cursor-sw-resize ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-40 hover:scale-125" title="Drag with mouse to scale watermark"></div>
              <div class="annot-resize-handle-ne absolute -top-2 -right-2 h-4 w-4 rounded-full bg-white border-2 border-blue-600 shadow-md cursor-ne-resize ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-40 hover:scale-125" title="Drag with mouse to scale watermark"></div>
              <div class="annot-resize-handle-nw absolute -top-2 -left-2 h-4 w-4 rounded-full bg-white border-2 border-blue-600 shadow-md cursor-nw-resize ${isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} transition-opacity z-40 hover:scale-125" title="Drag with mouse to scale watermark"></div>
            </div>
          `;
        } else if (annot.type === 'redact') {
          const w = annot.width || 140;
          const h = annot.height || 30;
          el.innerHTML = `
            <div class="annot-redact-box relative cursor-move bg-black rounded-xs flex items-center justify-center group-hover:outline group-hover:outline-1 group-hover:outline-rose-500 select-none" style="width:${w}px; height:${h}px;">
              <span class="text-[9px] font-mono text-white/60 uppercase tracking-widest pointer-events-none">${editorStrings.redactText}</span>
              <button type="button" class="annot-del-btn absolute -top-2.5 -right-2.5 h-5 w-5 rounded-full bg-rose-600 text-white text-xs flex items-center justify-center opacity-0 group-hover:opacity-100 shadow-sm transition-opacity cursor-pointer z-30">&times;</button>
              <div class="annot-resize-handle absolute -bottom-1.5 -right-1.5 h-3.5 w-3.5 rounded-full bg-rose-500 border-2 border-white shadow-xs cursor-se-resize opacity-0 group-hover:opacity-100 transition-opacity z-30" title="Drag to resize"></div>
            </div>
          `;
        } else if (annot.type === 'sticky') {
          const isSelected = (state.selectedAnnotationId === annot.id);
          const color = annot.noteColor || '#fef08a';
          const isExpanded = annot.stickyExpanded !== false;
          const w = annot.width || 210;
          const h = annot.height || 130;

          if (isExpanded) {
            el.innerHTML = `
              <div class="annot-sticky-card relative rounded-xl shadow-floating border border-black/15 overflow-hidden transition-all select-none ${isSelected ? 'ring-2 ring-blue-500' : 'hover:shadow-lg'}"
                   style="background-color: ${color}; width: ${w}px; min-height: ${h}px;">
                <!-- Header (Drag Handle) -->
                <div class="annot-drag-handle flex items-center justify-between px-2.5 py-1.5 border-b border-black/10 bg-black/5 cursor-grab active:cursor-grabbing select-none">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <span class="text-xs">💬</span>
                    <span class="text-[11px] font-bold text-zinc-800 truncate">${escapeHtml(annot.author || 'Sticky Note')}</span>
                  </div>
                  <div class="flex items-center gap-1">
                    <!-- Color Swatches -->
                    <div class="flex items-center gap-0.5 mr-1">
                      <button type="button" class="sticky-color-dot h-3 w-3 rounded-full bg-[#fef08a] border border-black/20 hover:scale-125 transition-transform cursor-pointer" data-color="#fef08a" title="Yellow"></button>
                      <button type="button" class="sticky-color-dot h-3 w-3 rounded-full bg-[#bae6fd] border border-black/20 hover:scale-125 transition-transform cursor-pointer" data-color="#bae6fd" title="Sky Blue"></button>
                      <button type="button" class="sticky-color-dot h-3 w-3 rounded-full bg-[#bbf7d0] border border-black/20 hover:scale-125 transition-transform cursor-pointer" data-color="#bbf7d0" title="Mint Green"></button>
                      <button type="button" class="sticky-color-dot h-3 w-3 rounded-full bg-[#fbcfe8] border border-black/20 hover:scale-125 transition-transform cursor-pointer" data-color="#fbcfe8" title="Soft Pink"></button>
                      <button type="button" class="sticky-color-dot h-3 w-3 rounded-full bg-[#e9d5ff] border border-black/20 hover:scale-125 transition-transform cursor-pointer" data-color="#e9d5ff" title="Lavender"></button>
                    </div>
                    <!-- Minimize / Collapse Button -->
                    <button type="button" class="sticky-collapse-btn h-5 w-5 rounded hover:bg-black/10 text-zinc-700 text-xs flex items-center justify-center transition-colors cursor-pointer" title="Minimize to Pin">
                      −
                    </button>
                    <!-- Delete Button -->
                    <button type="button" class="annot-del-btn h-5 w-5 rounded hover:bg-rose-500 hover:text-white text-zinc-700 text-xs flex items-center justify-center transition-colors cursor-pointer" title="Delete note">
                      &times;
                    </button>
                  </div>
                </div>

                <!-- Textarea Body -->
                <div class="p-2.5">
                  <textarea
                    id="sticky-input-${annot.id}"
                    class="sticky-note-input w-full bg-transparent border-none outline-none text-[12.5px] leading-snug text-zinc-900 placeholder:text-zinc-600/60 resize-none font-sans"
                    rows="3"
                    placeholder="Type review note or comment..."
                  >${escapeHtml(annot.text || '')}</textarea>
                </div>

                <!-- Footer / Export Mode Indicator -->
                <div class="px-2.5 py-1 bg-black/5 border-t border-black/10 flex items-center justify-between text-[9.5px] font-mono text-zinc-600">
                  <span class="flex items-center gap-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    <span>PDF Comment & Callout</span>
                  </span>
                  <span>Drag header to move</span>
                </div>
              </div>
            `;
          } else {
            // Collapsed Pin Mode
            const textPreview = annot.text ? escapeHtml(annot.text.slice(0, 50)) : 'Empty comment';
            el.innerHTML = `
              <div class="relative group/pin select-none">
                <button
                  type="button"
                  class="sticky-collapse-btn flex h-8 w-8 items-center justify-center rounded-full shadow-floating border-2 border-white ring-1 ring-black/20 hover:scale-115 active:scale-95 transition-all cursor-pointer"
                  style="background-color: ${color};"
                  title="Expand Sticky Note: ${textPreview}"
                >
                  <span class="text-sm">💬</span>
                </button>
                <button type="button" class="annot-del-btn absolute -top-1 -right-1 h-4 w-4 rounded-full bg-rose-600 text-white text-[10px] flex items-center justify-center opacity-0 group-hover/pin:opacity-100 shadow-sm transition-opacity cursor-pointer z-30" title="Delete note">&times;</button>
              </div>
            `;
          }
        }

        // Attach Drag Handling & Resize Handling
        attachAnnotationEvents(el, annot);
        annotationsLayer.appendChild(el);
      });
    }

    // Attach Event Listeners to each annotation (Drag, Resize & Delete)
    function attachAnnotationEvents(el, annot) {
      const delBtn = el.querySelector('.annot-del-btn');
      if (delBtn) {
        delBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          deleteAnnotation(annot.id);
        });
      }

      const textEl = el.querySelector('.annot-text-content');
      if (textEl) {
        textEl.addEventListener('input', () => {
          annot.text = textEl.innerText;
        });
        textEl.addEventListener('focus', () => {
          selectAnnotation(annot);
        });
        textEl.addEventListener('blur', () => {
          annot.text = textEl.innerText;
          saveHistory();
        });
        textEl.addEventListener('keydown', (e) => {
          e.stopPropagation();
        });
      }

      // Sticky Note Listeners (Input, Collapse, Colors)
      const stickyInput = el.querySelector('.sticky-note-input');
      if (stickyInput) {
        stickyInput.addEventListener('input', () => {
          annot.text = stickyInput.value;
        });
        stickyInput.addEventListener('focus', () => {
          selectAnnotation(annot);
        });
        stickyInput.addEventListener('blur', () => {
          annot.text = stickyInput.value;
          saveHistory();
        });
        stickyInput.addEventListener('keydown', (e) => {
          e.stopPropagation();
        });
      }

      const stickyCollapseBtns = el.querySelectorAll('.sticky-collapse-btn');
      stickyCollapseBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          annot.stickyExpanded = !annot.stickyExpanded;
          saveHistory();
          renderAnnotationsLayer();
        });
      });

      const stickyColorDots = el.querySelectorAll('.sticky-color-dot');
      stickyColorDots.forEach(dot => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          const newColor = dot.dataset.color;
          if (newColor) {
            annot.noteColor = newColor;
            saveHistory();
            renderAnnotationsLayer();
          }
        });
      });

      // Selection & Inspector
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        selectAnnotation(annot);
      });

      // Draggable logic
      let isDragging = false;
      let startX = 0, startY = 0;
      let initialLeft = 0, initialTop = 0;

      el.addEventListener('mousedown', (e) => {
        // If clicking inside editable text area, let user write/select text freely
        if (e.target.classList.contains('annot-text-content') || e.target.closest('.annot-text-content') || e.target.isContentEditable) {
          return;
        }
        if (e.target.classList.contains('sticky-note-input') || e.target.closest('.sticky-note-input') ||
            e.target.classList.contains('sticky-collapse-btn') || e.target.closest('.sticky-collapse-btn') ||
            e.target.classList.contains('sticky-color-dot') || e.target.closest('.sticky-color-dot')) {
          return;
        }
        if (e.target.classList.contains('annot-resize-handle') || e.target.closest('.annot-resize-handle') ||
            e.target.classList.contains('annot-resize-handle-sw') || e.target.closest('.annot-resize-handle-sw') ||
            e.target.classList.contains('annot-resize-handle-ne') || e.target.closest('.annot-resize-handle-ne') ||
            e.target.classList.contains('annot-resize-handle-nw') || e.target.closest('.annot-resize-handle-nw')) return;
        if (e.target.classList.contains('annot-del-btn') || e.target.closest('.annot-del-btn')) return;
        if (e.target.classList.contains('annot-crop-btn') || e.target.closest('.annot-crop-btn')) return;
        if (e.target.classList.contains('annot-rotate-btn') || e.target.closest('.annot-rotate-btn')) return;
        if (e.target.classList.contains('annot-rotate-handle') || e.target.closest('.annot-rotate-handle')) return;
        if (e.target.classList.contains('annot-rot-corner') || e.target.closest('.annot-rot-corner')) return;

        // If holding Alt OR Right-Clicking: start mouse rotation directly anywhere on the element!
        if (e.altKey || e.button === 2) {
          e.preventDefault();
          e.stopPropagation();
          startMouseRotation(e);
          return;
        }

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        initialLeft = annot.x;
        initialTop = annot.y;
        document.body.style.userSelect = 'none';

        function onMouseMove(moveEvent) {
          if (!isDragging) return;
          const dx = moveEvent.clientX - startX;
          const dy = moveEvent.clientY - startY;
          annot.x = Math.max(0, initialLeft + dx);
          annot.y = Math.max(0, initialTop + dy);
          el.style.left = annot.x + 'px';
          el.style.top = annot.y + 'px';
          positionPopoverPill(annot);
        }

        function onMouseUp() {
          if (isDragging) {
            isDragging = false;
            document.body.style.userSelect = '';
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
            saveHistory();
          }
        }

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });

      // Quick Crop Button
      const cropBtn = el.querySelector('.annot-crop-btn');
      if (cropBtn) {
        cropBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          selectAnnotation(annot);
          openCropModalForAnnotation(annot);
        });
      }

      // Quick Rotate Button
      const rotateBtn = el.querySelector('.annot-rotate-btn');
      if (rotateBtn) {
        rotateBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          selectAnnotation(annot);
          const step = (annot.type === 'watermark') ? 15 : 90;
          updateAnnotRotation(annot, (annot.rotation || 0) + step, true);
        });
      }

      // Unified Mouse Rotation Engine (Continuous, zero-jump)
      function startMouseRotation(e) {
        selectAnnotation(annot);
        const rotWrapper = el.querySelector('.annot-rot-wrapper');
        const rotBadge = el.querySelector('.annot-rotate-badge');
        const rect = (rotWrapper || el).getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        let lastAngle = Math.atan2(e.clientY - centerY, e.clientX - centerX) * (180 / Math.PI);
        let currentRotation = annot.rotation || 0;

        if (rotBadge) {
          rotBadge.classList.remove('hidden');
          rotBadge.textContent = `${((Math.round(currentRotation) % 360) + 360) % 360}°`;
        }
        document.body.style.userSelect = 'none';

        function onRotateMouseMove(moveEvent) {
          const currentAngle = Math.atan2(moveEvent.clientY - centerY, moveEvent.clientX - centerX) * (180 / Math.PI);
          let delta = currentAngle - lastAngle;
          // Smooth boundary wrap-around
          if (delta > 180) delta -= 360;
          if (delta < -180) delta -= 360;

          currentRotation += delta;
          lastAngle = currentAngle;

          let deg = currentRotation;
          if (moveEvent.shiftKey) {
            deg = Math.round(deg / 15) * 15;
          }
          const normalized = ((Math.round(deg) % 360) + 360) % 360;
          updateAnnotRotation(annot, normalized, false);
          if (rotBadge) {
            rotBadge.textContent = `${normalized}°`;
          }
        }

        function onRotateMouseUp() {
          if (rotBadge) rotBadge.classList.add('hidden');
          document.body.style.userSelect = '';
          document.removeEventListener('mousemove', onRotateMouseMove);
          document.removeEventListener('mouseup', onRotateMouseUp);
          saveHistory();
        }

        document.addEventListener('mousemove', onRotateMouseMove);
        document.addEventListener('mouseup', onRotateMouseUp);
      }

      // Top Rotation Handle (Mouse Drag)
      const rotateHandle = el.querySelector('.annot-rotate-handle');
      if (rotateHandle) {
        rotateHandle.addEventListener('mousedown', (e) => {
          e.stopPropagation();
          e.preventDefault();
          startMouseRotation(e);
        });
      }

      // Mouse Wheel Rotation: Scroll wheel directly over element rotates it!
      el.addEventListener('wheel', (e) => {
        if (annot.type === 'signature' || annot.type === 'stamp' || annot.type === 'image' || annot.type === 'watermark') {
          e.preventDefault();
          e.stopPropagation();
          selectAnnotation(annot);
          const step = e.shiftKey ? 15 : (e.altKey ? 1 : 5);
          const dir = e.deltaY < 0 ? step : -step;
          const newAngle = ((Math.round((annot.rotation || 0) + dir) % 360) + 360) % 360;
          updateAnnotRotation(annot, newAngle, true);
          const rotBadge = el.querySelector('.annot-rotate-badge');
          if (rotBadge) {
            rotBadge.classList.remove('hidden');
            rotBadge.textContent = `${newAngle}°`;
            clearTimeout(rotBadge._hideTimer);
            rotBadge._hideTimer = setTimeout(() => rotBadge.classList.add('hidden'), 800);
          }
        }
      }, { passive: false });

      // Prevent default right-click menu when using right-click to rotate
      el.addEventListener('contextmenu', (e) => {
        if (annot.type === 'signature' || annot.type === 'stamp' || annot.type === 'image' || annot.type === 'watermark') {
          e.preventDefault();
        }
      });

      // Multi-corner resize handling (100% Reliable Mouse Resizing Alongside Rotation)
      function setupResize(handleEl, direction) {
        if (!handleEl) return;
        handleEl.addEventListener('mousedown', (e) => {
          e.stopPropagation();
          e.preventDefault();
          selectAnnotation(annot);

          const rStartX = e.clientX;
          const rStartY = e.clientY;
          const startWidth = annot.width || (annot.type === 'shape' ? 120 : (annot.type === 'redact' ? 140 : 160));
          const startHeight = annot.height || (annot.type === 'shape' ? 60 : (annot.type === 'redact' ? 30 : 70));
          const startFontSize = annot.fontSize || 48;
          const startX = annot.x;
          const startY = annot.y;
          const isProportional = (annot.type === 'signature' || annot.type === 'image' || annot.type === 'stamp');
          const isWatermark = (annot.type === 'watermark');
          const aspectRatio = startWidth / (startHeight || 1);

          // Center coordinates for angle-agnostic proportional scaling
          const rotWrapper = el.querySelector('.annot-rot-wrapper');
          const rRect = (rotWrapper || el).getBoundingClientRect();
          const screenCenterX = rRect.left + rRect.width / 2;
          const screenCenterY = rRect.top + rRect.height / 2;
          const startDist = Math.hypot(rStartX - screenCenterX, rStartY - screenCenterY) || 1;
          const centerPdfX = startX + startWidth / 2;
          const centerPdfY = startY + startHeight / 2;

          document.body.style.userSelect = 'none';

          function onResizeMouseMove(moveEv) {
            if (isWatermark) {
              const currentDist = Math.hypot(moveEv.clientX - screenCenterX, moveEv.clientY - screenCenterY);
              const scale = Math.max(0.3, Math.min(5.0, currentDist / startDist));
              const newFontSize = Math.max(16, Math.min(180, Math.round(startFontSize * scale)));
              annot.fontSize = newFontSize;
              const textEl = el.querySelector('.annot-watermark-text');
              if (textEl) textEl.style.fontSize = newFontSize + 'px';
              const propFontSize = document.getElementById('prop-font-size');
              if (propFontSize && state.selectedAnnotationId === annot.id) propFontSize.value = newFontSize;
              return;
            }

            if (isProportional) {
              const currentDist = Math.hypot(moveEv.clientX - screenCenterX, moveEv.clientY - screenCenterY);
              const scale = Math.max(0.15, Math.min(6.0, currentDist / startDist));
              const newWidth = Math.max(30, Math.round(startWidth * scale));
              const newHeight = Math.max(15, Math.round(newWidth / aspectRatio));
              const newX = Math.round(centerPdfX - newWidth / 2);
              const newY = Math.round(centerPdfY - newHeight / 2);

              annot.width = newWidth;
              annot.height = newHeight;
              annot.x = Math.max(0, newX);
              annot.y = Math.max(0, newY);
              el.style.left = annot.x + 'px';
              el.style.top = annot.y + 'px';

              const img = el.querySelector('img');
              if (img) {
                img.style.width = newWidth + 'px';
                img.style.height = newHeight + 'px';
              }
              const propW = document.getElementById('prop-img-w');
              const propH = document.getElementById('prop-img-h');
              if (propW && state.selectedAnnotationId === annot.id) propW.value = newWidth;
              if (propH && state.selectedAnnotationId === annot.id) propH.value = newHeight;
              positionPopoverPill(annot);
              return;
            }

            const dx = moveEv.clientX - rStartX;
            const dy = moveEv.clientY - rStartY;

            let newWidth = startWidth;
            let newHeight = startHeight;
            let newX = startX;
            let newY = startY;

            if (direction === 'se') {
              newWidth = Math.max(30, Math.round(startWidth + dx));
              newHeight = Math.max(15, Math.round(startHeight + dy));
            } else if (direction === 'sw') {
              newWidth = Math.max(30, Math.round(startWidth - dx));
              newHeight = Math.max(15, Math.round(startHeight + dy));
              newX = startX + (startWidth - newWidth);
            } else if (direction === 'ne') {
              newWidth = Math.max(30, Math.round(startWidth + dx));
              newHeight = Math.max(15, Math.round(startHeight - dy));
              newY = startY + (startHeight - newHeight);
            } else if (direction === 'nw') {
              newWidth = Math.max(30, Math.round(startWidth - dx));
              newHeight = Math.max(15, Math.round(startHeight - dy));
              newX = startX + (startWidth - newWidth);
              newY = startY + (startHeight - newHeight);
            }

            annot.width = newWidth;
            annot.height = newHeight;
            annot.x = Math.max(0, newX);
            annot.y = Math.max(0, newY);
            el.style.left = annot.x + 'px';
            el.style.top = annot.y + 'px';

            if (annot.type === 'redact') {
              const box = el.querySelector('.annot-redact-box');
              if (box) {
                box.style.width = newWidth + 'px';
                box.style.height = newHeight + 'px';
              }
            } else if (annot.type === 'shape') {
              const shapeBox = el.querySelector('.annot-shape-box');
              if (shapeBox) {
                shapeBox.style.width = newWidth + 'px';
                shapeBox.style.height = newHeight + 'px';
                if (annot.shapeType === 'check' || annot.shapeType === 'cross' || annot.shapeType === 'arrow') {
                  shapeBox.style.fontSize = Math.min(newWidth, newHeight) * 0.8 + 'px';
                }
              }
            }
            positionPopoverPill(annot);
          }

          function onResizeMouseUp() {
            document.body.style.userSelect = '';
            document.removeEventListener('mousemove', onResizeMouseMove);
            document.removeEventListener('mouseup', onResizeMouseUp);
            saveHistory();
          }

          document.addEventListener('mousemove', onResizeMouseMove);
          document.addEventListener('mouseup', onResizeMouseUp);
        });
      }

      setupResize(el.querySelector('.annot-resize-handle'), 'se');
      setupResize(el.querySelector('.annot-resize-handle-sw'), 'sw');
      setupResize(el.querySelector('.annot-resize-handle-ne'), 'ne');
      setupResize(el.querySelector('.annot-resize-handle-nw'), 'nw');
    }

    function positionPopoverPill(annot) {
      if (!popoverPill || !pageContainer) return;
      popoverPill.classList.remove('hidden');
      popoverPill.classList.add('flex');

      const el = document.getElementById('annot-' + annot.id);
      const elW = el ? el.offsetWidth : (annot.width || 120);
      const elH = el ? el.offsetHeight : (annot.height || 40);

      const popW = popoverPill.offsetWidth || 380;
      const popH = popoverPill.offsetHeight || 44;

      const pageW = pageContainer.clientWidth;
      const pageH = pageContainer.clientHeight;

      // Position 12px dynamically above element
      let targetLeft = (annot.x || 0) + (elW / 2) - (popW / 2);
      let targetTop = (annot.y || 0) - popH - 12;

      // If near top edge, flip to 12px below the element
      if (targetTop < 8) {
        targetTop = (annot.y || 0) + elH + 12;
      }

      // Clamp within canvas bounds
      targetLeft = Math.max(8, Math.min(pageW - popW - 8, targetLeft));
      targetTop = Math.max(8, Math.min(pageH - popH - 8, targetTop));

      popoverPill.style.left = `${Math.round(targetLeft)}px`;
      popoverPill.style.top = `${Math.round(targetTop)}px`;
    }

    function deselectAnnotation() {
      state.selectedAnnotationId = null;
      if (popoverPill) {
        popoverPill.classList.add('hidden');
        popoverPill.classList.remove('flex');
      }
      document.querySelectorAll('.annot-rot-wrapper').forEach(w => {
        w.classList.remove('ring-2', 'ring-blue-500', 'shadow-md');
        w.classList.add('group-hover:outline', 'group-hover:outline-1', 'group-hover:outline-link');
      });
      document.querySelectorAll('.annot-rotate-handle, .annot-rotate-stem, .annot-action-bar, .annot-resize-handle, .annot-resize-handle-sw, .annot-resize-handle-ne, .annot-resize-handle-nw').forEach(h => {
        h.classList.remove('!opacity-100');
      });
    }

