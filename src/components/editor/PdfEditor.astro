          activeEl.querySelectorAll('.annot-rotate-handle, .annot-rotate-stem, .annot-action-bar, .annot-resize-handle, .annot-resize-handle-sw, .annot-resize-handle-ne, .annot-resize-handle-nw').forEach(h => {
