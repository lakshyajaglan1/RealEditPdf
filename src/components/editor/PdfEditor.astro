    // Rearrange Layer Order (Bring Forward / Send Backward)
    function moveAnnotationLayer(direction) {
      if (!state.selectedAnnotationId || !state.currentPage) return;
      const list = state.annotations[state.currentPage] || [];
      const idx = list.findIndex(a => a.id === state.selectedAnnotationId);
      if (idx === -1) return;

      if (direction === 'forward' && idx < list.length - 1) {
        const item = list.splice(idx, 1)[0];
        list.splice(idx + 1, 0, item);
        saveHistory();
        renderAnnotationsLayer();
      } else if (direction === 'backward' && idx > 0) {
        const item = list.splice(idx, 1)[0];
        list.splice(idx - 1, 0, item);
        saveHistory();
        renderAnnotationsLayer();
      }
    }

    document.getElementById('btn-layer-forward')?.addEventListener('click', () => moveAnnotationLayer('forward'));
    document.getElementById('btn-layer-backward')?.addEventListener('click', () => moveAnnotationLayer('backward'));

    function deleteAnnotation(id) {
      const list = state.annotations[state.currentPage] || [];
      state.annotations[state.currentPage] = list.filter(a => a.id !== id);
      propertyBar?.classList.add('hidden');
      deselectAnnotation();
      renderAnnotationsLayer();
      saveHistory();
    }

    function deleteSelectedAnnotation() {
      if (state.selectedAnnotationId) {
        deleteAnnotation(state.selectedAnnotationId);
      }
    }

    function duplicateSelectedAnnotation() {
      if (!state.selectedAnnotationId || !state.currentPage) return;
      const list = state.annotations[state.currentPage] || [];
      const annot = list.find(a => a.id === state.selectedAnnotationId);
      if (!annot) return;

      const clone = JSON.parse(JSON.stringify(annot));
      clone.id = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      clone.x = (annot.x || 0) + 16;
      clone.y = (annot.y || 0) + 16;
      list.push(clone);
      renderAnnotationsLayer();
      selectAnnotation(clone);
      saveHistory();
      showToast('Element duplicated', 'info', 1200);
    }

    function toggleWhiteoutBackground() {
      if (!state.selectedAnnotationId || !state.currentPage) return;
      const list = state.annotations[state.currentPage] || [];
      const annot = list.find(a => a.id === state.selectedAnnotationId);
      if (!annot || annot.type !== 'text') return;

      annot.bgWhiteout = !annot.bgWhiteout;
      if (annot.bgWhiteout && !annot.customBgColor) {
        annot.customBgColor = '#ffffff';
      }
      updateWhiteoutButtonUI(annot.bgWhiteout);
      renderAnnotationsLayer();
      selectAnnotation(annot);
      saveHistory();
    }

    function updateWhiteoutButtonUI(isWhiteout) {
      const btn = document.getElementById('btn-pop-whiteout');
      const icon = document.getElementById('pop-whiteout-icon');
      if (!btn) return;
      if (isWhiteout) {
        btn.classList.add('bg-blue-500/15', 'text-blue-600', 'border-blue-500/40', 'dark:text-cyan-400');
        btn.classList.remove('bg-canvas', 'text-body', 'border-hairline');
        if (icon) icon.className = 'h-3 w-3 rounded-xs border border-blue-500 bg-white inline-block shadow-2xs';
      } else {
        btn.classList.remove('bg-blue-500/15', 'text-blue-600', 'border-blue-500/40', 'dark:text-cyan-400');
        btn.classList.add('bg-canvas', 'text-body', 'border-hairline');
        if (icon) icon.className = 'h-3 w-3 rounded-xs border border-hairline/80 bg-white inline-block';
      }
    }

    // Render Freehand Drawings
    function renderDrawingsOnCanvas() {
      const ctx = drawCanvas.getContext('2d');
      ctx.clearRect(0, 0, drawCanvas.width, drawCanvas.height);

      const pageAnnots = state.annotations[state.currentPage] || [];
      pageAnnots.filter(a => a.type === 'draw').forEach(drawItem => {
        if (!drawItem.points || drawItem.points.length < 2) return;
        ctx.save();
        ctx.beginPath();
        ctx.strokeStyle = drawItem.color;
        ctx.lineWidth = drawItem.lineWidth * 1.5;
        ctx.globalAlpha = drawItem.opacity !== undefined ? drawItem.opacity : 1.0;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        ctx.moveTo(drawItem.points[0].x * 1.5, drawItem.points[0].y * 1.5);
        for (let i = 1; i < drawItem.points.length; i++) {
          ctx.lineTo(drawItem.points[i].x * 1.5, drawItem.points[i].y * 1.5);
        }
        ctx.stroke();
        ctx.restore();
      });
    }

    // Drawing Interaction on drawCanvas (Mouse & Touch Events)
    function getCanvasPoint(clientX, clientY) {
      const rect = drawCanvas.getBoundingClientRect();
      const scaleFactor = (drawCanvas.width / 1.5) / rect.width;
      return {
        x: (clientX - rect.left) * scaleFactor,
        y: (clientY - rect.top) * scaleFactor,
      };
    }

    function startDrawing(clientX, clientY) {
      if (state.activeTool !== 'draw' && state.activeTool !== 'highlight') return;
      state.isDrawing = true;
      const pt = getCanvasPoint(clientX, clientY);
      state.drawPoints = [pt];
    }

    function continueDrawing(clientX, clientY) {
      if (!state.isDrawing) return;
      const pt = getCanvasPoint(clientX, clientY);
      state.drawPoints.push(pt);

      const ctx = drawCanvas.getContext('2d');
      ctx.save();
      ctx.beginPath();
      const isHighlighter = (state.activeTool === 'highlight');
      ctx.strokeStyle = isHighlighter ? state.activeHighlightColor : state.activeDrawColor;
      ctx.lineWidth = (isHighlighter ? (state.activeHighlightWidth || 24) : state.activeDrawWidth) * 1.5;
      ctx.globalAlpha = isHighlighter ? (state.activeHighlightOpacity !== undefined ? state.activeHighlightOpacity : 0.35) : state.activeDrawOpacity;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      const pts = state.drawPoints;
      if (pts.length >= 2) {
        ctx.moveTo(pts[pts.length - 2].x * 1.5, pts[pts.length - 2].y * 1.5);
        ctx.lineTo(pts[pts.length - 1].x * 1.5, pts[pts.length - 1].y * 1.5);
        ctx.stroke();
      }
      ctx.restore();
    }

    function commitDrawing() {
      if (state.isDrawing && state.drawPoints.length > 1) {
        state.isDrawing = false;
        const isHighlighter = (state.activeTool === 'highlight');
        const newDraw = {
          id: 'draw-' + Date.now(),
          type: 'draw',
          points: [...state.drawPoints],
          color: isHighlighter ? state.activeHighlightColor : state.activeDrawColor,
          lineWidth: isHighlighter ? (state.activeHighlightWidth || 24) : state.activeDrawWidth,
          opacity: isHighlighter ? (state.activeHighlightOpacity !== undefined ? state.activeHighlightOpacity : 0.35) : state.activeDrawOpacity,
        };
        state.annotations[state.currentPage].push(newDraw);
        saveHistory();
        renderDrawingsOnCanvas();
      }
      state.isDrawing = false;
    }

    drawCanvas.addEventListener('mousedown', (e) => startDrawing(e.clientX, e.clientY));
    drawCanvas.addEventListener('mousemove', (e) => continueDrawing(e.clientX, e.clientY));
    drawCanvas.addEventListener('mouseup', commitDrawing);
    drawCanvas.addEventListener('mouseleave', commitDrawing);

    // Touch support for touchscreen laptops, iPads, & mobile devices
    drawCanvas.addEventListener('touchstart', (e) => {
      if (e.touches && e.touches.length === 1) {
        e.preventDefault();
        startDrawing(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: false });

    drawCanvas.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches.length === 1 && state.isDrawing) {
        e.preventDefault();
        continueDrawing(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: false });

    drawCanvas.addEventListener('touchend', (e) => {
      e.preventDefault();
      commitDrawing();
    });
    drawCanvas.addEventListener('touchcancel', commitDrawing);

    // Insertion Helpers
    function insertTextAnnotation(customX, customY, options = {}) {
      if (!state.currentPage || !state.pdfDocProxy) {
        alert(editorStrings.addTextAlert);
        return;
      }
      if (!state.annotations[state.currentPage]) {
        state.annotations[state.currentPage] = [];
      }
      const displayW = renderCanvas.width / 1.5 || 600;
      const displayH = renderCanvas.height / 1.5 || 800;
      const x = customX !== undefined ? customX : Math.max(30, Math.round((displayW - 200) / 2));
      const y = customY !== undefined ? customY : Math.max(30, Math.round((displayH - 40) / 3));

      const newText = {
        id: 'txt-' + Date.now(),
        type: 'text',
        x,
        y,
        text: options.text || editorStrings.typeTextPlaceholder,
        fontSize: options.fontSize || parseInt(document.getElementById('prop-font-size')?.value || '16', 10),
        color: options.color || state.activeDrawColor || '#171717',
        fontFamily: options.fontFamily || document.getElementById('prop-font-family')?.value || 'Geist, sans-serif',
        bgWhiteout: options.bgWhiteout !== undefined ? options.bgWhiteout : false,
        customBgColor: options.customBgColor || '#ffffff',
        width: options.width,
        height: options.height,
      };

      state.annotations[state.currentPage].push(newText);
      saveHistory();
      renderAnnotationsLayer();
      selectAnnotation(newText);

      // Auto-focus and select all placeholder text so user can write immediately
      setTimeout(() => {
        const textWrapper = document.getElementById('annot-' + newText.id);
        if (textWrapper) {
          const content = textWrapper.querySelector('.annot-text-content');
          if (content) {
            content.focus();
            const range = document.createRange();
            range.selectNodeContents(content);
            const sel = window.getSelection();
            if (sel) {
              sel.removeAllRanges();
              sel.addRange(range);
            }
          }
        }
      }, 50);
    }

    function insertShapeAnnotation(shapeType, customX, customY) {
      if (!state.currentPage || !state.pdfDocProxy) {
        alert(editorStrings.addShapeAlert);
        return;
      }
      if (!state.annotations[state.currentPage]) {
        state.annotations[state.currentPage] = [];
      }
      const type = shapeType || state.activeShape || 'rect';
      state.activeShape = type;
      const displayW = renderCanvas.width / 1.5 || 600;
      const displayH = renderCanvas.height / 1.5 || 800;
      const w = (type === 'line' || type === 'arrow') ? 160 : (type === 'circle' ? 90 : 130);
      const h = (type === 'line') ? 4 : (type === 'circle' ? 90 : (type === 'arrow' ? 40 : 70));

      const x = customX !== undefined ? customX : Math.max(30, Math.round((displayW - w) / 2));
      const y = customY !== undefined ? customY : Math.max(30, Math.round((displayH - h) / 3));

      const newShape = {
        id: 'shp-' + Date.now(),
        type: 'shape',
        shapeType: type,
        x,
        y,
        width: w,
        height: h,
        color: state.activeDrawColor || '#171717',
        strokeWidth: parseInt(document.getElementById('prop-stroke-width')?.value || '2', 10),
        opacity: parseFloat(document.getElementById('prop-opacity')?.value || '1.0'),
      };

      state.annotations[state.currentPage].push(newShape);
      saveHistory();
      renderAnnotationsLayer();
      selectAnnotation(newShape);
    }

    function insertRedactAnnotation(customX, customY) {
      if (!state.currentPage || !state.pdfDocProxy) {
        alert(editorStrings.addRedactAlert);
        return;
      }
      if (!state.annotations[state.currentPage]) {
        state.annotations[state.currentPage] = [];
      }
      const displayW = renderCanvas.width / 1.5 || 600;
      const displayH = renderCanvas.height / 1.5 || 800;
      const w = 150;
      const h = 32;

      const x = customX !== undefined ? customX : Math.max(30, Math.round((displayW - w) / 2));
      const y = customY !== undefined ? customY : Math.max(30, Math.round((displayH - h) / 3));

      const newRedact = {
        id: 'red-' + Date.now(),
        type: 'redact',
        x,
        y,
        width: w,
        height: h,
      };

      state.annotations[state.currentPage].push(newRedact);
      saveHistory();
      renderAnnotationsLayer();
      selectAnnotation(newRedact);
    }

    function insertStickyAnnotation(customX, customY, options = {}) {
      if (!state.currentPage || !state.pdfDocProxy) {
        alert(editorStrings.addTextAlert || 'Please select a page first');
        return;
      }
      if (!state.annotations[state.currentPage]) {
        state.annotations[state.currentPage] = [];
      }
      const displayW = renderCanvas.width / 1.5 || 600;
      const displayH = renderCanvas.height / 1.5 || 800;
      const w = 210;
      const h = 130;

      const x = customX !== undefined ? customX : Math.max(30, Math.round((displayW - w) / 2));
      const y = customY !== undefined ? customY : Math.max(30, Math.round((displayH - h) / 3));

      const newSticky = {
        id: 'stk-' + Date.now(),
        type: 'sticky',
        x,
        y,
        width: w,
        height: h,
        text: options.text || '',
        author: options.author || 'Reviewer',
        noteColor: options.noteColor || '#fef08a',
        stickyExpanded: true,
        exportAsPdfAnnotation: true,
      };

      state.annotations[state.currentPage].push(newSticky);
      saveHistory();
      renderAnnotationsLayer();
      selectAnnotation(newSticky);

      setTimeout(() => {
        const input = document.getElementById('sticky-input-' + newSticky.id);
        input?.focus();
      }, 50);
    }

    // Canvas click to add element or deselect
    annotationsLayer.addEventListener('click', async (e) => {
      if (e.target !== annotationsLayer) return;
      if (state.activeTool === 'select') {
        deselectAnnotation();
        return;
      }
      const rect = annotationsLayer.getBoundingClientRect();
      const x = Math.max(10, Math.round(e.clientX - rect.left));
      const y = Math.max(10, Math.round(e.clientY - rect.top));

      if (state.activeTool === 'text') {
        if (state.pdfDocProxy && state.currentPage) {
          try {
            const page = await state.pdfDocProxy.getPage(state.currentPage);
            const inspected = await inspectTextAtPoint(page, renderCanvas, { x, y }, {
              scale: state.scale,
              rotation: state.pageRotations[state.currentPage] || 0,
            });
            if (inspected && inspected.text) {
              insertTextAnnotation(inspected.box.x, inspected.box.y, {
                text: inspected.text,
                fontSize: inspected.fontSize,
                bgWhiteout: true,
                customBgColor: inspected.bgColor,
                width: inspected.box.width,
                height: inspected.box.height,
              });
              showToast('Sampled text & background for whiteout edit', 'info', 1800);
              return;
            }
          } catch (err) {
            console.warn('Text inspect error:', err);
          }
        }
        insertTextAnnotation(x, y);
      } else if (state.activeTool === 'shape') {
        insertShapeAnnotation(state.activeShape, x, y);
      } else if (state.activeTool === 'redact') {
        insertRedactAnnotation(x, y);
      } else if (state.activeTool === 'sticky') {
        insertStickyAnnotation(x, y);
      }
    });

    pageContainer?.addEventListener('click', (e) => {
      if (e.target === pageContainer || e.target === renderCanvas || e.target === drawCanvas) {
        deselectAnnotation();
      }
    });

    // Reorder Pages in PDF
    async function reorderPages(fromIndex, toIndex) {
      if (fromIndex === toIndex || fromIndex < 1 || toIndex < 1 || fromIndex > state.totalPages || toIndex > state.totalPages) return;
      showLoading(`${editorStrings.movingPage} ${fromIndex} - ${toIndex}...`);
      try {
        const { PDFDocument } = window.PDFLib;
        const srcDoc = await PDFDocument.load(state.pdfBytes);
        const newDoc = await PDFDocument.create();

        // 0-indexed list of page indices
        const pageIndices = Array.from({ length: state.totalPages }, (_, i) => i);
        const [moved] = pageIndices.splice(fromIndex - 1, 1);
        pageIndices.splice(toIndex - 1, 0, moved);

        const copiedPages = await newDoc.copyPages(srcDoc, pageIndices);
        for (const page of copiedPages) {
          newDoc.addPage(page);
        }

        const oldAnnotations = { ...state.annotations };
        const oldRotations = { ...state.pageRotations };
        const newAnnotations = {};
        const newRotations = {};

        pageIndices.forEach((origIdx, newZeroIdx) => {
          const newP = newZeroIdx + 1;
          const oldP = origIdx + 1;
          newAnnotations[newP] = oldAnnotations[oldP] || [];
          newRotations[newP] = oldRotations[oldP] || 0;
        });

        const newBytes = await newDoc.save();
        state.pdfBytes = newBytes.slice();
        const loadingTask = window.pdfjsLib.getDocument({ data: state.pdfBytes.slice() });
        state.pdfDocProxy = await loadingTask.promise;
        state.totalPages = state.pdfDocProxy.numPages;
        state.currentPage = toIndex;
        state.annotations = newAnnotations;
        state.pageRotations = newRotations;

        sidebarCount.textContent = state.totalPages;
        totPageSpan.textContent = state.totalPages;
        saveHistory();
        await renderThumbnails();
        await renderCurrentPage();
      } catch (err) {
        console.error('Failed to reorder pages:', err);
        alert(editorStrings.reorderFailed + err.message);
      } finally {
        hideLoading();
      }
    }

    // Render Left Thumbnails with Reordering (Drag & Drop + Up/Down buttons)
    async function renderThumbnails() {
      thumbnailsList.innerHTML = '';
      for (let p = 1; p <= state.totalPages; p++) {
        const thumbCard = document.createElement('div');
        thumbCard.className = `thumb-card relative rounded-md border p-2 bg-canvas-elevated cursor-pointer transition-all hover:border-ink ${p === state.currentPage ? 'border-link ring-1 ring-link' : 'border-hairline'}`;
        thumbCard.dataset.page = p;
        thumbCard.draggable = true;

        thumbCard.innerHTML = `
          <div class="flex items-center justify-between pb-1.5 text-[11px] font-mono text-mute">
            <span class="font-medium text-ink flex items-center gap-1">
              <span class="cursor-grab active:cursor-grabbing text-mute/70 hover:text-ink select-none" title="Drag to reorder">⋮⋮</span>
              ${editorStrings.page} ${p}
            </span>
            <div class="flex items-center gap-1">
              <button class="thumb-up-btn h-6 w-6 rounded bg-canvas border border-hairline hover:bg-hairline-soft text-ink flex items-center justify-center text-[10px] font-bold shadow-xs disabled:opacity-20 disabled:pointer-events-none transition-all cursor-pointer" title="Move Page Up" ${p === 1 ? 'disabled' : ''}>▲</button>
              <button class="thumb-down-btn h-6 w-6 rounded bg-canvas border border-hairline hover:bg-hairline-soft text-ink flex items-center justify-center text-[10px] font-bold shadow-xs disabled:opacity-20 disabled:pointer-events-none transition-all cursor-pointer" title="Move Page Down" ${p === state.totalPages ? 'disabled' : ''}>▼</button>
              <button class="thumb-reset-btn h-6 w-6 rounded bg-canvas border border-hairline hover:bg-amber-50 dark:hover:bg-amber-950/40 text-mute hover:text-amber-600 dark:hover:text-amber-400 flex items-center justify-center text-xs shadow-xs font-bold transition-all hover:scale-105 cursor-pointer" title="Reset changes on Page ${p}">↺</button>
              <button class="thumb-rotate-btn h-6 w-6 rounded bg-canvas border border-hairline hover:bg-hairline-soft text-ink flex items-center justify-center text-xs shadow-xs font-bold transition-all hover:scale-105 cursor-pointer" title="Rotate Page 90°">↻</button>
              <button class="thumb-del-btn h-6 w-6 rounded bg-canvas border border-hairline hover:bg-rose-50 dark:hover:bg-rose-950/40 text-mute hover:text-rose-600 dark:hover:text-rose-400 flex items-center justify-center text-xs shadow-xs font-bold transition-all hover:scale-105 cursor-pointer" title="Delete Page">✕</button>
            </div>
          </div>
          <div class="flex items-center justify-center bg-hairline-soft/50 rounded-xs overflow-hidden h-28 pointer-events-none">
            <canvas id="thumb-canvas-${p}" class="max-h-full max-w-full shadow-xs"></canvas>
          </div>
        `;

        // Move Up Action
        thumbCard.querySelector('.thumb-up-btn')?.addEventListener('click', async (e) => {
          e.stopPropagation();
          await reorderPages(p, p - 1);
        });

        // Move Down Action
        thumbCard.querySelector('.thumb-down-btn')?.addEventListener('click', async (e) => {
          e.stopPropagation();
          await reorderPages(p, p + 1);
        });

        // Reset Page Action
        thumbCard.querySelector('.thumb-reset-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          resetPageChanges(p);
        });

        // Drag and Drop reordering
        thumbCard.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', String(p));
          e.dataTransfer.effectAllowed = 'move';
          thumbCard.classList.add('opacity-50', 'ring-2', 'ring-blue-500');
        });

        thumbCard.addEventListener('dragend', () => {
          thumbCard.classList.remove('opacity-50', 'ring-2', 'ring-blue-500');
          document.querySelectorAll('.thumb-card').forEach(c => c.classList.remove('border-blue-500', 'bg-blue-50/20'));
        });

        thumbCard.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          thumbCard.classList.add('border-blue-500', 'bg-blue-50/20');
        });

        thumbCard.addEventListener('dragleave', () => {
          thumbCard.classList.remove('border-blue-500', 'bg-blue-50/20');
        });

        thumbCard.addEventListener('drop', async (e) => {
          e.preventDefault();
          thumbCard.classList.remove('border-blue-500', 'bg-blue-50/20');
          const draggedFrom = parseInt(e.dataTransfer.getData('text/plain'), 10);
          if (draggedFrom && draggedFrom !== p) {
            await reorderPages(draggedFrom, p);
          }
        });

        // Rotate Action
        thumbCard.querySelector('.thumb-rotate-btn').addEventListener('click', (e) => {
          e.stopPropagation();
          state.pageRotations[p] = ((state.pageRotations[p] || 0) + 90) % 360;
          saveHistory();
          renderCurrentPage();
          renderSingleThumbnail(p);
        });

        // Delete Page Action
        thumbCard.querySelector('.thumb-del-btn').addEventListener('click', async (e) => {
          e.stopPropagation();
          if (state.totalPages <= 1) {
            alert(editorStrings.onlyPageDelete);
            return;
          }
          if (confirm(`${editorStrings.deletePageConfirm} ${p}?`)) {
            await deletePage(p);
          }
        });

        thumbCard.addEventListener('click', () => {
          state.currentPage = p;
          renderCurrentPage();
        });

        thumbnailsList.appendChild(thumbCard);
        renderSingleThumbnail(p);
      }
    }

    async function renderSingleThumbnail(p) {
      if (!state.pdfDocProxy) return;
      try {
        const page = await state.pdfDocProxy.getPage(p);
        const rotation = (page.rotate + (state.pageRotations[p] || 0)) % 360;
        const viewport = page.getViewport({ scale: 0.25, rotation });
        const canvas = document.getElementById('thumb-canvas-' + p);
        if (canvas) {
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const ctx = canvas.getContext('2d');
          await page.render({ canvasContext: ctx, viewport }).promise;
        }
      } catch (e) {
        console.error('Thumb render error', e);
      }
    }

    function highlightActiveThumbnail() {
      document.querySelectorAll('.thumb-card').forEach(card => {
        const p = parseInt(card.dataset.page);
        if (p === state.currentPage) {
          card.classList.add('border-link', 'ring-1', 'ring-link');
          card.classList.remove('border-hairline');
        } else {
          card.classList.remove('border-link', 'ring-1', 'ring-link');
          card.classList.add('border-hairline');
        }
      });
    }

    async function deletePage(pageIndex) {
      showLoading(editorStrings.deletingPage + '...');
      try {
        const { PDFDocument } = window.PDFLib;
        const srcDoc = await PDFDocument.load(state.pdfBytes);
        srcDoc.removePage(pageIndex - 1);
        const newBytes = await srcDoc.save();

        const oldAnnotations = { ...state.annotations };
        const oldRotations = { ...state.pageRotations };
        const newAnnotations = {};
        const newRotations = {};
        const newTotal = srcDoc.getPageCount();

        for (let p = 1; p <= newTotal; p++) {
          if (p < pageIndex) {
            newAnnotations[p] = oldAnnotations[p] || [];
            newRotations[p] = oldRotations[p] || 0;
          } else {
            newAnnotations[p] = oldAnnotations[p + 1] || [];
            newRotations[p] = oldRotations[p + 1] || 0;
          }
        }

        state.pdfBytes = newBytes.slice();
        const loadingTask = window.pdfjsLib.getDocument({ data: state.pdfBytes.slice() });
        state.pdfDocProxy = await loadingTask.promise;
        state.totalPages = state.pdfDocProxy.numPages;
        state.currentPage = Math.min(state.currentPage, state.totalPages);
        state.annotations = newAnnotations;
        state.pageRotations = newRotations;

        sidebarCount.textContent = state.totalPages;
        totPageSpan.textContent = state.totalPages;
        saveHistory();
        await renderThumbnails();
        await renderCurrentPage();
      } catch (err) {
        alert(editorStrings.deleteFailed + err.message);
      } finally {
        hideLoading();
      }
    }

    // Page Rotation Handler (Toolbar & Floating Nav)
    function rotateCurrentPage() {
      if (!state.currentPage) return;
      state.pageRotations[state.currentPage] = ((state.pageRotations[state.currentPage] || 0) + 90) % 360;
      saveHistory();
      renderCurrentPage();
      renderSingleThumbnail(state.currentPage);
    }

    const btnRotatePage = document.getElementById('btn-rotate-page');
    const btnFloatingRotate = document.getElementById('btn-floating-rotate');
    btnRotatePage?.addEventListener('click', rotateCurrentPage);
    btnFloatingRotate?.addEventListener('click', rotateCurrentPage);

    // Highlight & Draw Synchronization Helpers
    function updateHighlightSettings(width, opacity, color) {
      if (width !== undefined) state.activeHighlightWidth = parseInt(width, 10);
      if (opacity !== undefined) state.activeHighlightOpacity = parseFloat(opacity);
      if (color !== undefined) state.activeHighlightColor = color;

      const w = state.activeHighlightWidth;
      const op = state.activeHighlightOpacity;
      const c = state.activeHighlightColor;
      const opPct = Math.round(op * 100) + '%';

      // Property bar elements
      const propHlSize = document.getElementById('prop-highlight-size');
      const propHlSizeVal = document.getElementById('prop-highlight-size-val');
      const propHlOp = document.getElementById('prop-highlight-opacity');
      const propHlOpVal = document.getElementById('prop-highlight-opacity-val');
      const propHlPrev = document.getElementById('prop-highlight-preview');
      const propHlColorPicker = document.getElementById('prop-highlight-color-picker');

      if (propHlSize) propHlSize.value = w;
      if (propHlSizeVal) propHlSizeVal.textContent = w + 'px';
      if (propHlOp) propHlOp.value = op;
      if (propHlOpVal) propHlOpVal.textContent = opPct;
      if (propHlPrev) {
        propHlPrev.style.backgroundColor = c;
        propHlPrev.style.opacity = op;
        propHlPrev.style.height = Math.min(20, Math.max(4, Math.round(w * 0.35))) + 'px';
      }
      if (propHlColorPicker) propHlColorPicker.value = c;

      // Dropdown elements
      const dropHlSize = document.getElementById('dropdown-hl-size');
      const dropHlSizeVal = document.getElementById('dropdown-hl-size-val');
      const dropHlOp = document.getElementById('dropdown-hl-intensity');
      const dropHlOpVal = document.getElementById('dropdown-hl-intensity-val');
      const dropHlPrev = document.getElementById('dropdown-hl-preview-bar');
      const dropHlColorPicker = document.getElementById('dropdown-hl-color-picker');

      if (dropHlSize) dropHlSize.value = w;
      if (dropHlSizeVal) dropHlSizeVal.textContent = w + 'px';
      if (dropHlOp) dropHlOp.value = op;
      if (dropHlOpVal) dropHlOpVal.textContent = opPct;
      if (dropHlPrev) {
        dropHlPrev.style.backgroundColor = c;
        dropHlPrev.style.opacity = op;
        dropHlPrev.style.height = Math.min(22, Math.max(4, Math.round(w * 0.35))) + 'px';
      }
      if (dropHlColorPicker) dropHlColorPicker.value = c;

      // Indicator on toolbar button
      const ind = document.getElementById('highlight-color-indicator');
      if (ind) ind.style.backgroundColor = c;
    }

    function updateDrawSettings(width, opacity, color) {
      if (width !== undefined) state.activeDrawWidth = parseInt(width, 10);
      if (opacity !== undefined) state.activeDrawOpacity = parseFloat(opacity);
      if (color !== undefined) state.activeDrawColor = color;

      const w = state.activeDrawWidth;
      const op = state.activeDrawOpacity;
      const c = state.activeDrawColor;
      const opPct = Math.round(op * 100) + '%';

      // Property bar elements
      const propDrawSize = document.getElementById('prop-draw-size');
      const propDrawSizeVal = document.getElementById('prop-draw-size-val');
      const propDrawOp = document.getElementById('prop-draw-opacity');
      const propDrawOpVal = document.getElementById('prop-draw-opacity-val');
      const propDrawPrev = document.getElementById('prop-draw-preview');
      const propColorPicker = document.getElementById('prop-color-picker');

      if (propDrawSize) propDrawSize.value = w;
      if (propDrawSizeVal) propDrawSizeVal.textContent = w + 'px';
      if (propDrawOp) propDrawOp.value = op;
      if (propDrawOpVal) propDrawOpVal.textContent = opPct;
      if (propDrawPrev) {
        propDrawPrev.style.backgroundColor = c;
        propDrawPrev.style.opacity = op;
        const dotSize = Math.min(20, Math.max(3, w));
        propDrawPrev.style.height = dotSize + 'px';
        propDrawPrev.style.width = dotSize + 'px';
      }
      if (propColorPicker) propColorPicker.value = c;

      // Dropdown elements
      const dropDrawSize = document.getElementById('dropdown-draw-size');
      const dropDrawSizeVal = document.getElementById('dropdown-draw-size-val');
      const dropDrawOp = document.getElementById('dropdown-draw-opacity');
      const dropDrawOpVal = document.getElementById('dropdown-draw-opacity-val');
      const dropDrawDot = document.getElementById('dropdown-draw-preview-dot');
      const dropDrawColorPicker = document.getElementById('dropdown-draw-color-picker');

      if (dropDrawSize) dropDrawSize.value = w;
      if (dropDrawSizeVal) dropDrawSizeVal.textContent = w + 'px';
      if (dropDrawOp) dropDrawOp.value = op;
      if (dropDrawOpVal) dropDrawOpVal.textContent = opPct;
      if (dropDrawDot) {
        dropDrawDot.style.backgroundColor = c;
        dropDrawDot.style.opacity = op;
        const dotSize = Math.min(20, Math.max(3, w));
        dropDrawDot.style.height = dotSize + 'px';
        dropDrawDot.style.width = dotSize + 'px';
      }
      if (dropDrawColorPicker) dropDrawColorPicker.value = c;

      // Indicator on toolbar button
      const ind = document.getElementById('draw-color-indicator');
      if (ind) ind.style.backgroundColor = c;
    }

    // Tool switching
    function setTool(toolName) {
      state.activeTool = toolName;
      document.querySelectorAll('.tool-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = (toolName === 'shape') ? document.getElementById('tool-shape-btn') : document.getElementById('tool-' + toolName);
      if (activeBtn) activeBtn.classList.add('active');

      const fontGroup = document.getElementById('prop-font-group');
      const strokeGroup = document.getElementById('prop-stroke-group');
      const opacityGroup = document.getElementById('prop-opacity-group');
      const imageGroup = document.getElementById('prop-image-group');
      const colorGroup = document.getElementById('prop-color-group');
      const rotateGroup = document.getElementById('prop-rotate-group');
      const wmLayerGroup = document.getElementById('prop-watermark-layer-group');
      const hlGroup = document.getElementById('prop-highlight-group');
      const hlColorGroup = document.getElementById('prop-highlight-color-group');
      const drawGroup = document.getElementById('prop-draw-group');
      const layerGroup = document.getElementById('prop-layer-group');
      const redactGroup = document.getElementById('prop-redact-group');
      const delParent = document.getElementById('btn-delete-element')?.parentElement;

      if (toolName === 'draw') {
        deselectAnnotation();

        drawCanvas.style.pointerEvents = 'auto';
        drawCanvas.classList.remove('pointer-events-none');
        drawCanvas.classList.add('cursor-crosshair');
        annotationsLayer.style.pointerEvents = 'none';
        annotationsLayer.classList.remove('cursor-crosshair');

        propertyBar?.classList.remove('hidden');
        const inspectorType = document.getElementById('inspector-element-type');
        if (inspectorType) inspectorType.textContent = editorStrings.freehandPen;

        if (redactGroup) { redactGroup.classList.add('hidden'); redactGroup.classList.remove('flex'); }
        if (drawGroup) { drawGroup.classList.remove('hidden'); drawGroup.classList.add('flex'); }
        if (colorGroup) { colorGroup.classList.remove('hidden'); colorGroup.classList.add('flex'); }
        if (hlGroup) hlGroup.classList.add('hidden');
        if (hlColorGroup) hlColorGroup.classList.add('hidden');
        if (fontGroup) fontGroup.classList.add('hidden');
        if (imageGroup) imageGroup.classList.add('hidden');
        if (strokeGroup) strokeGroup.classList.add('hidden');
        if (opacityGroup) opacityGroup.classList.add('hidden');
        if (rotateGroup) { rotateGroup.classList.add('hidden'); rotateGroup.classList.remove('flex'); }
        if (wmLayerGroup) { wmLayerGroup.classList.add('hidden'); wmLayerGroup.classList.remove('flex'); }
        if (layerGroup) { layerGroup.classList.add('hidden'); layerGroup.classList.remove('flex'); }
        if (delParent) delParent.classList.add('hidden');

        updateDrawSettings(state.activeDrawWidth, state.activeDrawOpacity, state.activeDrawColor);
      } else if (toolName === 'highlight') {
        deselectAnnotation();

        drawCanvas.style.pointerEvents = 'auto';
        drawCanvas.classList.remove('pointer-events-none');
        drawCanvas.classList.add('cursor-crosshair');
        annotationsLayer.style.pointerEvents = 'none';
        annotationsLayer.classList.remove('cursor-crosshair');

        propertyBar?.classList.remove('hidden');
        const inspectorType = document.getElementById('inspector-element-type');
        if (inspectorType) inspectorType.textContent = editorStrings.highlighter;

        if (redactGroup) { redactGroup.classList.add('hidden'); redactGroup.classList.remove('flex'); }
        if (hlGroup) { hlGroup.classList.remove('hidden'); hlGroup.classList.add('flex'); }
        if (hlColorGroup) { hlColorGroup.classList.remove('hidden'); hlColorGroup.classList.add('flex'); }
        if (drawGroup) drawGroup.classList.add('hidden');
        if (colorGroup) colorGroup.classList.add('hidden');
        if (fontGroup) fontGroup.classList.add('hidden');
        if (imageGroup) imageGroup.classList.add('hidden');
        if (strokeGroup) strokeGroup.classList.add('hidden');
        if (opacityGroup) opacityGroup.classList.add('hidden');
        if (rotateGroup) { rotateGroup.classList.add('hidden'); rotateGroup.classList.remove('flex'); }
        if (wmLayerGroup) { wmLayerGroup.classList.add('hidden'); wmLayerGroup.classList.remove('flex'); }
        if (layerGroup) { layerGroup.classList.add('hidden'); layerGroup.classList.remove('flex'); }
        if (delParent) delParent.classList.add('hidden');

        updateHighlightSettings(state.activeHighlightWidth, state.activeHighlightOpacity, state.activeHighlightColor);
      } else if (toolName === 'redact') {
        deselectAnnotation();

        drawCanvas.style.pointerEvents = 'none';
        drawCanvas.classList.add('pointer-events-none');
        drawCanvas.classList.remove('cursor-crosshair');
        annotationsLayer.style.pointerEvents = 'auto';
        annotationsLayer.classList.add('cursor-crosshair');

        propertyBar?.classList.remove('hidden');
        const inspectorType = document.getElementById('inspector-element-type');
