    // File Input Upload, Drag/Drop & Clipboard Paste Handling
    async function handleSelectedFile(file) {
      if (!file) return;
      const isPdf = file.type === 'application/pdf' || file.type.includes('pdf') || (file.name && file.name.toLowerCase().endsWith('.pdf'));
      const isImage = file.type.startsWith('image/');

      if (isPdf) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          loadPdfBuffer(ev.target.result);
        };
        reader.readAsArrayBuffer(file);
      } else if (isImage) {
        if (!state.pdfDocProxy) {
          // Convert image to standalone 1-page PDF document
          showLoading('Converting image to PDF document...');
          try {
            const reader = new FileReader();
            reader.onload = async (ev) => {
              try {
                const imgBuffer = ev.target.result;
                const { PDFDocument } = window.PDFLib;
                const pdfDoc = await PDFDocument.create();
                let embeddedImg;

                if (file.type === 'image/png') {
                  embeddedImg = await pdfDoc.embedPng(imgBuffer);
                } else if (file.type === 'image/jpeg' || file.type === 'image/jpg') {
                  embeddedImg = await pdfDoc.embedJpg(imgBuffer);
                } else {
                  // Other image formats (webp, bmp, etc.): convert via canvas to PNG first
                  const imgElem = new Image();
                  const blobUrl = URL.createObjectURL(file);
                  await new Promise((res, rej) => {
                    imgElem.onload = res;
                    imgElem.onerror = rej;
                    imgElem.src = blobUrl;
                  });
                  const c = document.createElement('canvas');
                  c.width = imgElem.width;
                  c.height = imgElem.height;
                  const ctx = c.getContext('2d');
                  ctx.drawImage(imgElem, 0, 0);
                  URL.revokeObjectURL(blobUrl);
                  const pngDataUrl = c.toDataURL('image/png');
                  const pngBytes = await (await fetch(pngDataUrl)).arrayBuffer();
                  embeddedImg = await pdfDoc.embedPng(pngBytes);
                }

                const dims = embeddedImg.scale(1);
                const page = pdfDoc.addPage([dims.width, dims.height]);
                page.drawImage(embeddedImg, {
                  x: 0,
                  y: 0,
                  width: dims.width,
                  height: dims.height,
                });
                const pdfBytes = await pdfDoc.save();
                await loadPdfBuffer(pdfBytes);
                showToast('Image converted to PDF successfully!', 'success');
              } catch (err) {
                console.error('Failed to convert image to PDF:', err);
                showToast('Could not convert image to PDF', 'error');
              } finally {
                hideLoading();
              }
            };
            reader.readAsArrayBuffer(file);
          } catch (err) {
            hideLoading();
            alert('Failed to process image: ' + err.message);
          }
        } else {
          // A PDF is already open: insert the image onto current page
          const reader = new FileReader();
          reader.onload = (ev) => {
            const newImg = {
              id: 'img-' + Date.now(),
              type: 'image',
              src: ev.target.result,
              x: 80,
              y: 80,
              width: 220,
              height: 160,
            };
            state.annotations[state.currentPage].push(newImg);
            state.selectedAnnotationId = newImg.id;
            saveHistory();
            renderAnnotationsLayer();
            selectAnnotation(newImg);
            showToast('Image inserted onto page!', 'success');
          };
          reader.readAsDataURL(file);
        }
      } else {
        alert(editorStrings.loadPdfFirst);
      }
    }

