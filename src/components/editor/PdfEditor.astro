        const targetScale = Math.max(0.4, Math.min(3.0, state.scale + zoomStep));
        if (Math.abs(targetScale - state.scale) > 0.01) {
          state.scale = parseFloat(targetScale.toFixed(2));
          zoomPct.textContent = Math.round(state.scale * 100) + '%';

