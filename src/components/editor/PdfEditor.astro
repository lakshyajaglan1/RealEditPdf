    const propColorPicker = document.getElementById('prop-color-picker');
    propColorPicker?.addEventListener('input', (e) => {
      const color = e.target.value;
      if (state.activeTool === 'highlight') {
        state.activeHighlightColor = color;
        const ind = document.getElementById('highlight-color-indicator');
        if (ind) ind.style.backgroundColor = color;
