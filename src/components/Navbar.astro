---
interface Props {
  activeTool?: string;
}

const { activeTool = 'editor' } = Astro.props;
---

<header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo & Brand -->
    <div class="flex items-center gap-6">
      <a href="/" class="group flex items-center gap-2.5 transition-opacity hover:opacity-90">
        <div class="flex h-8 w-8 items-center justify-center rounded-sm bg-ink text-on-primary font-bold tracking-tight shadow-whisper transition-transform group-hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-[15px] font-semibold tracking-tight text-ink">RealPdfEdit</span>
        </div>
      </a>

      <!-- Privacy Guarantee Pill Badge -->
      <div class="hidden md:flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-2.5 py-0.5 text-[11px] font-medium text-body shadow-whisper">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#10b981]"></span>
        </span>
        <span>100% Client-Side Private</span>
      </div>
    </div>

    <!-- Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 text-[13px] font-medium text-body">
      <a
        href="/"
        class={`rounded-full px-3 py-1.5 transition-colors hover:text-ink ${activeTool === 'editor' ? 'bg-canvas-elevated text-ink font-semibold border border-hairline shadow-whisper' : 'hover:bg-hairline-soft'}`}
      >
        PDF Editor
      </a>
      <a
        href="/merge-pdf"
        class={`rounded-full px-3 py-1.5 transition-colors hover:text-ink ${activeTool === 'merge' ? 'bg-canvas-elevated text-ink font-semibold border border-hairline shadow-whisper' : 'hover:bg-hairline-soft'}`}
      >
        Merge
      </a>
      <a
        href="/split-pdf"
        class={`rounded-full px-3 py-1.5 transition-colors hover:text-ink ${activeTool === 'split' ? 'bg-canvas-elevated text-ink font-semibold border border-hairline shadow-whisper' : 'hover:bg-hairline-soft'}`}
      >
        Split
      </a>
      <a
        href="/sign-pdf"
        class={`rounded-full px-3 py-1.5 transition-colors hover:text-ink ${activeTool === 'sign' ? 'bg-canvas-elevated text-ink font-semibold border border-hairline shadow-whisper' : 'hover:bg-hairline-soft'}`}
      >
        Sign Document
      </a>
      <a
        href="/pdf-to-images"
        class={`rounded-full px-3 py-1.5 transition-colors hover:text-ink ${activeTool === 'convert' ? 'bg-canvas-elevated text-ink font-semibold border border-hairline shadow-whisper' : 'hover:bg-hairline-soft'}`}
      >
        PDF to Images
      </a>
      <a
        href="/compress-pdf"
        class={`rounded-full px-3 py-1.5 transition-colors hover:text-ink ${activeTool === 'compress' ? 'bg-canvas-elevated text-ink font-semibold border border-hairline shadow-whisper' : 'hover:bg-hairline-soft'}`}
      >
        Compress
      </a>
      <a
        href="/privacy"
        class={`rounded-full px-3 py-1.5 transition-colors hover:text-ink ${activeTool === 'privacy' ? 'bg-canvas-elevated text-ink font-semibold border border-hairline shadow-whisper' : 'hover:bg-hairline-soft'}`}
      >
        Security & Privacy
      </a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2">
      <!-- Dark/Light Theme Switcher -->
      <button
        id="btn-theme-toggle"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-hairline bg-canvas-elevated text-ink shadow-whisper transition-all hover:bg-hairline-soft"
        title="Toggle Light / Dark Mode"
        aria-label="Toggle theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <div class="hidden sm:flex items-center text-[12px] font-mono text-mute px-2 py-1 rounded-sm bg-hairline-soft">
        <span>No Limits • Free</span>
      </div>

      <a
        href="#editor-anchor"
        id="nav-cta-button"
        class="inline-flex h-8 items-center justify-center rounded-full bg-ink px-3.5 text-[13px] font-medium text-on-primary shadow-whisper transition-all hover:opacity-90 active:scale-95"
      >
        <span>Upload PDF</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggleBtn = document.getElementById('btn-theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    updateIcons();

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        }
        updateIcons();
      });
    }
  });
</script>
