---
interface Props {
  activeTool?: string;
}

const { activeTool = 'editor' } = Astro.props;
---

<header class="sticky top-0 z-50 w-full glass-panel transition-all">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo & Brand -->
    <div class="flex items-center gap-6">
      <a href="/" class="group flex items-center gap-3 transition-transform hover:scale-[1.02]">
        <div class="relative flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500 via-blue-600 to-indigo-600 text-white font-bold tracking-tight shadow-glow-cyan shadow-sm transition-all duration-300 group-hover:shadow-glow-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 drop-shadow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-[16px] font-bold tracking-tight text-ink font-sans">RealPdfEdit</span>
          <span class="text-[10px] font-mono text-mute -mt-1 hidden sm:block tracking-wide">Client-Side Studio</span>
        </div>
      </a>

      <!-- Privacy Guarantee Pill Badge -->
      <div class="hidden md:flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated/80 backdrop-blur px-3 py-1 text-[11px] font-medium text-body shadow-whisper">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span class="tracking-wide">100% Client-Side Private</span>
      </div>
    </div>

    <!-- Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 rounded-full border border-hairline bg-canvas-elevated/60 backdrop-blur p-1 text-[13px] font-medium text-body shadow-whisper">
      <a
        href="/"
        class={`rounded-full px-3.5 py-1.5 transition-all duration-200 hover:text-ink ${activeTool === 'editor' ? 'bg-ink text-on-primary font-semibold shadow-sm' : 'hover:bg-hairline-soft/80'}`}
      >
        PDF Editor
      </a>
      <a
        href="/merge-pdf"
        class={`rounded-full px-3.5 py-1.5 transition-all duration-200 hover:text-ink ${activeTool === 'merge' ? 'bg-ink text-on-primary font-semibold shadow-sm' : 'hover:bg-hairline-soft/80'}`}
      >
        Merge
      </a>
      <a
        href="/split-pdf"
        class={`rounded-full px-3.5 py-1.5 transition-all duration-200 hover:text-ink ${activeTool === 'split' ? 'bg-ink text-on-primary font-semibold shadow-sm' : 'hover:bg-hairline-soft/80'}`}
      >
        Split
      </a>
      <a
        href="/sign-pdf"
        class={`rounded-full px-3.5 py-1.5 transition-all duration-200 hover:text-ink ${activeTool === 'sign' ? 'bg-ink text-on-primary font-semibold shadow-sm' : 'hover:bg-hairline-soft/80'}`}
      >
        Sign
      </a>
      <a
        href="/pdf-to-images"
        class={`rounded-full px-3.5 py-1.5 transition-all duration-200 hover:text-ink ${activeTool === 'convert' ? 'bg-ink text-on-primary font-semibold shadow-sm' : 'hover:bg-hairline-soft/80'}`}
      >
        Images
      </a>
      <a
        href="/compress-pdf"
        class={`rounded-full px-3.5 py-1.5 transition-all duration-200 hover:text-ink ${activeTool === 'compress' ? 'bg-ink text-on-primary font-semibold shadow-sm' : 'hover:bg-hairline-soft/80'}`}
      >
        Compress
      </a>
      <a
        href="/privacy"
        class={`rounded-full px-3.5 py-1.5 transition-all duration-200 hover:text-ink ${activeTool === 'privacy' ? 'bg-ink text-on-primary font-semibold shadow-sm' : 'hover:bg-hairline-soft/80'}`}
      >
        Privacy
      </a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2.5">
      <!-- Dark/Light Theme Switcher -->
      <button
        id="btn-theme-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-hairline bg-canvas-elevated/80 text-ink shadow-whisper transition-all hover:bg-hairline-soft hover:scale-105 active:scale-95"
        title="Toggle Light / Dark Mode"
        aria-label="Toggle theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden text-amber-400 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden text-slate-700 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a
        href="#editor-anchor"
        id="nav-cta-button"
        class="inline-flex h-9 items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 px-4 text-[13px] font-semibold text-white shadow-sm transition-all duration-200 hover:opacity-95 hover:shadow-glow-cyan active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        <span>Upload PDF</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggleBtn = document.getElementById('btn-theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    updateIcons();

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        }
        updateIcons();
      });
    }
  });
</script>
