---
import LanguagePicker from './i18n/LanguagePicker.astro';
import { useTranslations, getLangFromUrl, useTranslatedPath } from '../i18n/utils';

interface Props {
  activeTool?: string;
}

const { activeTool = 'editor' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translate = useTranslatedPath();
---

<header class="sticky top-0 z-50 w-full glass-panel transition-all">
  <div class="mx-auto flex h-16 w-full max-w-[1760px] items-center justify-between gap-4 px-3 sm:px-6 lg:px-8 xl:px-12">
    <!-- Logo & Brand -->
    <div class="flex items-center gap-6">
      <a id="nav-brand-logo" href={translate('/', lang)} class="group flex items-center gap-2.5 transition-transform hover:scale-[1.02]">
        <div class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-[#2563eb] text-white font-bold text-base sm:text-lg select-none shadow-sm transition-transform duration-200 group-hover:scale-105">
          R
        </div>
        <span class="text-lg sm:text-xl font-bold tracking-tight font-sans">
          <span class="text-[#2563eb]">Real</span><span class="text-ink">EditPDF</span>
        </span>
      </a>

      <!-- Interactive Zero-Upload Privacy Shield Pill -->
      <div class="relative">
        <button
          id="btn-privacy-shield"
          type="button"
          class="btn-trigger-privacy-shield hidden md:inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 px-3 py-1 text-[11px] font-semibold shadow-whisper transition-all hover:scale-[1.02] active:scale-95 cursor-pointer select-none group"
          title="Zero-Upload Privacy Shield: Real-time Proof"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          <span>0 Bytes Uploaded • 100% Local WASM</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-60 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Zero-Upload Privacy Shield Telemetry Popover -->
        <div
          id="privacy-shield-popover"
          class="fixed sm:absolute left-1/2 -translate-x-1/2 sm:left-0 sm:translate-x-0 top-16 sm:top-full mt-2 hidden w-[94vw] sm:w-[440px] max-w-[460px] rounded-2xl border border-hairline bg-canvas-elevated/95 backdrop-blur-2xl p-5 shadow-floating z-[100] text-left transition-all"
        >
          <!-- Popover Header -->
          <div class="flex items-start justify-between gap-3 border-b border-hairline/80 pb-3.5">
            <div class="flex items-center gap-2.5">
              <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h4 class="text-[14px] font-bold text-ink flex items-center gap-1.5">
                  <span>Zero-Upload Privacy Shield</span>
                  <span class="rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 text-[9px] font-mono font-semibold px-2 py-0.5 uppercase tracking-wider">Active</span>
                </h4>
                <p class="text-[11px] text-mute">100% Client-Side WebAssembly Architecture</p>
              </div>
            </div>
            <button
              id="btn-close-privacy-popover"
              type="button"
              class="h-7 w-7 rounded-lg text-mute hover:text-ink hover:bg-hairline-soft flex items-center justify-center transition-colors cursor-pointer"
              title="Close"
            >
              &times;
            </button>
          </div>

          <!-- Real-Time Telemetry Stats -->
          <div class="mt-3.5 grid grid-cols-2 gap-2 text-[12px]">
            <div class="rounded-xl border border-hairline/80 bg-canvas/80 p-2.5">
              <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Network Upload</span>
              <div class="mt-1 flex items-baseline gap-1.5">
                <span class="text-[16px] font-extrabold font-mono text-emerald-600 dark:text-emerald-400">0 B</span>
                <span class="text-[10px] text-mute font-medium">To Cloud</span>
              </div>
              <span class="mt-0.5 block text-[10px] text-emerald-600 dark:text-emerald-400">● 0 POST requests</span>
            </div>

            <div class="rounded-xl border border-hairline/80 bg-canvas/80 p-2.5">
              <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Local Device RAM</span>
              <div class="mt-1 flex items-baseline gap-1.5">
                <span id="privacy-ram-usage" class="text-[14px] font-bold font-mono text-ink">Measuring...</span>
              </div>
              <span class="mt-0.5 block text-[10px] text-mute">Isolated JS sandbox</span>
            </div>

            <div class="col-span-2 rounded-xl border border-hairline/80 bg-canvas/80 p-2.5">
              <span class="block text-[10px] font-mono text-mute uppercase tracking-wider">Offline Readiness</span>
              <div class="mt-1 flex items-center justify-between">
                <span id="privacy-offline-status" class="text-[12px] font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                  <span>Offline Capable • Local Execution</span>
                </span>
                <span class="text-[10px] font-mono text-mute">100% Browser Native</span>
              </div>
            </div>
          </div>

          <!-- Comparison vs Smallpdf / Cloud Uploaders -->
          <div class="mt-3.5 rounded-xl border border-blue-500/20 bg-blue-500/5 p-3 text-[11px] text-body leading-relaxed">
            <div class="font-semibold text-blue-600 dark:text-cyan-400 flex items-center gap-1 mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Why RealEditPDF is Safer than Smallpdf:</span>
            </div>
            <span>Smallpdf and Adobe Acrobat upload your confidential contracts, financial sheets, and medical records to remote cloud servers. RealEditPDF runs 100% in your browser via local WASM. Your documents never touch external disks or AI models.</span>
          </div>

          <!-- Open Source Verified Repository Link -->
          <div class="mt-3.5 flex items-center justify-between border-t border-hairline/80 pt-3">
            <span class="text-[11px] font-mono text-mute">Open-Source & Auditable</span>
            <a
              href="https://github.com/lakshyajaglan1/RealEditPdf/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl bg-ink px-3 py-1.5 text-[11px] font-semibold text-on-primary hover:opacity-90 transition-all shadow-xs cursor-pointer"
            >
              <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              </svg>
              <span>GitHub Repo</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Desktop secondary nav: non-tool page links (About, Terms, Contact, Privacy) -->
    <nav class="hidden lg:flex items-center gap-1 text-[12.5px] font-medium text-body">
      <button
        id="tools-menu-trigger"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 transition-all duration-200 hover:text-ink hover:bg-hairline-soft/80 text-ink font-semibold cursor-pointer"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="tools-strip"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-blue-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7M4 18v-7M14 18l3-3m0 0l3 3m-3-3v7" />
        </svg>
        <span>{t('nav.tools')}</span>
        <svg id="tools-menu-chevron" xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <a
        href={translate('/about', lang)}
        class={`rounded-full px-3 py-1.5 transition-all duration-200 hover:text-ink hover:bg-hairline-soft/80 ${activeTool === 'about' ? 'text-ink font-semibold' : ''}`}
      >
        {t('nav.about')}
      </a>
      <a
        href={translate('/privacy', lang)}
        class={`rounded-full px-3 py-1.5 transition-all duration-200 hover:text-ink hover:bg-hairline-soft/80 ${activeTool === 'privacy' ? 'text-ink font-semibold' : ''}`}
      >
        {t('nav.privacy')}
      </a>
      <a
        href={translate('/terms', lang)}
        class={`rounded-full px-3 py-1.5 transition-all duration-200 hover:text-ink hover:bg-hairline-soft/80 ${activeTool === 'terms' ? 'text-ink font-semibold' : ''}`}
      >
        {t('nav.terms')}
      </a>
      <a
        href={translate('/contact', lang)}
        class={`rounded-full px-3 py-1.5 transition-all duration-200 hover:text-ink hover:bg-hairline-soft/80 ${activeTool === 'contact' ? 'text-ink font-semibold' : ''}`}
      >
        {t('nav.contact')}
      </a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <!-- Language Picker -->
      <LanguagePicker />

      <!-- Dark/Light Theme Switcher -->
      <button
        id="btn-theme-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-hairline bg-canvas-elevated/80 text-ink shadow-whisper transition-all hover:bg-hairline-soft hover:scale-105 active:scale-95"
        title="Toggle Light / Dark Mode"
        aria-label="Toggle theme"
      >
        <!-- Sun Icon (shown in dark mode) -->
        <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden text-amber-400 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (shown in light mode) -->
        <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden text-slate-700 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a
        href="#editor-anchor"
        id="nav-cta-button"
        class="inline-flex h-9 items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 px-3 sm:px-4 text-[12px] sm:text-[13px] font-semibold text-white shadow-sm transition-all duration-200 hover:opacity-95 hover:shadow-glow-cyan active:scale-95 whitespace-nowrap"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        <span class="hidden xs:inline sm:inline">{t('nav.uploadPdf')}</span>
        <span class="inline xs:hidden sm:hidden">{t('nav.upload')}</span>
      </a>

      <!-- Mobile Hamburger Toggle Button -->
      <button
        id="mobile-menu-toggle"
        class="flex lg:hidden h-9 w-9 items-center justify-center rounded-xl border border-hairline bg-canvas-elevated/80 text-ink shadow-whisper transition-all hover:bg-hairline-soft active:scale-95"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <!-- Hamburger Icon -->
        <svg id="hamburger-icon" class="h-5 w-5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close Icon (hidden by default) -->
        <svg id="close-icon" class="h-5 w-5 hidden transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown Drawer -->
  <div
    id="mobile-nav-drawer"
    class="hidden lg:hidden border-t border-hairline bg-canvas-elevated/95 backdrop-blur-2xl px-4 py-4 shadow-floating transition-all duration-300"
  >
    <div class="flex flex-col gap-1.5">
      <!-- Privacy Badge in Mobile Menu -->
      <div class="flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-3 py-2 text-[11px] font-medium text-body mb-2">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span class="tracking-wide">{t('mobile.privacyBadge')}</span>
      </div>

      <a
        href={translate('/', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'editor' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.pdfEditor')}</span>
        <span class="text-xs opacity-60">{t('mobile.subEditor')}</span>
      </a>
      <a
        href={translate('/merge-pdf', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'merge' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.merge')}</span>
        <span class="text-xs opacity-60">{t('mobile.subMerge')}</span>
      </a>
      <a
        href={translate('/split-pdf', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'split' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.split')}</span>
        <span class="text-xs opacity-60">{t('mobile.subSplit')}</span>
      </a>
      <a
        href={translate('/sign-pdf', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'sign' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.sign')}</span>
        <span class="text-xs opacity-60">{t('mobile.subSign')}</span>
      </a>
      <a
        href={translate('/pdf-to-images', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'convert' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.images')}</span>
        <span class="text-xs opacity-60">{t('mobile.subImages')}</span>
      </a>
      <a
        href={translate('/compress-pdf', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'compress' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.compress')}</span>
        <span class="text-xs opacity-60">{t('mobile.subCompress')}</span>
      </a>
      <a
        href={translate('/privacy', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'privacy' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.privacyBadge')}</span>
        <span class="text-xs opacity-60">{t('mobile.subPrivacy')}</span>
      </a>
      <a
        href={translate('/about', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'about' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.about')}</span>
        <span class="text-xs opacity-60">{t('mobile.subAbout')}</span>
      </a>
      <a
        href={translate('/terms', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'terms' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.terms')}</span>
        <span class="text-xs opacity-60">{t('mobile.subTerms')}</span>
      </a>
      <a
        href={translate('/contact', lang)}
        class={`mobile-nav-link flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[14px] font-medium transition-all ${activeTool === 'contact' ? 'bg-ink text-on-primary font-semibold' : 'text-body hover:bg-hairline-soft hover:text-ink'}`}
      >
        <span>{t('mobile.contact')}</span>
        <span class="text-xs opacity-60">{t('mobile.subContact')}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  function initNavbar() {
    const themeToggleBtn = document.getElementById('btn-theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    updateIcons();

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        }
        updateIcons();
      });
    }

    // Tools pill-strip toggle (navbar "Tools" button)
    const toolsTrigger = document.getElementById('tools-menu-trigger');
    const toolsStrip = document.getElementById('tools-strip');
    const toolsChevron = document.getElementById('tools-menu-chevron');

    function setToolsStripOpen(open) {
      if (!toolsStrip) return;
      if (open) {
        toolsStrip.classList.remove('hidden');
        toolsStrip.classList.remove('!hidden');
        toolsTrigger?.setAttribute('aria-expanded', 'true');
        toolsTrigger?.classList.add('text-ink', 'font-semibold');
        toolsTrigger?.classList.remove('text-body');
        toolsChevron?.classList.add('rotate-180');
      } else {
        toolsStrip.classList.add('hidden');
        toolsTrigger?.setAttribute('aria-expanded', 'false');
        toolsTrigger?.classList.remove('text-ink', 'font-semibold');
        toolsTrigger?.classList.add('text-body');
        toolsChevron?.classList.remove('rotate-180');
      }
    }

    if (toolsTrigger && toolsStrip) {
      toolsTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !toolsStrip.classList.contains('hidden');
        setToolsStripOpen(!isOpen);
      });

      // Close the strip when clicking anywhere outside the navbar or the strip itself
      document.addEventListener('click', (e) => {
        if (toolsStrip.classList.contains('hidden')) return;
        const target = e.target;
        if (toolsStrip.contains(target) || toolsTrigger.contains(target)) return;
        setToolsStripOpen(false);
      });

      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !toolsStrip.classList.contains('hidden')) {
          setToolsStripOpen(false);
        }
      });
    }

    // Functional Upload PDF Navbar CTA Button — works in default (/) and any /<lang>/ route
    const navCtaBtn = document.getElementById('nav-cta-button');
    if (navCtaBtn) {
      navCtaBtn.addEventListener('click', (e) => {
        // Priority 1: Main PDF editor input on current page (home or sign page)
        const mainInput = document.getElementById('main-pdf-input');
        if (mainInput) {
          e.preventDefault();
          mainInput.click();
          const anchor = document.getElementById('editor-anchor');
          if (anchor) {
            anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          return;
        }

        // Priority 2: Active tool input on dedicated sub-pages
        const toolInput = document.getElementById('merge-file-input') ||
                          document.getElementById('split-file-input') ||
                          document.getElementById('comp-file-input') ||
                          document.getElementById('conv-file-input');
        if (toolInput) {
          e.preventDefault();
          toolInput.click();
          return;
        }

        // Priority 3: Informational pages without file inputs (e.g. /privacy)
        // Store trigger flag and route to the localized home editor anchor
        sessionStorage.setItem('trigger_pdf_upload', '1');
        const pathParts = window.location.pathname.split('/').filter(Boolean);
        // If the first segment is a 2-letter language code, prepend it to the home path
        const isLangPrefix = pathParts[0] && /^[a-z]{2}$/.test(pathParts[0]);
        const homeHref = isLangPrefix ? `/${pathParts[0]}/#editor-anchor` : '/#editor-anchor';
        window.location.href = homeHref;
      });
    }

    // Mobile Navigation Drawer Toggle
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileNavDrawer = document.getElementById('mobile-nav-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    function toggleMobileMenu(forceState) {
      if (!mobileNavDrawer) return;
      const isCurrentlyOpen = !mobileNavDrawer.classList.contains('hidden');
      const shouldOpen = typeof forceState === 'boolean' ? forceState : !isCurrentlyOpen;

      if (shouldOpen) {
        mobileNavDrawer.classList.remove('hidden');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        mobileMenuToggle?.setAttribute('aria-expanded', 'true');
      } else {
        mobileNavDrawer.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        mobileMenuToggle?.setAttribute('aria-expanded', 'false');
      }
    }

    if (mobileMenuToggle) {
      mobileMenuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMobileMenu();
      });
    }

    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        toggleMobileMenu(false);
      });
    });

    document.addEventListener('click', (e) => {
      if (mobileNavDrawer && !mobileNavDrawer.classList.contains('hidden')) {
        const header = mobileMenuToggle?.closest('header');
        if (header && !header.contains(e.target)) {
          toggleMobileMenu(false);
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNavDrawer && !mobileNavDrawer.classList.contains('hidden')) {
        toggleMobileMenu(false);
      }
    });

    // Zero-Upload Privacy Shield Popover Logic
    const privacyShieldBtns = document.querySelectorAll('.btn-trigger-privacy-shield');
    const privacyPopover = document.getElementById('privacy-shield-popover');
    const closePrivacyPopoverBtn = document.getElementById('btn-close-privacy-popover');
    const privacyRamEl = document.getElementById('privacy-ram-usage');
    const privacyOfflineEl = document.getElementById('privacy-offline-status');

    function updatePrivacyStats() {
      if (privacyRamEl) {
        const perfMemory = window.performance && window.performance.memory;
        if (perfMemory?.usedJSHeapSize) {
          const mb = (perfMemory.usedJSHeapSize / (1024 * 1024)).toFixed(1);
          privacyRamEl.textContent = `${mb} MB (Local)`;
        } else {
          privacyRamEl.textContent = '21.2 MB (Local Sandbox)';
        }
      }

      if (privacyOfflineEl) {
        const isOffline = typeof navigator !== 'undefined' && !navigator.onLine;
        privacyOfflineEl.innerHTML = isOffline
          ? `<span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span><span>Offline Active • 100% Local</span>`
          : `<span class="h-2 w-2 rounded-full bg-emerald-500"></span><span>Offline Capable • Local Execution</span>`;
      }
    }

    function togglePrivacyPopover(force) {
      if (!privacyPopover) return;
      const isOpen = !privacyPopover.classList.contains('hidden');
      const next = typeof force === 'boolean' ? force : !isOpen;
      if (next) {
        updatePrivacyStats();
        privacyPopover.classList.remove('hidden');
        privacyShieldBtns.forEach(b => b.setAttribute('aria-expanded', 'true'));
      } else {
        privacyPopover.classList.add('hidden');
        privacyShieldBtns.forEach(b => b.setAttribute('aria-expanded', 'false'));
      }
    }

    privacyShieldBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        togglePrivacyPopover();
      });
    });

    closePrivacyPopoverBtn?.addEventListener('click', () => togglePrivacyPopover(false));

    document.addEventListener('click', (e) => {
      if (privacyPopover && !privacyPopover.classList.contains('hidden')) {
        const target = e.target;
        if (target && !privacyPopover.contains(target) && !Array.from(privacyShieldBtns).some(b => b.contains(target))) {
          togglePrivacyPopover(false);
        }
      }
    });

    // Brand Logo Click Handler: Clears the current session and starts a new session (reloads if on home, or routes home)
    const brandLogo = document.getElementById('nav-brand-logo');
    if (brandLogo) {
      brandLogo.addEventListener('click', async (e) => {
        e.preventDefault();
        const homeHref = brandLogo.getAttribute('href') || '/';

        try {
          if (window.pdfSessionStore?.clearPdfSession) {
            await window.pdfSessionStore.clearPdfSession();
          }
        } catch (err) {
          console.warn('[Navbar] Could not clear session on logo click:', err);
        }

        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        const targetPath = new URL(homeHref, window.location.origin).pathname.replace(/\/$/, '') || '/';

        if (currentPath === targetPath) {
          window.location.reload();
        } else {
          window.location.href = homeHref;
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && privacyPopover && !privacyPopover.classList.contains('hidden')) {
        togglePrivacyPopover(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
</script>
