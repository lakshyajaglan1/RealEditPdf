---
// Pure presentational body for the Terms page. Localizes strings via t().
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props as Props;
---

<div class="py-12 md:py-20 hero-mesh-gradient border-b border-hairline">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-display text-ink break-words">
      {t('terms.title')}
    </h1>
    <p class="mt-3 sm:mt-4 text-[14px] sm:text-[16px] text-body max-w-2xl mx-auto">
      {t('terms.subtitle')}
    </p>
  </div>
</div>

<section class="py-12 sm:py-16 bg-canvas">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
    <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-ink">{t('terms.s1.title')}</h2>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('terms.s1.body')}</p>
    </div>
    <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg sm:text-xl font-bold text-ink">{t('terms.s2.title')}</h2>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1 font-mono text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
          </svg>
          100% Client-Side Ownership
        </span>
      </div>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('terms.s2.body')}</p>
    </div>
    <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-ink">{t('terms.s3.title')}</h2>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('terms.s3.body')}</p>
    </div>
    <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-ink">{t('terms.s4.title')}</h2>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('terms.s4.body')}</p>
    </div>
    <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
      <h2 class="text-lg sm:text-xl font-bold text-ink">{t('terms.s5.title')}</h2>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('terms.s5.body')}</p>
    </div>
  </div>
</section>
