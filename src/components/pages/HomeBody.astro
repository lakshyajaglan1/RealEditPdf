---
import PdfEditor from '../editor/PdfEditor.astro';
import SeoContent from '../seo/SeoContent.astro';

// Body for the Home page. Localizes strings via t().
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props as Props;
---

<!-- Hero Section with Ambient Glow & Modern Studio Mount -->
<section id="hero-section" class="relative overflow-hidden pt-6 pb-14 md:pt-10 md:pb-20 hero-mesh-gradient border-b border-hairline transition-all duration-300">
  <!-- Atmospheric Ambient Glow Blobs -->
  <div class="hero-mesh-blob -top-24 left-1/4 h-96 w-96 rounded-full bg-cyan-500/15 animate-pulse-glow"></div>
  <div class="hero-mesh-blob -top-12 right-1/4 h-96 w-96 rounded-full bg-indigo-500/15"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1760px] px-3 sm:px-6 lg:px-8 xl:px-12">
    <!-- Modern Headline & Subtext -->
    <div id="hero-intro-header" class="flex flex-col items-center text-center max-w-3xl mx-auto mb-8 transition-all duration-300">
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated/90 px-3.5 py-1 text-[11px] font-mono text-ink shadow-whisper mb-3">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span class="uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400">{t('hero.badge')}</span>
        <span class="text-hairline">•</span>
        <span class="text-mute">{t('hero.limits')}</span>
      </div>

      <h1 class="text-2xl xs:text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-display text-ink break-words">
        {t('hero.title1')} <span class="bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 bg-clip-text text-transparent">{t('hero.title2')}</span>
      </h1>
      <p class="mt-3 text-[14px] sm:text-[16px] text-body max-w-xl leading-relaxed">
        {t('hero.subtitle')}
      </p>

      <!-- Quick Feature Badges -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-[12px] font-medium text-mute">
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          {t('hero.noSize')}
        </span>
        <span class="text-hairline">•</span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          {t('hero.noServer')}
        </span>
        <span class="text-hairline">•</span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          {t('hero.noAccount')}
        </span>
      </div>
    </div>

    <!-- Interactive PDF Editor Studio Mount -->
    <div class="w-full text-left">
      <PdfEditor />
    </div>
  </div>
</section>

<!-- Visibility Section: About, Terms, Contact -->
<section class="py-12 sm:py-16 bg-canvas border-b border-hairline">
  <div class="mx-auto w-full max-w-[1760px] px-3 sm:px-6 lg:px-8 xl:px-12">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 max-w-2xl mx-auto text-center">
      <div>
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink mb-3">{t('nav.about')}</h3>
        <p class="text-[13px] sm:text-[14px] text-body leading-relaxed">
          {t('about.subtitle')}
        </p>
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink mb-3">{t('nav.terms')}</h3>
        <p class="text-[13px] sm:text-[14px] text-body leading-relaxed">
          {t('terms.subtitle')}
        </p>
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink mb-3">{t('nav.contact')}</h3>
        <p class="text-[13px] sm:text-[14px] text-body leading-relaxed">
          {t('contact.subtitle')}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Competitor Comparison Section -->
<section id="comparison" class="py-14 sm:py-24 bg-canvas border-b border-hairline">
  <div class="mx-auto w-full max-w-[1760px] px-3 sm:px-6 lg:px-8 xl:px-12">
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-link shadow-whisper">
        {t('home.compareBadge')}
      </span>
      <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-heading-lg text-ink">
        {t('home.compareTitle')}
      </h2>
      <p class="mt-3 text-[14px] sm:text-[15px] text-body">
        {t('home.compareSub')}
      </p>
    </div>

    <!-- Mobile swipe hint -->
    <div class="flex sm:hidden items-center justify-end gap-1.5 text-[11px] font-mono text-mute mb-2">
      <span>{t('home.compareSwipe')}</span>
      <span>➔</span>
    </div>

    <!-- Comparison Table Card -->
    <div class="overflow-x-auto rounded-2xl border border-hairline bg-canvas-elevated shadow-floating touch-scroll no-scrollbar">
      <table class="w-full min-w-[620px] text-left text-[13px] sm:text-[14px] border-collapse">
        <thead>
          <tr class="border-b border-hairline bg-canvas font-mono text-[12px] uppercase tracking-wider text-mute">
            <th class="py-4 px-6 font-semibold">{t('home.compareThFeature')}</th>
            <th class="py-4 px-6 font-bold text-ink bg-cyan-500/10 border-x border-cyan-500/20">
              <div class="flex items-center gap-2">
                <span>{t('home.compareThUs')}</span>
                <span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">{t('home.compareFreePill')}</span>
              </div>
            </th>
            <th class="py-4 px-6 font-semibold text-body">{t('home.compareThSmallpdf')}</th>
            <th class="py-4 px-6 font-semibold text-body">{t('home.compareThIlovepdf')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline font-sans">
          <tr class="hover:bg-hairline-soft/40 transition-colors">
            <td class="py-4 px-6 font-medium text-ink">{t('home.compareR1Label')}</td>
            <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">{t('home.compareR1Us')}</td>
            <td class="py-4 px-6 text-rose-600 dark:text-rose-400">{t('home.compareR1S1')}</td>
            <td class="py-4 px-6 text-rose-600 dark:text-rose-400">{t('home.compareR1S2')}</td>
          </tr>
          <tr class="hover:bg-hairline-soft/40 transition-colors">
            <td class="py-4 px-6 font-medium text-ink">{t('home.compareR2Label')}</td>
            <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">{t('home.compareR2Us')}</td>
            <td class="py-4 px-6 text-body">{t('home.compareR2S1')}</td>
            <td class="py-4 px-6 text-body">{t('home.compareR2S2')}</td>
          </tr>
          <tr class="hover:bg-hairline-soft/40 transition-colors">
            <td class="py-4 px-6 font-medium text-ink">{t('home.compareR3Label')}</td>
            <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">{t('home.compareR3Us')}</td>
            <td class="py-4 px-6 text-rose-600 dark:text-rose-400">{t('home.compareR3S1')}</td>
            <td class="py-4 px-6 text-amber-600 dark:text-amber-400">{t('home.compareR3S2')}</td>
          </tr>
          <tr class="hover:bg-hairline-soft/40 transition-colors">
            <td class="py-4 px-6 font-medium text-ink">{t('home.compareR4Label')}</td>
            <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">{t('home.compareR4Us')}</td>
            <td class="py-4 px-6 text-body">{t('home.compareR4S1')}</td>
            <td class="py-4 px-6 text-body">{t('home.compareR4S2')}</td>
          </tr>
          <tr class="hover:bg-hairline-soft/40 transition-colors">
            <td class="py-4 px-6 font-medium text-ink">{t('home.compareR5Label')}</td>
            <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">{t('home.compareR5Us')}</td>
            <td class="py-4 px-6 text-body">{t('home.compareR5S1')}</td>
            <td class="py-4 px-6 text-body">{t('home.compareR5S2')}</td>
          </tr>
          <tr class="hover:bg-hairline-soft/40 transition-colors">
            <td class="py-4 px-6 font-medium text-ink">{t('home.compareR6Label')}</td>
            <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">{t('home.compareR6Us')}</td>
            <td class="py-4 px-6 text-rose-600 dark:text-rose-400">{t('home.compareR6S1')}</td>
            <td class="py-4 px-6 text-amber-600 dark:text-amber-400">{t('home.compareR6S2')}</td>
          </tr>
          <tr class="hover:bg-hairline-soft/40 transition-colors">
            <td class="py-4 px-6 font-medium text-ink">{t('home.compareR7Label')}</td>
            <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">{t('home.compareR7Us')}</td>
            <td class="py-4 px-6 text-body">{t('home.compareR7S1')}</td>
            <td class="py-4 px-6 text-body">{t('home.compareR7S2')}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Feature Suite (Modern Bento Grid Layout) -->
<section class="py-14 sm:py-24 bg-canvas border-b border-hairline">
  <div class="mx-auto w-full max-w-[1760px] px-3 sm:px-6 lg:px-8 xl:px-12">
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-link shadow-whisper">
        {t('home.bentoBadge')}
      </span>
      <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-heading-lg text-ink">
        {t('home.bentoTitle')}
      </h2>
      <p class="mt-3 text-[14px] sm:text-[15px] text-body">
        {t('home.bentoSub')}
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      <!-- Card 1: Text & Whiteout (Spans 2 columns) -->
      <div class="md:col-span-2 glass-card rounded-2xl p-5 sm:p-7 flex flex-col justify-between relative overflow-hidden group">
        <div class="space-y-3 relative z-10">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-mono font-bold shadow-sm">
            T
          </div>
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">{t('home.bento1Title')}</h3>
          <p class="text-[13px] sm:text-[14px] leading-relaxed text-body max-w-xl">
            {t('home.bento1Body')}
          </p>
        </div>
        <div class="mt-5 flex items-center gap-2 text-[12px] font-mono text-cyan-600 dark:text-cyan-400 font-medium">
          <span>{t('home.bento1Cta')}</span>
          <span>➔</span>
        </div>
      </div>

      <!-- Card 2: E-Signature Studio -->
      <div class="glass-card rounded-2xl p-5 sm:p-7 flex flex-col justify-between relative overflow-hidden group">
        <div class="space-y-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">{t('home.bento2Title')}</h3>
          <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">
            {t('home.bento2Body')}
          </p>
        </div>
        <div class="mt-5 flex items-center gap-2 text-[12px] font-mono text-cyan-600 dark:text-cyan-400 font-medium">
          <span>{t('home.bento2Cta')}</span>
          <span>➔</span>
        </div>
      </div>

      <!-- Card 3: Permanent Redaction -->
      <div class="glass-card rounded-2xl p-5 sm:p-7 flex flex-col justify-between relative overflow-hidden group">
        <div class="space-y-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-500/15 text-rose-500 border border-rose-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">{t('home.bento3Title')}</h3>
          <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">
            {t('home.bento3Body')}
          </p>
        </div>
        <div class="mt-5 flex items-center gap-2 text-[12px] font-mono text-rose-600 dark:text-rose-400 font-medium">
          <span>{t('home.bento3Cta')}</span>
          <span>➔</span>
        </div>
      </div>

      <!-- Card 4: Page Organizer (Spans 2 columns) -->
      <div class="md:col-span-2 glass-card rounded-2xl p-5 sm:p-7 flex flex-col justify-between relative overflow-hidden group">
        <div class="space-y-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-600 text-white shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">{t('home.bento4Title')}</h3>
          <p class="text-[13px] sm:text-[14px] leading-relaxed text-body max-w-xl">
            {t('home.bento4Body')}
          </p>
        </div>
        <div class="mt-5 flex items-center gap-2 text-[12px] font-mono text-emerald-600 dark:text-emerald-400 font-medium">
          <span>{t('home.bento4Cta')}</span>
          <span>➔</span>
        </div>
      </div>

      <!-- Card 5: Freehand & Highlighting -->
      <div class="glass-card rounded-2xl p-5 sm:p-7 flex flex-col justify-between relative overflow-hidden group">
        <div class="space-y-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500/15 text-amber-500 border border-amber-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">{t('home.bento5Title')}</h3>
          <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">
            {t('home.bento5Body')}
          </p>
        </div>
        <div class="mt-5 flex items-center gap-2 text-[12px] font-mono text-amber-600 dark:text-amber-400 font-medium">
          <span>{t('home.bento5Cta')}</span>
          <span>➔</span>
        </div>
      </div>

      <!-- Card 6: Watermark & Numbering (Spans 2 columns) -->
      <div class="md:col-span-2 glass-card rounded-2xl p-5 sm:p-7 flex flex-col justify-between relative overflow-hidden group">
        <div class="space-y-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-600 text-white shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">{t('home.bento6Title')}</h3>
          <p class="text-[13px] sm:text-[14px] leading-relaxed text-body max-w-xl">
            {t('home.bento6Body')}
          </p>
        </div>
        <div class="mt-5 flex items-center gap-2 text-[12px] font-mono text-purple-600 dark:text-purple-400 font-medium">
          <span>{t('home.bento6Cta')}</span>
          <span>➔</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Comprehensive SEO Knowledge Guide & Schema -->
<SeoContent t={t} />

<!-- Modern CTA Section -->
<section class="py-14 sm:py-24 bg-canvas text-center relative overflow-hidden">
  <div class="hero-mesh-blob top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-80 w-80 rounded-full bg-blue-600/10"></div>
  <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-5 sm:space-y-6">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-link shadow-whisper">
      {t('home.ctaBadge')}
    </span>
    <h2 class="text-2xl xs:text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-display text-ink break-words">
      {t('home.ctaTitle')}
    </h2>
    <p class="text-body max-w-xl mx-auto text-[14px] sm:text-[16px]">
      {t('home.ctaSub')}
    </p>
    <div class="pt-2">
      <a
        href="#editor-anchor"
        class="w-full sm:w-auto inline-flex h-12 items-center justify-center gap-2 rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 px-8 text-sm font-semibold text-white shadow-floating hover:shadow-glow-primary transition-all duration-200 active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>{t('home.ctaButton')}</span>
      </a>
    </div>
  </div>
</section>
