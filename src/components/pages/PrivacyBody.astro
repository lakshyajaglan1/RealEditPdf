---
// Pure presentational body for the Privacy page. Localizes strings via t().
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props as Props;
---

<div class="py-12 md:py-20 hero-mesh-gradient border-b border-hairline">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-3 py-1 text-[12px] font-mono text-ink shadow-whisper mb-4">
      <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
      <span>{t('privacy.badge')}</span>
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-display text-ink break-words">
      {t('privacy.title')}
    </h1>
    <p class="mt-3 sm:mt-4 text-[14px] sm:text-[16px] text-body max-w-2xl mx-auto">
      {t('privacy.subtitle')}
    </p>
  </div>
</div>

<section class="py-12 sm:py-16 bg-canvas">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
    <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-ink text-cyan font-bold">01</div>
        <h2 class="text-lg sm:text-xl font-bold text-ink">{t('privacy.s1.title')}</h2>
      </div>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('privacy.s1.body1')}</p>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('privacy.s1.body2')}</p>
    </div>

    <div id="gdpr" class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-ink text-cyan font-bold">02</div>
        <h2 class="text-lg sm:text-xl font-bold text-ink">{t('privacy.s2.title')}</h2>
      </div>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('privacy.s2.body')}</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-[12px] sm:text-[13px]">
        <li class="flex items-start gap-2 p-3 rounded-xl bg-canvas border border-hairline">
          <span class="text-emerald-600 font-bold">✓</span>
          <div>{t('privacy.s2.gdpr')}</div>
        </li>
        <li class="flex items-start gap-2 p-3 rounded-xl bg-canvas border border-hairline">
          <span class="text-emerald-600 font-bold">✓</span>
          <div>{t('privacy.s2.hipaa')}</div>
        </li>
        <li class="flex items-start gap-2 p-3 rounded-xl bg-canvas border border-hairline">
          <span class="text-emerald-600 font-bold">✓</span>
          <div>{t('privacy.s2.tracking')}</div>
        </li>
        <li class="flex items-start gap-2 p-3 rounded-xl bg-canvas border border-hairline">
          <span class="text-emerald-600 font-bold">✓</span>
          <div>{t('privacy.s2.retention')}</div>
        </li>
      </ul>
    </div>

    <div id="offline" class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-ink text-cyan font-bold">03</div>
        <h2 class="text-lg sm:text-xl font-bold text-ink">{t('privacy.s3.title')}</h2>
      </div>
      <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">{t('privacy.s3.body')}</p>
    </div>
  </div>
</section>
