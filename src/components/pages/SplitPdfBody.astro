---
// Body for the Split PDF page. Localizes strings via t().
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props as Props;
const processingText = t('split.processing');
const totalPagesLabel = t('split.totalPages');
const executeText = t('split.execute');
const errorEmptyRange = t('split.errorEmptyRange');
const errorPrefix = t('split.errorPrefix');
const defaultFilenameText = t('split.defaultFilename');
---

<div class="py-14 md:py-24 hero-mesh-gradient border-b border-hairline relative overflow-hidden">
  <div class="hero-mesh-blob -top-24 left-1/4 h-80 w-80 rounded-full bg-violet-500/15 animate-pulse-glow"></div>
  <div class="hero-mesh-blob -top-12 right-1/4 h-80 w-80 rounded-full bg-cyan-500/15"></div>

  <div class="relative z-10 mx-auto w-full max-w-5xl xl:max-w-6xl px-3 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated/90 px-3.5 py-1 text-[11px] font-mono text-ink shadow-whisper mb-4">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-violet-500"></span>
      </span>
      <span class="uppercase tracking-wider font-semibold text-violet-600 dark:text-violet-400">{t('split.badge')}</span>
    </div>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-display text-ink break-words">
      {t('split.title')}
    </h1>
    <p class="mt-3 text-[14px] sm:text-[16px] text-body max-w-xl mx-auto leading-relaxed">
      {t('split.subtitle')}
    </p>

    <div class="mt-8 sm:mt-10 rounded-3xl border border-hairline bg-canvas-elevated/90 backdrop-blur-xl p-4 sm:p-8 md:p-10 shadow-floating text-left">
      <div id="split-dropzone" class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-hairline bg-canvas/80 p-6 sm:p-12 text-center hover:border-violet-500/50 hover:shadow-glow-primary transition-all duration-300 cursor-pointer group">
        <div class="h-14 w-14 sm:h-16 sm:w-16 rounded-2xl bg-canvas-elevated border border-hairline flex items-center justify-center mb-3 sm:mb-4 shadow-whisper group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 sm:h-8 sm:w-8 text-violet-600 dark:text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
          </svg>
        </div>
        <h3 class="text-lg sm:text-xl font-bold text-ink">{t('split.choose')}</h3>
        <p class="text-[12px] sm:text-[13px] text-mute mt-1.5">{t('split.chooseHint')}</p>
        <input type="file" id="split-file-input" accept="application/pdf" class="hidden" />
      </div>

      <div id="split-controls" class="mt-8 space-y-4 hidden">
        <div class="flex items-center justify-between p-3.5 rounded-xl bg-canvas border border-hairline text-[13px]">
          <span id="split-filename" class="font-semibold text-ink truncate">{defaultFilenameText}</span>
          <span id="split-page-count" class="font-mono text-mute text-xs">{totalPagesLabel}: 0</span>
        </div>

        <div>
          <label class="block text-[13px] font-medium text-ink mb-1.5">{t('split.rangeLabel')}</label>
          <input
            type="text"
            id="split-range-input"
            placeholder={t('split.rangePlaceholder')}
            class="w-full rounded-xl border border-hairline bg-canvas px-3.5 py-2.5 text-[14px] font-mono text-ink outline-none focus:border-violet-500 focus:ring-1 focus:ring-violet-500"
          />
          <p class="text-[11px] text-mute mt-1.5 font-mono">{t('split.rangeHint')}</p>
        </div>

        <button id="btn-execute-split" class="w-full rounded-full bg-gradient-to-r from-violet-600 via-indigo-600 to-blue-600 py-3 text-[14px] font-semibold text-white shadow-sm hover:shadow-glow-primary active:scale-[0.99] transition-all cursor-pointer">
          {executeText}
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ processingText, totalPagesLabel, executeText, errorEmptyRange, errorPrefix, defaultFilenameText }}>
  document.addEventListener('DOMContentLoaded', () => {
    let currentPdfBytes = null;
    let totalPages = 0;
    const dropzone = document.getElementById('split-dropzone');
    const fileInput = document.getElementById('split-file-input');
    const controls = document.getElementById('split-controls');
    const filenameSpan = document.getElementById('split-filename');
    const countSpan = document.getElementById('split-page-count');
    const rangeInput = document.getElementById('split-range-input');
    const executeBtn = document.getElementById('btn-execute-split');

    dropzone.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (file && file.type === 'application/pdf') {
        filenameSpan.textContent = file.name;
        currentPdfBytes = await file.arrayBuffer();
        const { PDFDocument } = window.PDFLib;
        const doc = await PDFDocument.load(currentPdfBytes);
        totalPages = doc.getPageCount();
        countSpan.textContent = `${totalPagesLabel}: ${totalPages}`;
        rangeInput.value = `1-${totalPages}`;
        dropzone.classList.add('hidden');
        controls.classList.remove('hidden');
      }
    });

    function parsePageRange(str, max) {
      const pages = new Set();
      const parts = str.split(',');
      for (const part of parts) {
        const trimmed = part.trim();
        if (trimmed.includes('-')) {
          const [start, end] = trimmed.split('-').map(n => parseInt(n.trim()));
          if (!isNaN(start) && !isNaN(end)) {
            for (let i = Math.max(1, start); i <= Math.min(max, end); i++) pages.add(i - 1);
          }
        } else {
          const n = parseInt(trimmed);
          if (!isNaN(n) && n >= 1 && n <= max) pages.add(n - 1);
        }
      }
      return Array.from(pages).sort((a, b) => a - b);
    }

    executeBtn.addEventListener('click', async () => {
      const indices = parsePageRange(rangeInput.value, totalPages);
      if (indices.length === 0) { alert(errorEmptyRange); return; }
      executeBtn.disabled = true;
      executeBtn.textContent = processingText;
      try {
        const { PDFDocument } = window.PDFLib;
        const srcDoc = await PDFDocument.load(currentPdfBytes);
        const newDoc = await PDFDocument.create();
        const copiedPages = await newDoc.copyPages(srcDoc, indices);
        copiedPages.forEach(p => newDoc.addPage(p));
        const pdfBytes = await newDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `Extracted-Pages-${rangeInput.value.replace(/\s+/g, '')}.pdf`;
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        URL.revokeObjectURL(url);
        if (window.confetti) window.confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
      } catch (err) {
        alert(errorPrefix + err.message);
      } finally {
        executeBtn.disabled = false;
        executeBtn.textContent = executeText;
      }
    });
  });
</script>
