---
import Layout from '../layouts/Layout.astro';
import PdfEditor from '../components/editor/PdfEditor.astro';
---

<Layout
  title="RealPdfEdit — 100% Free & Unlimited Client-Side PDF Editor"
  description="Edit PDF text, draw annotations, sign documents, redact confidential data, reorder pages, and merge PDFs directly in your browser. 100% private with zero cloud uploads."
  activeTool="editor"
>
  <!-- Hero Section with Ambient Glow & Modern Studio Mount -->
  <section class="relative overflow-hidden pt-6 pb-14 md:pt-10 md:pb-20 hero-mesh-gradient border-b border-hairline">
    <!-- Atmospheric Ambient Glow Blobs -->
    <div class="hero-mesh-blob -top-24 left-1/4 h-96 w-96 rounded-full bg-cyan-500/15 animate-pulse-glow"></div>
    <div class="hero-mesh-blob -top-12 right-1/4 h-96 w-96 rounded-full bg-indigo-500/15"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Modern Headline & Subtext -->
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated/90 px-3.5 py-1 text-[11px] font-mono text-ink shadow-whisper mb-3">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          <span class="uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400">100% Private In-Browser WASM</span>
          <span class="text-hairline">•</span>
          <span class="text-mute">Zero Limits</span>
        </div>
        
        <h1 class="text-3xl font-extrabold tracking-display text-ink sm:text-4xl lg:text-5xl">
          Edit, Sign & Redact PDFs <span class="bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 bg-clip-text text-transparent">Privately</span>
        </h1>
        <p class="mt-3 text-[15px] sm:text-[16px] text-body max-w-xl leading-relaxed">
          Zero cloud uploads. Edit text, place signatures, annotate, redact confidential data, and organize pages directly on your device.
        </p>

        <!-- Quick Feature Badges -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-[12px] font-medium text-mute">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            No File Size Limits
          </span>
          <span class="text-hairline">•</span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Zero Server Uploads
          </span>
          <span class="text-hairline">•</span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            No Account Needed
          </span>
        </div>
      </div>

      <!-- Interactive PDF Editor Studio Mount -->
      <div class="w-full text-left">
        <PdfEditor />
      </div>
    </div>
  </section>

  <!-- Competitor Comparison Section -->
  <section id="comparison" class="py-20 sm:py-28 bg-canvas border-b border-hairline">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-link shadow-whisper">
          Honest Comparison
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-heading-lg text-ink sm:text-4xl">
          Why RealPdfEdit leaves competitors behind.
        </h2>
        <p class="mt-3 text-[15px] text-body">
          Most online PDF editors lure you in and then hit you with daily task limits, paywalls, or store your private files on remote cloud servers.
        </p>
      </div>

      <!-- Comparison Table Card -->
      <div class="overflow-x-auto rounded-2xl border border-hairline bg-canvas-elevated shadow-floating">
        <table class="w-full text-left text-[14px] border-collapse">
          <thead>
            <tr class="border-b border-hairline bg-canvas font-mono text-[12px] uppercase tracking-wider text-mute">
              <th class="py-4 px-6 font-semibold">Feature / Capability</th>
              <th class="py-4 px-6 font-bold text-ink bg-cyan-500/10 border-x border-cyan-500/20">
                <div class="flex items-center gap-2">
                  <span>RealPdfEdit</span>
                  <span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">FREE FOREVER</span>
                </div>
              </th>
              <th class="py-4 px-6 font-semibold text-body">Smallpdf</th>
              <th class="py-4 px-6 font-semibold text-body">ILovePDF / Sejda</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline font-sans">
            <tr class="hover:bg-hairline-soft/40 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Daily Usage Limits</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">Unlimited (0 limits)</td>
              <td class="py-4 px-6 text-rose-600 dark:text-rose-400">1-2 tasks per day</td>
              <td class="py-4 px-6 text-rose-600 dark:text-rose-400">3 tasks per hour</td>
            </tr>
            <tr class="hover:bg-hairline-soft/40 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Privacy & Security</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">100% Client-Side (0 Server Uploads)</td>
              <td class="py-4 px-6 text-body">Cloud server upload</td>
              <td class="py-4 px-6 text-body">Cloud server upload</td>
            </tr>
            <tr class="hover:bg-hairline-soft/40 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Edit Existing Text</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">100% Free & Unlimited</td>
              <td class="py-4 px-6 text-rose-600 dark:text-rose-400">Locked behind $12/mo Pro</td>
              <td class="py-4 px-6 text-amber-600 dark:text-amber-400">Limited / Paywalled</td>
            </tr>
            <tr class="hover:bg-hairline-soft/40 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">File Size Limit</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">No Limit (Your RAM is the limit)</td>
              <td class="py-4 px-6 text-body">15 MB max for free tier</td>
              <td class="py-4 px-6 text-body">50 MB max</td>
            </tr>
            <tr class="hover:bg-hairline-soft/40 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">E-Signature Studio</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">Draw, Type & Upload with auto-transparency</td>
              <td class="py-4 px-6 text-body">Basic signature</td>
              <td class="py-4 px-6 text-body">Basic signature</td>
            </tr>
            <tr class="hover:bg-hairline-soft/40 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Document Redaction</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">Permanent vector/raster blackout</td>
              <td class="py-4 px-6 text-rose-600 dark:text-rose-400">Pro subscription only</td>
              <td class="py-4 px-6 text-amber-600 dark:text-amber-400">Separate paid tool</td>
            </tr>
            <tr class="hover:bg-hairline-soft/40 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Account / Registration</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan-500/5 border-x border-cyan-500/10">Not required (Zero friction)</td>
              <td class="py-4 px-6 text-body">Forces signup popups</td>
              <td class="py-4 px-6 text-body">Forces email prompt</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Feature Suite (Modern Bento Grid Layout) -->
  <section class="py-20 sm:py-28 bg-canvas border-b border-hairline">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-link shadow-whisper">
          Complete Studio Suite
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-heading-lg text-ink sm:text-4xl">
          Everything you need to work with PDFs.
        </h2>
        <p class="mt-3 text-[15px] text-body">
          Engineered for speed, privacy, and precision with client-side WebAssembly.
        </p>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1: Text & Whiteout (Spans 2 columns) -->
        <div class="md:col-span-2 glass-card rounded-2xl p-7 flex flex-col justify-between relative overflow-hidden group">
          <div class="space-y-3 relative z-10">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-mono font-bold shadow-sm">
              T
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink">Text Editing & Smart Whiteout</h3>
            <p class="text-[14px] leading-relaxed text-body max-w-xl">
              Add new text anywhere with customized typography, fonts, colors, and font sizes. Seamlessly cover and overwrite existing document text using the whiteout background feature.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-[12px] font-mono text-cyan-600 dark:text-cyan-400 font-medium">
            <span>Inline Typography Control</span>
            <span>➔</span>
          </div>
        </div>

        <!-- Card 2: E-Signature Studio -->
        <div class="glass-card rounded-2xl p-7 flex flex-col justify-between relative overflow-hidden group">
          <div class="space-y-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink">E-Signature & Initials</h3>
            <p class="text-[14px] leading-relaxed text-body">
              Draw smooth signatures, type calligraphy scripts, or upload your signature image with automatic white-background transparency removal.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-[12px] font-mono text-cyan-600 dark:text-cyan-400 font-medium">
            <span>Draw • Type • Upload</span>
            <span>➔</span>
          </div>
        </div>

        <!-- Card 3: Permanent Redaction -->
        <div class="glass-card rounded-2xl p-7 flex flex-col justify-between relative overflow-hidden group">
          <div class="space-y-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-500/15 text-rose-500 border border-rose-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
              </svg>
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink">Permanent Redaction</h3>
            <p class="text-[14px] leading-relaxed text-body">
              Blackout sensitive social security numbers, medical records, or confidential pricing. Permanently erases data before exporting.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-[12px] font-mono text-rose-600 dark:text-rose-400 font-medium">
            <span>Irreversible Blackout</span>
            <span>➔</span>
          </div>
        </div>

        <!-- Card 4: Page Organizer (Spans 2 columns) -->
        <div class="md:col-span-2 glass-card rounded-2xl p-7 flex flex-col justify-between relative overflow-hidden group">
          <div class="space-y-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-600 text-white shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
              </svg>
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink">Page Organizer & Thumbnail Studio</h3>
            <p class="text-[14px] leading-relaxed text-body max-w-xl">
              Rotate individual or batch pages 90°, delete unwanted pages, duplicate important sheets, and insert blank pages on the fly with live visual preview cards.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-[12px] font-mono text-emerald-600 dark:text-emerald-400 font-medium">
            <span>Reorder • Rotate • Duplicate</span>
            <span>➔</span>
          </div>
        </div>

        <!-- Card 5: Freehand & Highlighting -->
        <div class="glass-card rounded-2xl p-7 flex flex-col justify-between relative overflow-hidden group">
          <div class="space-y-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500/15 text-amber-500 border border-amber-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink">Draw & Highlight</h3>
            <p class="text-[14px] leading-relaxed text-body">
              Smooth freehand pen for marking documents, along with semi-transparent highlighters with customizable stroke thickness.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-[12px] font-mono text-amber-600 dark:text-amber-400 font-medium">
            <span>Vector Drawing Canvas</span>
            <span>➔</span>
          </div>
        </div>

        <!-- Card 6: Watermark & Numbering (Spans 2 columns) -->
        <div class="md:col-span-2 glass-card rounded-2xl p-7 flex flex-col justify-between relative overflow-hidden group">
          <div class="space-y-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-600 text-white shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
              </svg>
            </div>
            <h3 class="text-xl font-bold tracking-tight text-ink">Watermark & Dynamic Page Numbers</h3>
            <p class="text-[14px] leading-relaxed text-body max-w-xl">
              Stamp diagonal or horizontal security watermarks across your whole document, and automatically calculate and render header or footer page numbers with total page counts.
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-[12px] font-mono text-purple-600 dark:text-purple-400 font-medium">
            <span>Automated Document Numbering</span>
            <span>➔</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modern CTA Section -->
  <section class="py-20 sm:py-28 bg-canvas text-center relative overflow-hidden">
    <div class="hero-mesh-blob top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-80 w-80 rounded-full bg-blue-600/10"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-link shadow-whisper">
        Ready to Edit?
      </span>
      <h2 class="text-4xl font-extrabold tracking-display text-ink sm:text-5xl">
        Experience truly private, limitless PDF editing.
      </h2>
      <p class="text-body max-w-xl mx-auto text-[15px] sm:text-[16px]">
        No credit card, no account, and no upload queues. Start editing immediately in your browser.
      </p>
      <div class="pt-2">
        <a
          href="#editor-anchor"
          class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 px-8 text-sm font-semibold text-white shadow-floating hover:shadow-glow-primary transition-all duration-200 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span>Open PDF Editor Now</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
