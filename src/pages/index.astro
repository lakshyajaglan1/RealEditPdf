---
import Layout from '../layouts/Layout.astro';
import PdfEditor from '../components/editor/PdfEditor.astro';
---

<Layout
  title="RealPdfEdit — 100% Free & Unlimited Client-Side PDF Editor"
  description="Edit PDF text, draw annotations, sign documents, redact confidential data, reorder pages, and merge PDFs directly in your browser. 100% private with zero cloud uploads."
  activeTool="editor"
>
  <!-- Hero Section with Vercel Mesh Gradient (Streamlined Above the Fold) -->
  <section class="relative overflow-hidden pt-4 pb-12 md:pt-6 md:pb-16 hero-mesh-gradient border-b border-hairline">
    <!-- Atmospheric Blur Circles -->
    <div class="hero-mesh-blob -top-24 left-1/4 h-80 w-80 rounded-full bg-cyan/15"></div>
    <div class="hero-mesh-blob -top-12 right-1/4 h-80 w-80 rounded-full bg-violet/15"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Compact Top Brand Bar / Headline -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-4 text-center sm:text-left">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-2.5 py-0.5 text-[11px] font-mono text-ink shadow-whisper mb-1.5">
            <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
            <span class="uppercase tracking-wider font-semibold">100% Client-Side • Free Forever • No Limits</span>
          </div>
          <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl lg:text-4xl">
            Edit & Sign PDF Documents Instantly
          </h1>
        </div>
        <p class="text-[13px] text-body max-w-md hidden md:block text-right">
          Zero cloud uploads. Edit text, sign agreements, draw annotations, redact data, and organize pages privately in your browser.
        </p>
      </div>

      <!-- Interactive PDF Editor Studio Mount (Immediately Visible & Usable Above The Fold) -->
      <div class="w-full text-left">
        <PdfEditor />
      </div>
    </div>
  </section>

  <!-- Competitor Comparison Section (Why We Beat Smallpdf) -->
  <section id="comparison" class="py-20 bg-canvas border-b border-hairline">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="font-mono text-[12px] font-semibold uppercase tracking-wider text-link">Honest Comparison</span>
        <h2 class="mt-2 text-3xl font-bold tracking-heading-lg text-ink sm:text-4xl">
          Why RealPdfEdit leaves competitors behind.
        </h2>
        <p class="mt-3 text-[15px] text-body">
          Most online PDF editors lure you in and then hit you with daily task limits, paywalls, or store your private files on remote cloud servers.
        </p>
      </div>

      <!-- Comparison Table Card -->
      <div class="overflow-x-auto rounded-lg border border-hairline bg-canvas-elevated shadow-whisper">
        <table class="w-full text-left text-[14px] border-collapse">
          <thead>
            <tr class="border-b border-hairline bg-canvas font-mono text-[12px] uppercase tracking-wider text-mute">
              <th class="py-4 px-6 font-semibold">Feature / Capability</th>
              <th class="py-4 px-6 font-semibold text-ink bg-cyan/10">RealPdfEdit (Free)</th>
              <th class="py-4 px-6 font-semibold text-body">Smallpdf</th>
              <th class="py-4 px-6 font-semibold text-body">ILovePDF / Sejda</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            <tr class="hover:bg-hairline-soft/30 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Daily Usage Limits</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan/5">Unlimited (0 limits)</td>
              <td class="py-4 px-6 text-rose-600 dark:text-rose-400">1-2 tasks per day</td>
              <td class="py-4 px-6 text-rose-600 dark:text-rose-400">3 tasks per hour</td>
            </tr>
            <tr class="hover:bg-hairline-soft/30 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Privacy & Security</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan/5">100% Client-Side (0 Server Uploads)</td>
              <td class="py-4 px-6 text-body">Cloud server upload</td>
              <td class="py-4 px-6 text-body">Cloud server upload</td>
            </tr>
            <tr class="hover:bg-hairline-soft/30 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Edit Existing Text</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan/5">100% Free & Unlimited</td>
              <td class="py-4 px-6 text-rose-600 dark:text-rose-400">Locked behind $12/mo Pro</td>
              <td class="py-4 px-6 text-amber-600 dark:text-amber-400">Limited / Paywalled</td>
            </tr>
            <tr class="hover:bg-hairline-soft/30 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">File Size Limit</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan/5">No Limit (Your RAM is the limit)</td>
              <td class="py-4 px-6 text-body">15 MB max for free tier</td>
              <td class="py-4 px-6 text-body">50 MB max</td>
            </tr>
            <tr class="hover:bg-hairline-soft/30 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">E-Signature Studio</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan/5">Draw, Type & Upload with auto-transparency</td>
              <td class="py-4 px-6 text-body">Basic signature</td>
              <td class="py-4 px-6 text-body">Basic signature</td>
            </tr>
            <tr class="hover:bg-hairline-soft/30 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Document Redaction</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan/5">Permanent vector/raster blackout</td>
              <td class="py-4 px-6 text-rose-600 dark:text-rose-400">Pro subscription only</td>
              <td class="py-4 px-6 text-amber-600 dark:text-amber-400">Separate paid tool</td>
            </tr>
            <tr class="hover:bg-hairline-soft/30 transition-colors">
              <td class="py-4 px-6 font-medium text-ink">Account / Registration</td>
              <td class="py-4 px-6 font-semibold text-emerald-600 dark:text-emerald-400 bg-cyan/5">Not required (Zero friction)</td>
              <td class="py-4 px-6 text-body">Forces signup popups</td>
              <td class="py-4 px-6 text-body">Forces email prompt</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Feature Grid (Hairline Cards with Geist Aesthetic) -->
  <section class="py-20 bg-canvas border-b border-hairline">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="font-mono text-[12px] font-semibold uppercase tracking-wider text-link">Complete Feature Suite</span>
        <h2 class="mt-2 text-3xl font-bold tracking-heading-lg text-ink sm:text-4xl">
          Everything you need to work with PDFs.
        </h2>
        <p class="mt-3 text-[15px] text-body">
          Engineered for speed, privacy, and precision with standard-compliant WebAssembly.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1: Text & Whiteout -->
        <div class="rounded-md border border-hairline bg-canvas-elevated p-6 shadow-whisper space-y-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-ink text-on-primary font-mono font-bold">
            T
          </div>
          <h3 class="text-lg font-semibold tracking-tight text-ink">Text Editing & Whiteout</h3>
          <p class="text-[13px] leading-relaxed text-body">
            Add custom text anywhere with custom fonts, colors, and font sizes. Use the whiteout background feature to seamlessly overwrite and replace existing document text.
          </p>
        </div>

        <!-- Card 2: E-Signatures -->
        <div class="rounded-md border border-hairline bg-canvas-elevated p-6 shadow-whisper space-y-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-cyan/15 text-cyan border border-cyan-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold tracking-tight text-ink">E-Signature & Initials</h3>
          <p class="text-[13px] leading-relaxed text-body">
            Draw smooth signatures, type calligraphy scripts, or upload your signature image with automatic white-background transparency removal.
          </p>
        </div>

        <!-- Card 3: Permanent Redaction -->
        <div class="rounded-md border border-hairline bg-canvas-elevated p-6 shadow-whisper space-y-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-rose-500/15 text-rose-500 border border-rose-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold tracking-tight text-ink">Permanent Redaction</h3>
          <p class="text-[13px] leading-relaxed text-body">
            Blackout sensitive social security numbers, medical records, or confidential pricing. Permanently erases data before exporting.
          </p>
        </div>

        <!-- Card 4: Page Thumbnail Studio -->
        <div class="rounded-md border border-hairline bg-canvas-elevated p-6 shadow-whisper space-y-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-ink text-on-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold tracking-tight text-ink">Page Organizer</h3>
          <p class="text-[13px] leading-relaxed text-body">
            Rotate individual or batch pages 90°, delete unwanted pages, duplicate important sheets, and insert blank pages on the fly.
          </p>
        </div>

        <!-- Card 5: Freehand & Highlighting -->
        <div class="rounded-md border border-hairline bg-canvas-elevated p-6 shadow-whisper space-y-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-amber-500/15 text-amber-500 border border-amber-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold tracking-tight text-ink">Draw & Highlight</h3>
          <p class="text-[13px] leading-relaxed text-body">
            Freehand pen for marking documents, along with semi-transparent highlighters in multiple colors with customizable stroke widths.
          </p>
        </div>

        <!-- Card 6: Watermark & Numbering -->
        <div class="rounded-md border border-hairline bg-canvas-elevated p-6 shadow-whisper space-y-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-link/15 text-link border border-link/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold tracking-tight text-ink">Watermark & Page Numbers</h3>
          <p class="text-[13px] leading-relaxed text-body">
            Stamp diagonal or horizontal watermarks across your whole document, and automatically calculate and render header or footer page numbers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner Band -->
  <section class="py-20 bg-canvas text-center">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-6">
      <span class="font-mono text-[12px] font-semibold uppercase tracking-wider text-link">Ready to Edit?</span>
      <h2 class="text-4xl font-bold tracking-display text-ink sm:text-5xl">
        Experience truly private, limitless PDF editing.
      </h2>
      <p class="text-body max-w-xl mx-auto text-[15px]">
        No credit card, no account, and no upload queues. Start editing immediately.
      </p>
      <div>
        <a
          href="#editor-anchor"
          class="inline-flex h-12 items-center justify-center rounded-full bg-ink px-8 text-sm font-medium text-on-primary shadow-whisper hover:opacity-90 transition-all active:scale-95"
        >
          Open PDF Editor Now
        </a>
      </div>
    </div>
  </section>
</Layout>
