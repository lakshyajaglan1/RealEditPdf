---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Merge PDF Files Online Free — RealPdfEdit"
  description="Combine multiple PDF files into a single document directly in your browser. 100% free, unlimited, and private client-side merging."
  activeTool="merge"
>
  <div class="py-14 md:py-24 hero-mesh-gradient border-b border-hairline relative overflow-hidden">
    <div class="hero-mesh-blob -top-24 left-1/4 h-80 w-80 rounded-full bg-cyan-500/15 animate-pulse-glow"></div>
    <div class="hero-mesh-blob -top-12 right-1/4 h-80 w-80 rounded-full bg-indigo-500/15"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated/90 px-3.5 py-1 text-[11px] font-mono text-ink shadow-whisper mb-4">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-500"></span>
        </span>
        <span class="uppercase tracking-wider font-semibold text-blue-600 dark:text-cyan-400">Client-Side Fast Merger</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-display text-ink sm:text-5xl">
        Merge PDF Files
      </h1>
      <p class="mt-4 text-[16px] text-body max-w-xl mx-auto leading-relaxed">
        Combine multiple PDF documents into one continuous PDF in seconds. Reorder files via drag and drop. 100% private, files never leave your device.
      </p>

      <!-- Merge Studio Container -->
      <div class="mt-10 rounded-3xl border border-hairline bg-canvas-elevated/90 backdrop-blur-xl p-6 sm:p-10 shadow-floating text-left">
        <!-- Dropzone -->
        <div id="merge-dropzone" class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-hairline bg-canvas/80 p-12 text-center hover:border-cyan-500/50 hover:shadow-glow-cyan transition-all duration-300 cursor-pointer group">
          <div class="h-16 w-16 rounded-2xl bg-canvas-elevated border border-hairline flex items-center justify-center mb-4 shadow-whisper group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600 dark:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-ink">Choose PDF files or drag them here</h3>
          <p class="text-[13px] text-mute mt-1.5">Select multiple documents at once (no size limit)</p>
          <input type="file" id="merge-file-input" accept="application/pdf" multiple class="hidden" />
        </div>

        <!-- File List (Reorderable) -->
        <div id="merge-files-container" class="mt-8 space-y-3 hidden">
          <div class="flex items-center justify-between pb-2.5 border-b border-hairline text-[12px] font-mono text-mute font-semibold">
            <span>QUEUED DOCUMENTS (<span id="merge-count" class="text-blue-600 dark:text-cyan-400">0</span>)</span>
            <button id="btn-clear-merge" class="text-rose-600 dark:text-rose-400 hover:underline cursor-pointer">Clear All</button>
          </div>
          <div id="merge-list" class="space-y-2.5 max-h-80 overflow-y-auto pr-1"></div>
        </div>

        <!-- Merge Actions -->
        <div id="merge-actions" class="mt-8 flex items-center justify-between border-t border-hairline/80 pt-5 hidden">
          <button id="btn-add-more-merge" class="rounded-xl border border-hairline bg-canvas-elevated px-4 py-2 text-[13px] font-medium text-body hover:bg-hairline-soft hover:text-ink shadow-whisper transition-all cursor-pointer">
            + Add More PDFs
          </button>
          <button id="btn-execute-merge" class="rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 px-6 py-2.5 text-[13px] font-semibold text-white shadow-sm hover:shadow-glow-cyan active:scale-95 transition-all cursor-pointer">
            Merge & Download PDF
          </button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let files = [];
      const dropzone = document.getElementById('merge-dropzone');
      const fileInput = document.getElementById('merge-file-input');
      const container = document.getElementById('merge-files-container');
      const list = document.getElementById('merge-list');
      const countSpan = document.getElementById('merge-count');
      const actions = document.getElementById('merge-actions');
      const executeBtn = document.getElementById('btn-execute-merge');
      const addMoreBtn = document.getElementById('btn-add-more-merge');
      const clearBtn = document.getElementById('btn-clear-merge');

      dropzone.addEventListener('click', () => fileInput.click());
      addMoreBtn.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', (e) => {
        const newFiles = Array.from(e.target.files).filter(f => f.type === 'application/pdf');
        files = [...files, ...newFiles];
        renderFileList();
      });

      clearBtn.addEventListener('click', () => {
        files = [];
        renderFileList();
      });

      function renderFileList() {
        if (files.length === 0) {
          container.classList.add('hidden');
          actions.classList.add('hidden');
          dropzone.classList.remove('hidden');
          return;
        }

        container.classList.remove('hidden');
        actions.classList.remove('hidden');
        countSpan.textContent = files.length;
        list.innerHTML = '';

        files.forEach((f, idx) => {
          const item = document.createElement('div');
          item.className = 'flex items-center justify-between p-3 rounded-md border border-hairline bg-canvas shadow-whisper text-[13px]';
          item.innerHTML = `
            <div class="flex items-center gap-3 truncate">
              <span class="font-mono text-mute text-xs">#${idx + 1}</span>
              <span class="font-medium text-ink truncate">${f.name}</span>
              <span class="font-mono text-[11px] text-mute">(${(f.size / (1024*1024)).toFixed(2)} MB)</span>
            </div>
            <div class="flex items-center gap-1">
              ${idx > 0 ? `<button class="move-up-btn p-1 text-mute hover:text-ink" data-idx="${idx}" title="Move Up">↑</button>` : ''}
              ${idx < files.length - 1 ? `<button class="move-down-btn p-1 text-mute hover:text-ink" data-idx="${idx}" title="Move Down">↓</button>` : ''}
              <button class="remove-btn p-1 text-mute hover:text-rose-600 dark:hover:text-rose-400" data-idx="${idx}" title="Remove">✕</button>
            </div>
          `;

          item.querySelector('.remove-btn')?.addEventListener('click', () => {
            files.splice(idx, 1);
            renderFileList();
          });

          item.querySelector('.move-up-btn')?.addEventListener('click', () => {
            const temp = files[idx];
            files[idx] = files[idx - 1];
            files[idx - 1] = temp;
            renderFileList();
          });

          item.querySelector('.move-down-btn')?.addEventListener('click', () => {
            const temp = files[idx];
            files[idx] = files[idx + 1];
            files[idx + 1] = temp;
            renderFileList();
          });

          list.appendChild(item);
        });
      }

      executeBtn.addEventListener('click', async () => {
        if (files.length < 2) {
          alert('Please select at least 2 PDF files to merge.');
          return;
        }

        executeBtn.disabled = true;
        executeBtn.textContent = 'Merging in Browser...';

        try {
          const { PDFDocument } = window.PDFLib;
          const mergedDoc = await PDFDocument.create();

          for (const file of files) {
            const bytes = await file.arrayBuffer();
            const doc = await PDFDocument.load(bytes);
            const copiedPages = await mergedDoc.copyPages(doc, doc.getPageIndices());
            copiedPages.forEach((page) => mergedDoc.addPage(page));
          }

          const mergedBytes = await mergedDoc.save();
          const blob = new Blob([mergedBytes], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);

          const a = document.createElement('a');
          a.href = url;
          a.download = 'Merged-Document.pdf';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);

          if (window.confetti) {
            window.confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
          }
        } catch (err) {
          alert('Error merging files: ' + err.message);
        } finally {
          executeBtn.disabled = false;
          executeBtn.textContent = 'Merge & Download PDF';
        }
      });
    });
  </script>
</Layout>
