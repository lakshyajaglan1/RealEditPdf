---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="About RealEditPDF — Client-Side PDF Studio"
  description="Learn about RealEditPDF, our mission to provide 100% private PDF tools, and the team behind the platform."
  activeTool="editor"
>
  <div class="py-12 md:py-20 hero-mesh-gradient border-b border-hairline">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-display text-ink break-words">
        About RealEditPDF
      </h1>
      <p class="mt-3 sm:mt-4 text-[14px] sm:text-[16px] text-body max-w-2xl mx-auto">
        RealEditPDF was built with privacy as the core principle. Unlike traditional online PDF editors that require uploading your documents to remote cloud servers, we run the entire PDF processing engine locally in your browser using WebAssembly.
      </p>
    </div>
  </div>

  <section class="py-12 sm:py-16 bg-canvas">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
      <!-- Mission -->
      <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
        <h2 class="text-lg sm:text-xl font-bold text-ink">Our Mission</h2>
        <p class="text-[13px] sm:text-[14px] leading-relaxed text-body">
          To provide a PDF studio that empowers individuals and organizations to work with documents securely. We believe your files should never leave your device, and no third party should have access to your sensitive information.
        </p>
      </div>

      <!-- How It Works -->
      <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
        <h2 class="text-lg sm:text-xl font-bold text-ink">How It Works</h2>
        <ol class="list-decimal list-inside text-[13px] sm:text-[14px] leading-relaxed text-body">
          <li>Upload your PDF directly in your browser</li>
          <li>Processing happens entirely on your device using WebAssembly</li>
          <li>Results are generated locally and you download them</li>
          <li>No files are ever transmitted to or stored on our servers</li>
        </ol>
      </div>

      <!-- Privacy Promise -->
      <div class="rounded-2xl border border-hairline bg-canvas-elevated p-5 sm:p-8 shadow-whisper space-y-4">
        <h2 class="text-lg sm:text-xl font-bold text-ink">Privacy Promise</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-[12px] sm:text-[13px]">
          <li class="flex items-start gap-2 p-3 rounded-xl bg-canvas border border-hairline">
            <span class="text-emerald-600 font-bold">✓</span>
            <div><strong>Zero Cloud Uploads:</strong> Your files stay on your device.</div>
          </li>
          <li class="flex items-start gap-2 p-3 rounded-xl bg-canvas border border-hairline">
            <span class="text-emerald-600 font-bold">✓</span>
            <div><strong>No Account Required:</strong> Complete anonymity.</div>
          </li>
          <li class="flex items-start gap-2 p-3 rounded-xl bg-canvas border border-hairline">
            <span class="text-emerald-600 font-bold">✓</span>
            <div><strong>GDPR Compliant:</strong> No personal data collection.</div>
          </li>
          <li class="flex items-start gap-2 p-3 rounded-xl bg-canvas border border-hairline">
            <span class="text-emerald-600 font-bold">✓</span>
            <div><strong>Offline capable:</strong> Works without internet connection.</div>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>