---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — 404 | RealEditPDF"
  description="The page you are looking for does not exist. Head back to RealEditPDF and continue editing your PDFs with our free, private, client-side tools."
  noindex={true}
  activeTool="editor"
>
  <div class="relative py-16 md:py-24 hero-mesh-gradient border-b border-hairline overflow-hidden">
    <!-- Ambient blobs -->
    <div class="hero-mesh-blob bg-cyan-400/30 dark:bg-cyan-500/20 w-[420px] h-[420px] -top-20 -left-24 rounded-full"></div>
    <div class="hero-mesh-blob bg-violet-400/25 dark:bg-violet-500/15 w-[380px] h-[380px] top-10 right-[-80px] rounded-full"></div>

    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated/70 px-3 py-1 text-[11px] font-mono uppercase tracking-wider text-mute backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-cyan animate-pulse-glow"></span>
        Error 404
      </div>

      <h1 class="mt-6 text-6xl sm:text-7xl md:text-8xl font-bold tracking-display text-ink leading-none">
        4<span class="bg-gradient-to-br from-cyan-500 via-blue-600 to-violet-600 bg-clip-text text-transparent">0</span>4
      </h1>

      <h2 class="mt-4 text-2xl sm:text-3xl font-bold tracking-heading-lg text-ink">
        Page not found
      </h2>

      <p class="mt-3 text-[14px] sm:text-[16px] text-body max-w-xl mx-auto leading-relaxed">
        The page you are looking for has been moved, deleted, or never existed. Don't worry — your files are still safe and you can keep editing in seconds.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 px-6 py-3 text-sm font-semibold text-white shadow-floating hover:shadow-glow-primary transition-all duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Editor
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-6 py-3 text-sm font-semibold text-ink hover:border-cyan/40 hover:shadow-whisper transition-all duration-200"
        >
          Report a broken link
        </a>
      </div>
    </div>
  </div>

  <section class="py-12 sm:py-16 bg-canvas">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <p class="font-mono text-[11px] uppercase tracking-wider text-mute">Popular Tools</p>
        <h3 class="mt-2 text-lg sm:text-xl font-bold tracking-heading-md text-ink">
          Or jump straight into one of these
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/" class="glass-card rounded-2xl p-5 group block">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-[14px] font-semibold text-ink group-hover:text-blue-600 transition-colors">Full PDF Editor</h4>
              <p class="mt-1 text-[12px] text-body leading-relaxed">Edit text, draw, sign, redact & annotate in your browser.</p>
            </div>
          </div>
        </a>

        <a href="/merge-pdf/" class="glass-card rounded-2xl p-5 group block">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-500/10 text-violet-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7v10a2 2 0 002 2h4M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-[14px] font-semibold text-ink group-hover:text-violet-600 transition-colors">Merge PDFs</h4>
              <p class="mt-1 text-[12px] text-body leading-relaxed">Combine multiple PDFs into a single file. No upload, no limits.</p>
            </div>
          </div>
        </a>

        <a href="/split-pdf/" class="glass-card rounded-2xl p-5 group block">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-cyan-500/10 text-cyan-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 15.536c-1.171 1.952-3.07 1.952-4.242 0-1.172-1.953-1.172-5.119 0-7.072 1.171-1.952 3.07-1.952 4.242 0M8 10.5h4m-4 3h4m9-1.5a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-[14px] font-semibold text-ink group-hover:text-cyan-600 transition-colors">Split PDF</h4>
              <p class="mt-1 text-[12px] text-body leading-relaxed">Extract or split pages from any PDF, instantly and privately.</p>
            </div>
          </div>
        </a>

        <a href="/compress-pdf/" class="glass-card rounded-2xl p-5 group block">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-[14px] font-semibold text-ink group-hover:text-emerald-600 transition-colors">Compress PDF</h4>
              <p class="mt-1 text-[12px] text-body leading-relaxed">Reduce file size while keeping quality — runs entirely on your device.</p>
            </div>
          </div>
        </a>

        <a href="/sign-pdf/" class="glass-card rounded-2xl p-5 group block">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-pink-500/10 text-pink-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-[14px] font-semibold text-ink group-hover:text-pink-600 transition-colors">E-Sign PDF</h4>
              <p class="mt-1 text-[12px] text-body leading-relaxed">Draw, type, or upload a signature. Sign PDFs without printing.</p>
            </div>
          </div>
        </a>

        <a href="/pdf-to-images/" class="glass-card rounded-2xl p-5 group block">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-[14px] font-semibold text-ink group-hover:text-amber-600 transition-colors">PDF to Images</h4>
              <p class="mt-1 text-[12px] text-body leading-relaxed">Convert every page to PNG or JPG, all client-side.</p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
