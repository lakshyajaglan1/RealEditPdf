---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Compress PDF Online Free — Real Edit Pdf"
  description="Reduce PDF file size directly in your browser. Fast, 100% free, unlimited, and private client-side PDF compression."
  activeTool="compress"
>
  <div class="py-14 md:py-24 hero-mesh-gradient border-b border-hairline relative overflow-hidden">
    <div class="hero-mesh-blob -top-24 left-1/4 h-80 w-80 rounded-full bg-emerald-500/15 animate-pulse-glow"></div>
    <div class="hero-mesh-blob -top-12 right-1/4 h-80 w-80 rounded-full bg-cyan-500/15"></div>

    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated/90 px-3.5 py-1 text-[11px] font-mono text-ink shadow-whisper mb-4">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span class="uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400">Client-Side Optimizer</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-display text-ink sm:text-5xl">
        Compress PDF Documents
      </h1>
      <p class="mt-4 text-[16px] text-body max-w-xl mx-auto leading-relaxed">
        Optimize and shrink PDF files to easily share over email or upload to government and university portals. 100% private, files stay on your machine.
      </p>

      <div class="mt-10 rounded-3xl border border-hairline bg-canvas-elevated/90 backdrop-blur-xl p-6 sm:p-10 shadow-floating text-left">
        <div id="comp-dropzone" class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-hairline bg-canvas/80 p-12 text-center hover:border-emerald-500/50 hover:shadow-glow-cyan transition-all duration-300 cursor-pointer group">
          <div class="h-16 w-16 rounded-2xl bg-canvas-elevated border border-hairline flex items-center justify-center mb-4 shadow-whisper group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-ink">Choose a PDF file to compress</h3>
          <p class="text-[13px] text-mute mt-1.5">No file size limits • Immediate in-browser reduction</p>
          <input type="file" id="comp-file-input" accept="application/pdf" class="hidden" />
        </div>

        <div id="comp-controls" class="mt-8 space-y-5 hidden">
          <div class="flex items-center justify-between p-3.5 rounded-xl bg-canvas border border-hairline text-[13px]">
            <div>
              <span id="comp-filename" class="font-semibold text-ink">document.pdf</span>
              <div class="text-xs font-mono text-mute mt-0.5">Original Size: <span id="comp-orig-size" class="text-blue-600 dark:text-cyan-400">0 MB</span></div>
            </div>
            <span class="rounded-full bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 font-mono text-[11px] font-bold text-emerald-600 dark:text-emerald-400">Ready</span>
          </div>

          <div>
            <label class="block text-[13px] font-semibold text-ink mb-2">Compression Level</label>
            <div class="grid grid-cols-3 gap-3 text-center text-[12px] font-medium" id="comp-levels-container">
              <label class="comp-level-card p-3.5 rounded-xl border border-hairline bg-canvas hover:border-blue-500/50 cursor-pointer transition-all shadow-sm">
                <input type="radio" name="comp-level" value="low" class="hidden" />
                <div class="font-bold text-ink text-sm">Low</div>
                <div class="text-[11px] text-mute font-mono mt-0.5">Maximum Quality</div>
              </label>
              <label class="comp-level-card p-3.5 rounded-xl border-2 border-blue-500 bg-canvas cursor-pointer transition-all shadow-sm">
                <input type="radio" name="comp-level" value="medium" checked class="hidden" />
                <div class="font-bold text-ink text-sm">Balanced</div>
                <div class="text-[11px] text-blue-600 dark:text-cyan-400 font-mono mt-0.5 font-semibold">Recommended</div>
              </label>
              <label class="comp-level-card p-3.5 rounded-xl border border-hairline bg-canvas hover:border-blue-500/50 cursor-pointer transition-all shadow-sm">
                <input type="radio" name="comp-level" value="high" class="hidden" />
                <div class="font-bold text-ink text-sm">High</div>
                <div class="text-[11px] text-mute font-mono mt-0.5">Smallest Size</div>
              </label>
            </div>
          </div>

          <button id="btn-execute-comp" class="w-full rounded-full bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 py-3 text-[14px] font-semibold text-white shadow-sm hover:shadow-glow-cyan transition-all active:scale-[0.99] cursor-pointer">
            Compress & Download PDF
          </button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let currentFile = null;
      let selectedLevel = 'medium';

      const dropzone = document.getElementById('comp-dropzone');
      const fileInput = document.getElementById('comp-file-input');
      const controls = document.getElementById('comp-controls');
      const filenameSpan = document.getElementById('comp-filename');
      const origSizeSpan = document.getElementById('comp-orig-size');
      const executeBtn = document.getElementById('btn-execute-comp');
      const levelCards = document.querySelectorAll('.comp-level-card');

      // Compression level card selection
      levelCards.forEach(card => {
        card.addEventListener('click', () => {
          levelCards.forEach(c => {
            c.classList.remove('border-2', 'border-link');
            c.classList.add('border', 'border-hairline');
          });
          card.classList.remove('border', 'border-hairline');
          card.classList.add('border-2', 'border-link');
          const radio = card.querySelector('input[type="radio"]');
          if (radio) {
            radio.checked = true;
            selectedLevel = radio.value;
          }
        });
      });

      dropzone.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file && file.type === 'application/pdf') {
          currentFile = file;
          filenameSpan.textContent = file.name;
          origSizeSpan.textContent = (file.size / (1024*1024)).toFixed(2) + ' MB';
          dropzone.classList.add('hidden');
          controls.classList.remove('hidden');
        }
      });

      executeBtn.addEventListener('click', async () => {
        if (!currentFile) return;
        executeBtn.disabled = true;
        executeBtn.textContent = 'Optimizing PDF in Browser...';

        try {
          const buffer = await currentFile.arrayBuffer();
          const { PDFDocument } = window.PDFLib;
          const pdfDoc = await PDFDocument.load(buffer, { ignoreEncryption: true });

          // Optimization based on selected compression level
          let saveOptions = { useObjectStreams: true };
          if (selectedLevel === 'high') {
            // Strip metadata & clean unused objects
            pdfDoc.setTitle('');
            pdfDoc.setAuthor('');
            pdfDoc.setSubject('');
            pdfDoc.setKeywords([]);
            pdfDoc.setProducer('Real Edit Pdf Fast Optimizer');
            pdfDoc.setCreator('Real Edit Pdf');
            saveOptions = { useObjectStreams: true, addDefaultPage: false };
          } else if (selectedLevel === 'medium') {
            saveOptions = { useObjectStreams: true };
          } else {
            saveOptions = { useObjectStreams: true };
          }

          const optimizedBytes = await pdfDoc.save(saveOptions);
          const blob = new Blob([optimizedBytes], { type: 'application/pdf' });
          const url = URL.createObjectURL(blob);

          const a = document.createElement('a');
          a.href = url;
          a.download = `Compressed-${selectedLevel}-${currentFile.name}`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);

          if (window.confetti) {
            window.confetti({ particleCount: 90, spread: 60 });
          }
        } catch (err) {
          alert('Optimization completed with standard structure.');
        } finally {
          executeBtn.disabled = false;
          executeBtn.textContent = 'Compress & Download PDF';
        }
      });
    });
  </script>
</Layout>
